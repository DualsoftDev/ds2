<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ds2.Tutorial</AssemblyName>
    <!-- 하위 독립 프로젝트와 잔여 bin/obj를 부모 프로젝트의 기본 항목에서 제외 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);OpcUaExternalClient\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 1: Core (Store 모듈 포함) -->
    <ProjectReference Include="..\..\Solutions\Core\Ds2.Core\Ds2.Core.fsproj" />
    <!-- Phase 3a: AASX -->
    <ProjectReference Include="..\..\Solutions\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <!-- Phase 3b: Runtime.Sim -->
    <ProjectReference Include="..\..\Solutions\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
    <!-- Phase 4: Runtime.Sim.Report -->
    <ProjectReference Include="..\..\Solutions\Runtime\Ds2.Runtime.Report\Ds2.Runtime.Report.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="9.0.100" />
    <PackageReference Include="log4net" Version="3.3.0" />
  </ItemGroup>

</Project>
