@* Flow 카드 레이아웃
   - `--fc-accent` : 활동량 기반 (MT≥WT → primary / WT>MT → secondary). 카드 테두리/제목/도넛/Progress.
   - `--fc-state`  : Flow 상태 기반 (Ready/Going/Finish/Error → 도면 범례와 동일 팔레트). 상태 텍스트+아이콘.
   - 데이터 없음 → 회색 (.fc-cq-empty)
   - 부모 컨테이너 가용 영역이 세로로 더 길고 캔버스가 가로로 더 넓으면
     Col↔Row 를 자동 전치(transpose)하여 카드를 위/아래 배치로 회전 *@
@inject IJSRuntime JS
@implements IAsyncDisposable
<div @ref="_rootRef"
     style="position:relative; @Style; aspect-ratio:@RenderCanvasW/@RenderCanvasH; overflow:hidden; background:var(--color-background);"
     @onclick="OnBackgroundClicked" @onclick:stopPropagation>

    @* 도면 배경 *@
    @if (!string.IsNullOrEmpty(ImagePath))
    {
        <img src="/@(ImagePath?.TrimStart('/'))?v=@(ImageVersion)"
             class="blueprint-bg-image"
             style="position:absolute; inset:0; width:100%; height:100%; opacity:0.3; pointer-events:none; object-fit:fill;" />
    }

    @* Flow 카드 *@
    @foreach (var b in _blockLayouts)
    {
        var sel = b.FlowName == SelectedFlowName;
        var inv = System.Globalization.CultureInfo.InvariantCulture;

        <div class="fl-card @(sel ? "fl-card-selected" : "")"
             style="left:@(b.LeftPct.ToString("F4", inv))%; top:@(b.TopPct.ToString("F4", inv))%; width:@(b.WidthPct.ToString("F4", inv))%; height:@(b.HeightPct.ToString("F4", inv))%; --fc-accent:@(b.AccentColor); --fc-state:@(b.StateColor);"
             @onclick="() => OnBlockClicked(b.FlowName)" @onclick:stopPropagation>

            <div class="fc-cq @(b.IsEmpty ? "fc-cq-empty" : "")">
                <div class="fc-root">
                    @* ── 헤더: 제목 + 배지 ── *@
                    <div class="fc-header">
                        <div class="fc-title">@b.FlowName</div>
                        @if (b.Badges.Count > 0)
                        {
                            <div class="fc-badges">
                                @foreach (var badge in b.Badges)
                                {
                                    <span class="fc-badge"
                                          style="background:@badge.Color; border-color:@badge.Color; color:#fff;">
                                        @badge.Label
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @* ── 본문: 도넛 + 정보 (배치는 CSS @@container aspect-ratio 로 결정) ── *@
                    <div class="fc-body">
                        <div class="fc-chart">
                            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                                <g transform="rotate(-90 50 50)">
                                    <circle class="fc-donut-bg" cx="50" cy="50" r="40"
                                            fill="none" stroke-width="10" />
                                    @if (b.MtFrac > 0)
                                    {
                                        <circle class="fc-donut-arc" cx="50" cy="50" r="40"
                                                fill="none" stroke-width="10"
                                                stroke-dasharray="@b.SMtDash @b.SCirc"
                                                stroke-linecap="round" />
                                    }
                                </g>
                            </svg>
                            <div class="fc-chart-center">
                                <span class="fc-chart-label">@FormatMs(b.Total)</span>
                                @if (!string.IsNullOrEmpty(b.StateLabel))
                                {
                                    <span class="fc-chart-state">@b.StateLabel</span>
                                }
                            </div>
                        </div>

                        <div class="fc-info">
                            <div class="fc-status">@b.StateLabel</div>
                            <div class="fc-time-row">
                                <span class="fc-time-label">가동</span>
                                <span class="fc-time-value">@FormatMs(b.Mt)</span>
                            </div>
                            <div class="fc-time-row">
                                <span class="fc-time-label">대기</span>
                                <span class="fc-time-value">@FormatMs(b.Wt)</span>
                            </div>
                        </div>
                    </div>

                    @* ── 하단 progress bar (가동율) ── *@
                    <div class="fc-progress">
                        <div class="fc-progress-fill"
                             style="width:@(b.MtPercent.ToString("F1", inv))%"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ── Parameters ──
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public int CanvasWidth { get; set; }
    [Parameter] public int CanvasHeight { get; set; }
    [Parameter] public string? ImagePath { get; set; }
    [Parameter] public long ImageVersion { get; set; }
    [Parameter] public int OffsetX { get; set; }
    [Parameter] public int OffsetY { get; set; }
    [Parameter] public int CellWidth { get; set; }
    [Parameter] public int CellHeight { get; set; }
    [Parameter] public List<FlowPlacement> Placements { get; set; } = [];
    [Parameter] public Func<FlowPlacement, string>? GetColor { get; set; }
    [Parameter] public Func<FlowPlacement, string>? GetStateLabel { get; set; }
    [Parameter] public Func<FlowPlacement, (int Mt, int Wt)?>? GetMtWt { get; set; }
    [Parameter] public Func<FlowPlacement, IEnumerable<(string Label, string Color)>>? GetBadges { get; set; }
    [Parameter] public string? SelectedFlowName { get; set; }
    [Parameter] public EventCallback<string?> OnFlowClicked { get; set; }

    // ── 전치 상태 (자동 회전) ──
    private bool _transposed;
    private ElementReference _rootRef;
    private DotNetObjectReference<FlowLayoutSvg>? _dotNetRef;
    private bool _observerAttached;

    // 렌더에 쓰는 캔버스 크기 (전치 시 스왑)
    private int RenderCanvasW => _transposed ? CanvasHeight : CanvasWidth;
    private int RenderCanvasH => _transposed ? CanvasWidth : CanvasHeight;

    // ── Pre-computed block layouts ──
    private List<FlowBlockLayout> _blockLayouts = [];

    protected override void OnParametersSet()
    {
        RecomputeLayouts();
    }

    private void RecomputeLayouts()
    {
        var pad = 4;
        _blockLayouts = Placements
            .Select(fp => ComputeSingleBlock(fp, pad))
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_observerAttached)
        {
            _observerAttached = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("flowLayoutAutoOrient.observe", _rootRef, _dotNetRef);
            }
            catch { /* 초기 렌더 타이밍 이슈 무시 */ }
        }
    }

    [JSInvokable]
    public async Task OnContainerAspect(double parentW, double parentH)
    {
        if (parentW <= 0 || parentH <= 0 || CanvasWidth <= 0 || CanvasHeight <= 0) return;

        var shouldTranspose = ShouldTranspose(parentW, parentH);
        if (shouldTranspose != _transposed)
        {
            _transposed = shouldTranspose;
            RecomputeLayouts();
            await InvokeAsync(StateHasChanged);
        }
    }

    // 부모 가용 영역에 카드를 그렸을 때 더 큰 면적이 나오는 방향으로 결정.
    // 단순 토글이 빈번하지 않도록 15% 임계치를 둠.
    private bool ShouldTranspose(double parentW, double parentH)
    {
        double canvasAR = (double)CanvasWidth / CanvasHeight;

        // letterbox fit: 두 축 중 작은 값이 SVG width 가 됨
        double fitWidth(double pw, double ph, double ar) => Math.Min(pw, ph * ar);

        var asIsW = fitWidth(parentW, parentH, canvasAR);
        var asIsArea = asIsW * (asIsW / canvasAR);

        var trAR = 1.0 / canvasAR;
        var trW  = fitWidth(parentW, parentH, trAR);
        var trArea = trW * (trW / trAR);

        if (_transposed)
            return trArea * 1.15 > asIsArea;   // 이미 전치 중이면 되돌리기에 더 보수적으로
        return trArea > asIsArea * 1.15;       // 전치 전환은 명확한 이득이 있을 때만
    }

    public async ValueTask DisposeAsync()
    {
        if (_observerAttached)
        {
            try { await JS.InvokeVoidAsync("flowLayoutAutoOrient.unobserve", _rootRef); }
            catch { }
        }
        _dotNetRef?.Dispose();
    }

    private record FlowBlockLayout
    {
        // 데이터
        public required string FlowName { get; init; }
        public required string AccentColor { get; init; }  // --fc-accent (활동량 기반)
        public required string StateColor { get; init; }   // --fc-state  (상태 기반, 범례와 동일)
        public required string StateLabel { get; init; }
        public required bool IsEmpty { get; init; }
        public required int Mt { get; init; }
        public required int Wt { get; init; }
        public required int Total { get; init; }
        public required double MtPercent { get; init; }    // progress bar 너비 (%)
        public required List<(string Label, string Color)> Badges { get; init; }

        // CSS 퍼센트 좌표
        public required double LeftPct { get; init; }
        public required double TopPct { get; init; }
        public required double WidthPct { get; init; }
        public required double HeightPct { get; init; }

        // 도넛 비율 (viewBox 100x100, r=40)
        public required double MtFrac { get; init; }
        public required string SCirc { get; init; }
        public required string SMtDash { get; init; }
    }

    private FlowBlockLayout ComputeSingleBlock(FlowPlacement fp, int pad)
    {
        var stateLabel = GetStateLabel?.Invoke(fp) ?? "";
        var mtWt       = GetMtWt?.Invoke(fp);

        // 전치 시 모든 격자 좌표/스팬/캔버스 치수를 스왑
        var col      = _transposed ? fp.Row     : fp.Col;
        var row      = _transposed ? fp.Col     : fp.Row;
        var colSpan  = _transposed ? fp.RowSpan : fp.ColSpan;
        var rowSpan  = _transposed ? fp.ColSpan : fp.RowSpan;
        var cellW    = _transposed ? CellHeight : CellWidth;
        var cellH    = _transposed ? CellWidth  : CellHeight;
        var offsetX  = _transposed ? OffsetY    : OffsetX;
        var offsetY  = _transposed ? OffsetX    : OffsetY;
        var canvasW  = _transposed ? CanvasHeight : CanvasWidth;
        var canvasH  = _transposed ? CanvasWidth  : CanvasHeight;

        // 블록 지오메트리
        var px     = offsetX + col * cellW;
        var py     = offsetY + row * cellH;
        var pw     = colSpan * cellW;
        var ph     = rowSpan * cellH;
        var innerW = pw - pad * 2;
        var innerH = ph - pad * 2;

        // CSS 퍼센트 좌표
        var leftPct   = (double)(px + pad) / canvasW * 100;
        var topPct    = (double)(py + pad) / canvasH * 100;
        var widthPct  = (double)innerW / canvasW * 100;
        var heightPct = (double)innerH / canvasH * 100;

        var hasMtWt = mtWt != null;
        var mt    = mtWt?.Mt ?? 0;
        var wt    = mtWt?.Wt ?? 0;
        var total = mt + wt;
        var isEmpty = !hasMtWt || total <= 0;

        // accent = 활동량 (MT dominant → primary, WT dominant → secondary). 데이터 없음 → 회색.
        // state  = Flow 상태 (도면 범례와 동일 색). 데이터 없음 → 회색.
        string accent;
        string stateColor;
        if (isEmpty)
        {
            accent = "var(--color-text-secondary)";
            stateColor = "var(--color-text-secondary)";
        }
        else
        {
            accent = mt >= wt ? "var(--color-primary)" : "var(--color-secondary)";
            stateColor = GetColor?.Invoke(fp) ?? accent;
        }

        // 도넛 비율
        var mtFrac = total > 0 ? (double)mt / total : 0.0;
        const double circ = 2 * Math.PI * 40;
        var mtDash = circ * mtFrac;

        var inv     = System.Globalization.CultureInfo.InvariantCulture;
        var sCirc   = circ.ToString("F1", inv);
        var sMtDash = mtDash.ToString("F1", inv);

        var badges = GetBadges?.Invoke(fp)?.ToList() ?? new List<(string Label, string Color)>();

        return new FlowBlockLayout
        {
            FlowName = fp.FlowName, AccentColor = accent, StateColor = stateColor, StateLabel = stateLabel,
            IsEmpty = isEmpty, Mt = mt, Wt = wt, Total = total,
            MtPercent = mtFrac * 100.0,
            Badges = badges,
            LeftPct = leftPct, TopPct = topPct,
            WidthPct = widthPct, HeightPct = heightPct,
            MtFrac = mtFrac,
            SCirc = sCirc, SMtDash = sMtDash,
        };
    }

    // ── 블록 클릭 → 항상 팝업 열기 (배경 클릭으로 닫기)
    private async Task OnBlockClicked(string flowName)
    {
        await OnFlowClicked.InvokeAsync(flowName);
    }

    // ── 배경 클릭 → 선택 해제 ──
    private async Task OnBackgroundClicked()
    {
        if (SelectedFlowName != null)
            await OnFlowClicked.InvokeAsync((string?)null);
    }

    // ── 시간 포맷 ──
    private static string FormatMs(int ms)
    {
        if (ms <= 0) return "0초";
        if (ms < 1000) return $"{ms}ms";
        if (ms < 60_000) return $"{ms / 1000.0:F1}초";
        if (ms < 3_600_000) return $"{ms / 60000}분 {ms % 60000 / 1000}초";
        return $"{ms / 3_600_000}시 {ms % 3_600_000 / 60000}분";
    }
}
