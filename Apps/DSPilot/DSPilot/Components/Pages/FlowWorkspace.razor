@page "/flow"
@using Ds2.Core
@using DSPilot.Models
@using DSPilot.Models.Dsp
@inject DsProjectService ProjectService
@inject DspDbService DbService
@inject DSPilot.Adapters.DspRepositoryAdapter DspRepository
@inject PlcToCallMapperService MapperService
@inject AppSettingsService SettingsService
@inject IFlowMetricsService FlowMetricsService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Flow Workspace - DSPilot</PageTitle>

<div class="flow-workspace-page">
@if (!ProjectService.IsLoaded)
{
    <section class="card flow-workspace-empty">
        <span class="material-icons">info</span>
        <div class="typo-h6 mt-2">프로젝트가 로드되지 않았습니다.</div>
        <div class="typo-body2 mt-1">AASX 프로젝트를 로드한 뒤 Flow Workspace를 사용할 수 있습니다.</div>
    </section>
}
else if (SelectedFlow is null)
{
    <section class="card flow-workspace-empty">
        <span class="material-icons">account_tree</span>
        <div class="typo-h6 mt-2">선택 가능한 Flow가 없습니다.</div>
        <div class="typo-body2 mt-1">왼쪽 Tree에서 Flow를 선택하거나 프로젝트 구조를 확인하세요.</div>
    </section>
}
else
{
    <section class="card flow-workspace-hero">
        <div class="flow-workspace-hero-main">
            <div class="flow-workspace-hero-top">
                <div>
                    <div class="flow-workspace-eyebrow">Flow Workspace</div>
                    <h4 class="flow-workspace-title">@SelectedFlow.Name</h4>
                    <div class="flow-workspace-subtitle">
                        <span>@SelectedSystemName</span>
                        <span>•</span>
                        <span>@_workCount Works</span>
                        <span>•</span>
                        <span>@_callRows.Count Calls</span>
                        <span>•</span>
                        <span>업데이트 @_dbSnapshot.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                    </div>
                </div>
                <div class="flow-workspace-hero-actions">
                    <div class="flow-workspace-button-row">
                        <button class="btn btn-outlined" @onclick="RefreshWorkspace">
                            <span class="material-icons" style="font-size:18px;">refresh</span>
                            새로고침
                        </button>
                    </div>
                </div>
            </div>
            <div class="flow-workspace-state-row">
                <span class="chip" style="@GetStateChipStyle(_flowRuntime?.State)">
                    @GetFlowStateLabel(_flowRuntime?.State)
                </span>
                @if (!string.IsNullOrWhiteSpace(_flowRuntime?.MovingStartName))
                {
                    <span class="chip flow-workspace-info-chip">Start: @_flowRuntime!.MovingStartName</span>
                }
                @if (!string.IsNullOrWhiteSpace(_flowRuntime?.MovingEndName))
                {
                    <span class="chip flow-workspace-info-chip">End: @_flowRuntime!.MovingEndName</span>
                }
            </div>
        </div>
    </section>

    <section class="card flow-workspace-panel">
        <div class="flow-workspace-panel-header">
            <div>
                <h6 class="typo-h6">Flow CT 기준</h6>
                <div class="typo-caption flow-workspace-muted">AASX 기본 start/end Call을 기준으로 사용자 override를 저장합니다.</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_cycleConfigMessage))
            {
                <div class="flow-workspace-cycle-message">@_cycleConfigMessage</div>
            }
        </div>

        <div class="flow-workspace-cycle-grid">
            <div class="flow-workspace-cycle-item">
                <label class="form-label">AASX 기본 시작 Call</label>
                <input class="form-field" value="@(_aasxDefaultStartCallName ?? "-")" disabled />
            </div>
            <div class="flow-workspace-cycle-item">
                <label class="form-label">AASX 기본 종료 Call</label>
                <input class="form-field" value="@(_aasxDefaultEndCallName ?? "-")" disabled />
            </div>
            <div class="flow-workspace-cycle-item">
                <label class="form-label">Cycle 시작 Call</label>
                <select class="form-select" @bind="_selectedCycleStartCallName">
                    @foreach (var option in _cycleCallOptions)
                    {
                        <option value="@option.CallName">@option.DisplayLabel</option>
                    }
                </select>
            </div>
            <div class="flow-workspace-cycle-item">
                <label class="form-label">Cycle 종료 Call</label>
                <select class="form-select" @bind="_selectedCycleEndCallName">
                    @foreach (var option in _cycleCallOptions)
                    {
                        <option value="@option.CallName">@option.DisplayLabel</option>
                    }
                </select>
            </div>
        </div>

        <div class="flow-workspace-cycle-actions">
            <button class="btn btn-filled" @onclick="SaveCycleBoundaryOverrideAsync" disabled="@(!_cycleCallOptions.Any())">
                <span class="material-icons" style="font-size:18px;">save</span>
                CT 기준 저장
            </button>
            <span class="typo-caption flow-workspace-muted">
                AASX 기본값과 동일하게 저장하면 override는 제거됩니다.
            </span>
        </div>
    </section>

    <section class="flow-workspace-kpi-grid">
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">Current CT</span>
            <strong class="flow-workspace-kpi-value">@FormatDurationMs(_flowRuntime?.CT)</strong>
            <span class="flow-workspace-kpi-sub">Flow 총 시간</span>
        </article>
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">MT</span>
            <strong class="flow-workspace-kpi-value">@FormatDurationMs(_flowRuntime?.MT)</strong>
            <span class="flow-workspace-kpi-sub">가동 시간</span>
        </article>
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">WT</span>
            <strong class="flow-workspace-kpi-value">@FormatDurationMs(_flowRuntime?.WT)</strong>
            <span class="flow-workspace-kpi-sub">대기 시간</span>
        </article>
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">Active Calls</span>
            <strong class="flow-workspace-kpi-value">@_activeCallCount</strong>
            <span class="flow-workspace-kpi-sub">현재 Going 상태</span>
        </article>
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">Error Calls</span>
            <strong class="flow-workspace-kpi-value">@_errorCallCount</strong>
            <span class="flow-workspace-kpi-sub">오류 상태 Call</span>
        </article>
        <article class="card flow-workspace-kpi">
            <span class="flow-workspace-kpi-label">Avg Call Time</span>
            <strong class="flow-workspace-kpi-value">@FormatDurationMs(_averageCallTimeMs)</strong>
            <span class="flow-workspace-kpi-sub">평균 Going 시간</span>
        </article>
    </section>

    <section class="card flow-workspace-panel">
        <div class="flow-workspace-panel-header">
            <div>
                <h6 class="typo-h6">기간별 추이</h6>
                <div class="typo-caption flow-workspace-muted">
                    현재 기간: @_periodStartLocal.ToString("yyyy-MM-dd HH:mm") ~ @_periodEndLocal.ToString("yyyy-MM-dd HH:mm")
                    (버킷: @BucketLabel(_granularity), 사이클 @_periodCycleCount.ToString("N0") 건)
                </div>
            </div>
            <div class="flow-workspace-period-controls">
                <button class="btn btn-sm @(_periodPreset == "today" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPeriodAsync("today"))">오늘</button>
                <button class="btn btn-sm @(_periodPreset == "7d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPeriodAsync("7d"))">지난 7일</button>
                <button class="btn btn-sm @(_periodPreset == "30d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPeriodAsync("30d"))">지난 30일</button>
                <button class="btn btn-sm @(_periodPreset == "60d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPeriodAsync("60d"))">지난 60일</button>
            </div>
        </div>

        @if (_isLoadingHistory)
        {
            <div class="flow-workspace-trend-empty">
                <span class="material-icons">hourglass_top</span>
                <span>히스토리 데이터를 불러오는 중...</span>
            </div>
        }
        else if (_periodCycleCount == 0)
        {
            <div class="flow-workspace-trend-empty">
                <span class="material-icons">timeline</span>
                <span>선택 기간에 기록된 사이클이 없습니다.</span>
            </div>
        }
        else
        {
            <div class="flow-workspace-trend-kpi-row">
                <article class="flow-workspace-trend-kpi">
                    <span class="flow-workspace-trend-kpi-label">사이클 수</span>
                    <strong class="flow-workspace-trend-kpi-value">@_periodCycleCount.ToString("N0")</strong>
                    <span class="flow-workspace-trend-kpi-sub">비가동 @_periodIdleCount.ToString("N0") 건</span>
                </article>
                <article class="flow-workspace-trend-kpi">
                    <span class="flow-workspace-trend-kpi-label">평균 CT</span>
                    <strong class="flow-workspace-trend-kpi-value">@FormatDurationMs(_periodAvgCT)</strong>
                    <span class="flow-workspace-trend-kpi-sub">최소 @FormatDurationMs(_periodMinCT) · 최대 @FormatDurationMs(_periodMaxCT)</span>
                </article>
                <article class="flow-workspace-trend-kpi">
                    <span class="flow-workspace-trend-kpi-label">평균 MT</span>
                    <strong class="flow-workspace-trend-kpi-value">@FormatDurationMs(_periodAvgMT)</strong>
                    <span class="flow-workspace-trend-kpi-sub">가동 시간</span>
                </article>
                <article class="flow-workspace-trend-kpi">
                    <span class="flow-workspace-trend-kpi-label">평균 WT</span>
                    <strong class="flow-workspace-trend-kpi-value">@FormatDurationMs(_periodAvgWT)</strong>
                    <span class="flow-workspace-trend-kpi-sub">대기 시간</span>
                </article>
                <article class="flow-workspace-trend-kpi">
                    <span class="flow-workspace-trend-kpi-label">가동률</span>
                    <strong class="flow-workspace-trend-kpi-value">@($"{_periodUtilization * 100:F1}%")</strong>
                    <span class="flow-workspace-trend-kpi-sub">MT / (MT + WT)</span>
                </article>
            </div>

            <div class="flow-workspace-trend-chart-tall">
                <canvas id="flow-trend-chart"></canvas>
            </div>

            <div class="flow-workspace-trend-chart-row">
                <div class="flow-workspace-trend-chart-half">
                    <h6 class="typo-h6">사이클 수</h6>
                    <div class="flow-workspace-trend-chart-md">
                        <canvas id="flow-cycle-count-chart"></canvas>
                    </div>
                </div>
                <div class="flow-workspace-trend-chart-half">
                    <h6 class="typo-h6">시간 구성</h6>
                    <div class="flow-workspace-trend-chart-md">
                        <canvas id="flow-time-distribution"></canvas>
                    </div>
                </div>
            </div>
        }
    </section>

    <section class="card flow-workspace-panel">
        <div class="flow-workspace-panel-header">
            <div>
                <h6 class="typo-h6">Call Inventory</h6>
                <div class="typo-caption flow-workspace-muted">Work / Call / InTag / OutTag / 상태를 한 번에 확인</div>
            </div>
            <div class="flow-workspace-inventory-controls">
                <input class="form-field"
                       value="@_searchText"
                       @oninput="OnSearchChanged"
                       placeholder="Call, Work, Tag 검색" />
                <select class="form-select" value="@(_stateFilter ?? string.Empty)" @onchange="OnStateFilterChanged">
                    <option value="">State (전체)</option>
                    @foreach (var state in _stateOptions)
                    {
                        <option value="@state">@state</option>
                    }
                </select>
                <button class="btn btn-sm btn-outlined" @onclick="ExportCsv" disabled="@(FilteredCallRows.Count == 0)">CSV 내보내기</button>
            </div>
        </div>

        <div class="table-container" style="max-height: calc(100vh - 420px); overflow:auto;">
            <table class="table table-hover table-striped">
                <thead class="table-head-sticky">
                    <tr>
                        <th>Work</th>
                        <th>Call</th>
                        <th>In Tag</th>
                        <th>Out Tag</th>
                        <th>State</th>
                        <th>Count</th>
                        <th>Avg Time</th>
                        <th>Device</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredCallRows.Count == 0)
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:24px; color:var(--color-text-secondary);">
                                표시할 Call이 없습니다.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredCallRows)
                        {
                            <tr>
                                <td>@row.WorkName</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <img src="images/aas.png" alt="" style="width: 16px; height: 16px; object-fit: contain; flex-shrink: 0;" />
                                        @row.CallName
                                    </div>
                                </td>
                                <td>@(row.InTag ?? "-")</td>
                                <td>@(row.OutTag ?? "-")</td>
                                <td>
                                    <span class="chip" style="@GetStateChipStyle(row.State)">
                                        @GetFlowStateLabel(row.State)
                                    </span>
                                </td>
                                <td>@row.GoingCount</td>
                                <td>@FormatDurationMs(row.AverageGoingTime)</td>
                                <td>@(row.Device ?? "-")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(row.ErrorText))
                                    {
                                        <span class="flow-workspace-error-text" title="@row.ErrorText">Error</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--color-text-disabled);">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
</div>

<style>
    .flow-workspace-page {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: calc(100vh - 100px);
    }

    .flow-workspace-hero {
        padding: 20px 24px;
        background:
            radial-gradient(circle at top left, rgba(0, 155, 180, 0.10), transparent 32%),
            linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.05), var(--color-surface));
    }

    .flow-workspace-hero-top {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
    }

    .flow-workspace-eyebrow {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-primary);
        font-weight: 700;
    }

    .flow-workspace-title {
        margin: 6px 0 0;
        font-weight: 700;
        color: var(--color-text-primary);
    }

    .flow-workspace-subtitle {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        color: var(--color-text-secondary);
        font-size: 0.95rem;
    }

    .flow-workspace-hero-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 360px;
    }

    .flow-workspace-button-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .flow-workspace-state-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .flow-workspace-info-chip {
        background: rgba(var(--color-primary-rgb), 0.08);
        color: var(--color-primary);
    }

    .flow-workspace-kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 12px;
    }

    .flow-workspace-kpi {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .flow-workspace-kpi-label {
        color: var(--color-text-secondary);
        font-size: 0.84rem;
    }

    .flow-workspace-kpi-value {
        font-size: 1.5rem;
        color: var(--color-text-primary);
        font-weight: 700;
    }

    .flow-workspace-kpi-sub {
        color: var(--color-text-secondary);
        font-size: 0.82rem;
    }

    .flow-workspace-secondary-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 16px;
    }

    .flow-workspace-panel {
        padding: 18px 20px;
    }

    .flow-workspace-cycle-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .flow-workspace-cycle-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .flow-workspace-cycle-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .flow-workspace-cycle-message {
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(var(--color-primary-rgb), 0.08);
        color: var(--color-primary);
        font-size: 0.82rem;
        font-weight: 600;
    }

    .flow-workspace-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 16px;
    }

    .flow-workspace-muted {
        color: var(--color-text-secondary);
    }

    .flow-workspace-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .flow-workspace-summary-item {
        padding: 12px 14px;
        border-radius: 10px;
        background: rgba(var(--color-primary-rgb), 0.04);
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .flow-workspace-summary-label {
        color: var(--color-text-secondary);
        font-size: 0.8rem;
    }

    .flow-workspace-work-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .flow-workspace-work-card {
        border-radius: 10px;
        border: 1px solid var(--color-lines);
        padding: 12px 14px;
        background: rgba(var(--color-primary-rgb), 0.02);
    }

    .flow-workspace-work-title {
        font-weight: 700;
        color: var(--color-primary);
    }

    .flow-workspace-work-meta,
    .flow-workspace-work-avg {
        font-size: 0.84rem;
        color: var(--color-text-secondary);
        margin-top: 4px;
    }

    .flow-workspace-work-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
        font-size: 0.82rem;
    }

    .flow-workspace-focus-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .flow-workspace-focus-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        border: 1px solid var(--color-lines);
        border-radius: 10px;
        padding: 12px 14px;
    }

    .flow-workspace-focus-name {
        font-weight: 700;
        color: var(--color-primary);
    }

    .flow-workspace-focus-sub {
        font-size: 0.82rem;
        color: var(--color-text-secondary);
        margin-top: 4px;
    }

    .flow-workspace-focus-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .flow-workspace-focus-time {
        font-weight: 600;
        color: var(--color-primary);
    }

    .flow-workspace-inventory-controls {
        display: flex;
        gap: 10px;
        min-width: 420px;
    }

    .flow-workspace-error-text {
        color: var(--color-error);
        font-weight: 600;
        cursor: help;
    }

    .flow-workspace-period-controls {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .flow-workspace-trend-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 28px 12px;
        color: var(--color-text-secondary);
    }

    .flow-workspace-trend-empty .material-icons {
        font-size: 28px;
        opacity: 0.6;
    }

    .flow-workspace-trend-kpi-row {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .flow-workspace-trend-kpi {
        background: rgba(var(--color-primary-rgb), 0.04);
        border: 1px solid var(--color-lines);
        border-radius: 8px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .flow-workspace-trend-kpi-label {
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
    }

    .flow-workspace-trend-kpi-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-text-primary);
        line-height: 1.1;
    }

    .flow-workspace-trend-kpi-sub {
        font-size: 0.78rem;
        color: var(--color-text-secondary);
    }

    .flow-workspace-trend-chart-tall {
        position: relative;
        height: 320px;
        margin-bottom: 16px;
    }

    .flow-workspace-trend-chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
    }

    .flow-workspace-trend-chart-half {
        min-width: 0;
    }

    .flow-workspace-trend-chart-md {
        position: relative;
        height: 260px;
    }

    .flow-workspace-empty {
        padding: 40px 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--color-text-secondary);
        min-height: 280px;
    }

    .flow-workspace-empty .material-icons {
        font-size: 44px;
        color: var(--color-primary);
    }

    @@media (max-width: 1200px) {
        .flow-workspace-kpi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .flow-workspace-secondary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {
        .flow-workspace-hero-top {
            flex-direction: column;
        }

        .flow-workspace-hero-actions,
        .flow-workspace-inventory-controls {
            min-width: 0;
            width: 100%;
        }

        .flow-workspace-kpi-grid,
