    private void RefreshWorkspace()
    {
        ApplySnapshot(DbService.Snapshot, true);
        _ = ReloadTrendAsync();
    }

    private bool ApplySnapshot(DspDbSnapshot snapshot, bool forceRender = false)
    {
        var nextSignature = BuildWorkspaceSignature(snapshot);
        if (!forceRender && nextSignature == _workspaceSignature)
        {
            return false;
        }

        _dbSnapshot = snapshot;
        RebuildWorkspace();
        _workspaceSignature = nextSignature;
        return true;
    }

    private void RebuildWorkspace()
    {
        _callRows = [];
        _flowRuntime = null;
        _workCount = 0;
        _activeCallCount = 0;
        _errorCallCount = 0;
        _finishedCallCount = 0;
        _readyCallCount = 0;
        _averageCallTimeMs = null;
        _completionRate = 0.0;
        _workSummaries = [];

        var flow = SelectedFlow;
        if (flow is null)
        {
            return;
        }

        _flowRuntime = _dbSnapshot.Flows.FirstOrDefault(item => item.FlowName == flow.Name);

        var works = ProjectService.GetWorks(flow.Id)
            .OrderBy(work => work.Name)
            .ToList();
        _workCount = works.Count;

        if (!string.Equals(_cycleEditorFlowName, flow.Name, StringComparison.OrdinalIgnoreCase) || _cycleCallOptions.Count == 0)
        {
            LoadCycleBoundaryEditor(flow, works);
        }

        var runtimeCalls = _dbSnapshot.CallsByFlow.TryGetValue(flow.Name, out var callsByFlow)
            ? callsByFlow
            : [];

        _callRows = works
            .SelectMany(work => ProjectService.GetCalls(work.Id)
                .OrderBy(call => call.Name)
                .Select(call =>
                {
                    var runtime = runtimeCalls.FirstOrDefault(item => item.CallId == call.Id) ??
                                  _dbSnapshot.Calls.FirstOrDefault(item => item.CallId == call.Id);
                    var tags = MapperService.GetCallTagsByCallId(call.Id);

                    return new CallInventoryRow(
                        call.Id,
                        call.Name,
                        work.Name,
                        tags?.InTag,
                        tags?.OutTag,
                        runtime?.State ?? "Ready",
                        runtime?.GoingCount ?? 0,
                        runtime?.AverageGoingTime,
                        runtime?.Device,
                        runtime?.ErrorText);
                }))
            .ToList();

        _activeCallCount = _callRows.Count(row => string.Equals(row.State, "Going", StringComparison.OrdinalIgnoreCase));
        _errorCallCount = _callRows.Count(row => string.Equals(row.State, "Error", StringComparison.OrdinalIgnoreCase));
        _finishedCallCount = _callRows.Count(row => string.Equals(row.State, "Finish", StringComparison.OrdinalIgnoreCase));
        _readyCallCount = _callRows.Count(row => string.Equals(row.State, "Ready", StringComparison.OrdinalIgnoreCase));
        _completionRate = _callRows.Count > 0 ? (double)_finishedCallCount / _callRows.Count : 0.0;

        var avgSamples = _callRows
            .Where(row => row.AverageGoingTime is > 0)
            .Select(row => row.AverageGoingTime!.Value)
            .ToList();
        _averageCallTimeMs = avgSamples.Count > 0 ? avgSamples.Average() : null;

        _workSummaries = _callRows
            .GroupBy(row => row.WorkName)
            .Select(group =>
            {
                var averages = group.Where(row => row.AverageGoingTime is > 0).Select(row => row.AverageGoingTime!.Value).ToList();
                return new WorkSummaryRow(
                    group.Key,
                    group.Count(),
                    group.Count(row => string.Equals(row.State, "Going", StringComparison.OrdinalIgnoreCase)),
                    group.Count(row => string.Equals(row.State, "Error", StringComparison.OrdinalIgnoreCase)),
                    group.Count(row => string.Equals(row.State, "Finish", StringComparison.OrdinalIgnoreCase)),
                    averages.Count > 0 ? averages.Average() : null);
            })
            .OrderBy(row => row.WorkName)
            .ToList();
    }

    private void LoadCycleBoundaryEditor(Flow flow, List<Work> works)
    {
        _cycleEditorFlowName = flow.Name;
        _cycleCallOptions = works
            .SelectMany(work => ProjectService.GetCalls(work.Id)
                .OrderBy(call => call.Name)
                .Select(call => new FlowCycleCallOption(call.Name, call.Name)))
            .ToList();

        var (defaultStartCallName, defaultEndCallName) = FlowMetricsService.GetAasxCycleBoundaries(flow.Name);
        _aasxDefaultStartCallName = defaultStartCallName;
        _aasxDefaultEndCallName = defaultEndCallName;

        var overrideConfig = SettingsService.GetFlowCycleOverride(flow.Name);
        _selectedCycleStartCallName = NormalizeCycleSelection(
            overrideConfig?.StartCallName ?? defaultStartCallName,
            _cycleCallOptions);
        _selectedCycleEndCallName = NormalizeCycleSelection(
            overrideConfig?.EndCallName ?? defaultEndCallName,
            _cycleCallOptions);

        _cycleConfigMessage = overrideConfig is null
            ? "현재 AASX 기본값 사용 중"
            : "사용자 override 저장됨";
    }

    private async Task SaveCycleBoundaryOverrideAsync()
    {
        var flow = SelectedFlow;
        if (flow is null)
        {
            return;
        }

        var effectiveStartCallName = NormalizeCycleSelection(_selectedCycleStartCallName, _cycleCallOptions) ?? _aasxDefaultStartCallName;
        var effectiveEndCallName = NormalizeCycleSelection(_selectedCycleEndCallName, _cycleCallOptions) ?? _aasxDefaultEndCallName;

        var overrideStartCallName = string.Equals(effectiveStartCallName, _aasxDefaultStartCallName, StringComparison.OrdinalIgnoreCase)
            ? null
            : effectiveStartCallName;
        var overrideEndCallName = string.Equals(effectiveEndCallName, _aasxDefaultEndCallName, StringComparison.OrdinalIgnoreCase)
            ? null
            : effectiveEndCallName;

        SettingsService.SaveFlowCycleOverride(flow.Name, overrideStartCallName, overrideEndCallName);
        await FlowMetricsService.ApplyCycleBoundaryOverrideAsync(flow.Name, effectiveStartCallName, effectiveEndCallName);

        if (_flowRuntime is not null)
        {
            _flowRuntime.MovingStartName = effectiveStartCallName is null ? null : $"{flow.Name}.{effectiveStartCallName}";
            _flowRuntime.MovingEndName = effectiveEndCallName is null ? null : $"{flow.Name}.{effectiveEndCallName}";
            _workspaceSignature = BuildWorkspaceSignature(_dbSnapshot);
        }

        _cycleConfigMessage = string.IsNullOrWhiteSpace(overrideStartCallName) && string.IsNullOrWhiteSpace(overrideEndCallName)
            ? "AASX 기본값으로 저장됨"
            : "사용자 override 저장됨";
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private void OnStateFilterChanged(ChangeEventArgs e)
    {
        _stateFilter = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString();
    }

    private bool MatchesStateFilter(CallInventoryRow row)
    {
        return string.IsNullOrWhiteSpace(_stateFilter) ||
               string.Equals(row.State, _stateFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSearchFilter(CallInventoryRow row)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        return row.CallName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
               row.WorkName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
               (row.InTag?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (row.OutTag?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OnDbDataChanged()
    {
        if (_disposed)
        {
            return;
        }

        var snapshot = DbService.Snapshot;

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return Task.CompletedTask;
            }

            if (ApplySnapshot(snapshot))
            {
                StateHasChanged();
            }

            return Task.CompletedTask;
        });
    }

    private string BuildWorkspaceSignature(DspDbSnapshot snapshot)
    {
        if (!ProjectService.IsLoaded)
        {
            return "project:not-loaded";
        }

        if (string.IsNullOrWhiteSpace(_selectedFlowName))
        {
            return "flow:none";
        }

        var flow = ProjectService.GetFlowByName(_selectedFlowName);
        if (flow is null)
        {
            return $"flow:missing:{_selectedFlowName}";
        }

        var parts = new List<string>(64)
        {
            flow.Name
        };

        var runtimeFlow = snapshot.Flows.FirstOrDefault(item => item.FlowName == flow.Name);
        parts.Add(runtimeFlow?.State ?? string.Empty);
        parts.Add(runtimeFlow?.CT?.ToString() ?? string.Empty);
        parts.Add(runtimeFlow?.MT?.ToString() ?? string.Empty);
        parts.Add(runtimeFlow?.WT?.ToString() ?? string.Empty);
        parts.Add(runtimeFlow?.MovingStartName ?? string.Empty);
        parts.Add(runtimeFlow?.MovingEndName ?? string.Empty);

        var runtimeCalls = snapshot.CallsByFlow.TryGetValue(flow.Name, out var callsByFlow)
            ? callsByFlow
            : [];
        var runtimeByCallId = runtimeCalls
            .DistinctBy(call => call.CallId)
            .ToDictionary(call => call.CallId, call => call);

        foreach (var work in ProjectService.GetWorks(flow.Id).OrderBy(work => work.Name))
        {
            foreach (var call in ProjectService.GetCalls(work.Id).OrderBy(call => call.Name))
            {
                runtimeByCallId.TryGetValue(call.Id, out var runtimeCall);
                parts.Add(call.Id.ToString("N"));
                parts.Add(runtimeCall?.State ?? "Ready");
                parts.Add((runtimeCall?.GoingCount ?? 0).ToString());
                parts.Add(runtimeCall?.AverageGoingTime?.ToString("F3") ?? string.Empty);
                parts.Add(runtimeCall?.Device ?? string.Empty);
                parts.Add(runtimeCall?.ErrorText ?? string.Empty);
            }
        }

        return string.Join('|', parts);
    }

    private static string GetFlowStateLabel(string? state)
        => string.IsNullOrWhiteSpace(state) ? "No Data" : state;

    private static string GetStateChipStyle(string? state)
    {
        var normalized = state?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "going" => "background:#EAB308; color:white;",
            "finish" => "background:#2196F3; color:white;",
            "error" => "background:#F44336; color:white;",
            "pause" => "background:#FF9800; color:white;",
            "abort" => "background:#7B1FA2; color:white;",
            "ready" => "background:#4CAF50; color:white;",
            _ => "background:rgba(var(--color-primary-rgb), 0.10); color:var(--color-primary);"
        };
    }

    private static string FormatDurationMs(double? milliseconds)
    {
        if (milliseconds is null || milliseconds <= 0)
        {
            return "-";
        }

        return $"{milliseconds / 1000.0:F1} sec";
    }

    private static string? NormalizeCycleSelection(string? callName, List<FlowCycleCallOption> options)
    {
        var firstOption = options.FirstOrDefault();
        if (firstOption is null)
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(callName))
        {
            return firstOption.CallName;
        }

        var trimmed = callName.Trim();
        var option = options.FirstOrDefault(item => string.Equals(item.CallName, trimmed, StringComparison.OrdinalIgnoreCase));
        return option?.CallName ?? firstOption.CallName;
    }

    private async Task ExportCsv()
    {
        var rows = FilteredCallRows;
        if (rows.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Work,Call,In Tag,Out Tag,State,Count,Avg Time,Device,Error");

        foreach (var row in rows)
        {
            sb.AppendLine(string.Join(",",
                CsvEscape(row.WorkName),
                CsvEscape(row.CallName),
                CsvEscape(row.InTag ?? "-"),
                CsvEscape(row.OutTag ?? "-"),
                CsvEscape(GetFlowStateLabel(row.State)),
                row.GoingCount,
                CsvEscape(FormatDurationMs(row.AverageGoingTime)),
                CsvEscape(row.Device ?? "-"),
                CsvEscape(row.ErrorText ?? "-")));
        }

        var flowName = _selectedFlowName ?? "Flow";
        var fileName = $"CallInventory_{flowName}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var byteChars = atob('{base64}');
                var bytes = new Uint8Array(byteChars.length);
                for (var i = 0; i < byteChars.length; i++) bytes[i] = byteChars.charCodeAt(i);
                var blob = new Blob([bytes], {{ type: 'text/csv;charset=utf-8' }});
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = '{fileName}';
                a.click();
                URL.revokeObjectURL(a.href);
            }})();
        ");
    }

    private static string CsvEscape(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    private void SetPeriodState(string preset)
    {
        _periodPreset = preset;
        var now = DateTime.Now;
        switch (preset)
        {
            case "today":
                _periodStartLocal = now.Date;
                _periodEndLocal = now;
                _granularity = "hour";
                break;
            case "7d":
                _periodStartLocal = now.Date.AddDays(-6);
                _periodEndLocal = now;
                _granularity = "day";
                break;
            case "30d":
                _periodStartLocal = now.Date.AddDays(-29);
                _periodEndLocal = now;
                _granularity = "day";
                break;
            case "60d":
                _periodStartLocal = now.Date.AddDays(-59);
                _periodEndLocal = now;
                _granularity = "week";
                break;
            default:
                _periodStartLocal = now.Date;
                _periodEndLocal = now;
                _granularity = "hour";
                _periodPreset = "today";
                break;
        }
    }

    private async Task SetPeriodAsync(string preset)
    {
        SetPeriodState(preset);
        await ReloadTrendAsync();
    }

    private async Task ReloadTrendAsync()
    {
        if (_disposed) return;

        var flow = SelectedFlow;
        if (flow is null)
        {
            ResetTrendStats();
            _trendBuckets = [];
            _trendLoadedFlowName = null;
            _trendChartsNeedRedraw = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _trendCts?.Cancel();
        _trendCts = new CancellationTokenSource();
        var ct = _trendCts.Token;

        _isLoadingHistory = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var startUtc = _periodStartLocal.ToUniversalTime();
            var histories = await DspRepository.GetFlowHistoryByStartTimeAsync(flow.Name, startUtc);
            if (ct.IsCancellationRequested || _disposed) return;

            var endUtc = _periodEndLocal.ToUniversalTime();
            histories = histories
                .Where(h => h.RecordedAt <= endUtc)
                .ToList();

            BuildTrendStats(histories);
            _trendBuckets = BuildBuckets(histories, _periodStartLocal, _periodEndLocal, _granularity);
            _trendLoadedFlowName = flow.Name;
            _trendChartsNeedRedraw = true;
        }
        catch (OperationCanceledException) { /* superseded */ }
        catch (Exception)
        {
            ResetTrendStats();
            _trendBuckets = [];
            _trendChartsNeedRedraw = true;
        }
        finally
        {
            _isLoadingHistory = false;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetTrendStats()
    {
        _periodCycleCount = 0;
        _periodIdleCount = 0;
        _periodAvgCT = null;
        _periodAvgMT = null;
        _periodAvgWT = null;
        _periodMinCT = null;
        _periodMaxCT = null;
        _periodUtilization = 0.0;
        _periodTotalMt = 0;
        _periodTotalWt = 0;
    }

    private void BuildTrendStats(IReadOnlyList<DspFlowHistoryEntity> histories)
    {
        ResetTrendStats();
        if (histories.Count == 0) return;

        _periodCycleCount = histories.Count;
        _periodIdleCount = histories.Count(h => h.IsIdle);

        var ct = histories.Where(h => h.CT.HasValue).Select(h => (double)h.CT!.Value).ToList();
        var mt = histories.Where(h => h.MT.HasValue).Select(h => (double)h.MT!.Value).ToList();
        var wt = histories.Where(h => h.WT.HasValue).Select(h => (double)h.WT!.Value).ToList();

        if (ct.Count > 0)
        {
            _periodAvgCT = ct.Average();
            _periodMinCT = ct.Min();
            _periodMaxCT = ct.Max();
        }
        if (mt.Count > 0) _periodAvgMT = mt.Average();
        if (wt.Count > 0) _periodAvgWT = wt.Average();

        _periodTotalMt = (long)mt.Sum();
        _periodTotalWt = (long)wt.Sum();
        var denom = _periodTotalMt + _periodTotalWt;
        _periodUtilization = denom > 0 ? (double)_periodTotalMt / denom : 0.0;
    }

    private static List<TrendBucket> BuildBuckets(
        IReadOnlyList<DspFlowHistoryEntity> histories,
        DateTime periodStartLocal,
        DateTime periodEndLocal,
        string granularity)
    {
        if (histories.Count == 0) return [];

        var agg = new Dictionary<DateTime, BucketAccumulator>();
        foreach (var h in histories)
        {
            var localTs = h.RecordedAt.ToLocalTime();
            var bucketStart = TruncateToBucket(localTs, granularity);
            if (!agg.TryGetValue(bucketStart, out var acc))
            {
                acc = new BucketAccumulator();
                agg[bucketStart] = acc;
            }
            acc.Count++;
            if (h.IsIdle) acc.IdleCount++;
            if (h.CT.HasValue) { acc.SumCt += h.CT.Value; acc.CountCt++; }
            if (h.MT.HasValue) { acc.SumMt += h.MT.Value; acc.CountMt++; }
            if (h.WT.HasValue) { acc.SumWt += h.WT.Value; acc.CountWt++; }
        }

        return agg
            .OrderBy(kv => kv.Key)
            .Select(kv => new TrendBucket(
                kv.Key,
                kv.Value.CountCt > 0 ? kv.Value.SumCt / (double)kv.Value.CountCt : 0,
                kv.Value.CountMt > 0 ? kv.Value.SumMt / (double)kv.Value.CountMt : 0,
                kv.Value.CountWt > 0 ? kv.Value.SumWt / (double)kv.Value.CountWt : 0,
                kv.Value.Count,
                kv.Value.IdleCount))
            .ToList();
    }

    private static DateTime TruncateToBucket(DateTime localTs, string granularity)
    {
        return granularity switch
        {
            "hour" => new DateTime(localTs.Year, localTs.Month, localTs.Day, localTs.Hour, 0, 0, DateTimeKind.Local),
            "day"  => localTs.Date,
            "week" => localTs.Date.AddDays(-(int)localTs.DayOfWeek), // 일요일 시작
            "month"=> new DateTime(localTs.Year, localTs.Month, 1, 0, 0, 0, DateTimeKind.Local),
            _       => localTs.Date,
        };
    }

    private async Task DrawTrendChartsAsync()
    {
        if (_disposed || _trendChartModule is null) return;
        if (_periodCycleCount == 0) return;
        try
        {
            // 버킷 시간 → ISO (local with offset). Chart.js time scale 이 그대로 표시.
            var bucketsJs = _trendBuckets.Select(b => new
            {
                bucketStartIso = new DateTimeOffset(b.BucketStart, TimeZoneInfo.Local.GetUtcOffset(b.BucketStart)).ToString("o"),
                avgCT = Math.Round(b.AvgCT / 1000.0, 3),
                avgMT = Math.Round(b.AvgMT / 1000.0, 3),
                avgWT = Math.Round(b.AvgWT / 1000.0, 3),
                count = b.Count,
                idleCount = b.IdleCount,
            }).ToArray();

            await _trendChartModule.InvokeVoidAsync("renderTrendChart", "flow-trend-chart", bucketsJs, _granularity);
            if (_disposed) return;
            await _trendChartModule.InvokeVoidAsync("renderCycleCountChart", "flow-cycle-count-chart", bucketsJs, _granularity);
            if (_disposed) return;
            await _trendChartModule.InvokeVoidAsync("renderTimeDistribution", "flow-time-distribution",
                new { mt = _periodTotalMt, wt = _periodTotalWt });
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit closed */ }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception) { /* canvas swapped out — ignore */ }
    }

    private static string BucketLabel(string g) => g switch
    {
        "hour"  => "1시간",
        "day"   => "1일",
        "week"  => "1주",
        "month" => "1개월",
        _        => g,
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        DbService.OnDataChanged -= OnDbDataChanged;
        _trendCts?.Cancel();
        if (_trendChartModule is not null)
        {
            try { await _trendChartModule.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch { }
        }
    }

