@page "/cctv"
@implements IAsyncDisposable
@using DSPilot.Models
@using DSPilot.Services
@inject AppSettingsService SettingsService
@inject CctvMediaMtxService MediaMtx
@inject IJSRuntime JS

<PageTitle>CCTV - DSPilot</PageTitle>

<div class="cctv-page">
    <section class="cctv-header">
        <h1 class="typo-h5" style="margin:0;">CCTV</h1>
        <div class="cctv-header-actions">
            <span class="cctv-status @(MediaMtx.LastSyncOk ? "ok" : "fail")">
                <span class="material-icons" style="font-size:16px;">@(MediaMtx.LastSyncOk ? "videocam" : "videocam_off")</span>
                @MediaMtx.LastSyncMessage
            </span>
            <button class="btn btn-outlined btn-sm" @onclick="ResyncAsync">
                <span class="material-icons" style="font-size:16px;">sync</span> 재동기화
            </button>
        </div>
    </section>

    @if (_cameras.Count == 0)
    {
        <div class="cctv-empty">
            <span class="material-icons" style="font-size:48px; opacity:.4;">videocam_off</span>
            <p>등록된 카메라가 없습니다.</p>
            <a class="btn btn-outlined btn-sm" href="settings">
                <span class="material-icons" style="font-size:16px;">settings</span> 설정에서 카메라 추가
            </a>
        </div>
    }
    else
    {
        @if (_hiddenCount > 0)
        {
            <div class="cctv-overflow-note">
                <span class="material-icons" style="font-size:16px;">info</span>
                FHD 디테일 모니터링을 위해 동시 표시는 최대 6대로 제한합니다.
                현재 표시 6대 / 등록 @(_cameras.Count + _hiddenCount)대 (나머지 @(_hiddenCount)대는 다음 버전에서 페이지네이션 지원 예정).
            </div>
        }
        <div class="cctv-grid count-@_cameras.Count">
            @foreach (var cam in _cameras)
            {
                var sid = MediaMtxId(cam.Name);
                <div class="cctv-tile" @onclick="@(() => Expand(cam))">
                    <video id="@($"cctv-grid-{sid}")" muted autoplay playsinline></video>
                    <div class="cctv-tile-label">
                        <span class="material-icons" style="font-size:14px;">photo_camera</span>
                        @cam.Name
                    </div>
                    <div class="cctv-tile-expand">
                        <span class="material-icons">fullscreen</span>
                    </div>
                </div>
            }
        </div>
    }

    @if (_expanded is not null)
    {
        <div class="cctv-modal-backdrop" @onclick="Collapse">
            <div class="cctv-modal" @onclick:stopPropagation="true">
                <div class="cctv-modal-bar">
                    <span><span class="material-icons" style="font-size:18px; vertical-align:middle;">photo_camera</span> @_expanded.Name</span>
                    <button class="cctv-modal-close" @onclick="Collapse" title="닫기">
                        <span class="material-icons">close</span>
                    </button>
                </div>
                <video id="@($"cctv-modal-{MediaMtxId(_expanded.Name)}")" muted autoplay playsinline></video>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>FHD 모니터에서 디테일 식별 가능한 최소 분할 = 6대(3×2). 그 이상은 다음 버전에서 페이지네이션.</summary>
    private const int MaxConcurrentCameras = 6;

    private List<CctvCamera> _cameras = new();
    private int _hiddenCount;
    private int _webRtcPort = 8889;
    private CctvCamera? _expanded;

    private bool _gridStarted;
    private string? _modalStartedId;

    private static string MediaMtxId(string name) => CctvMediaMtxService.SanitizeName(name);

    protected override void OnInitialized()
    {
        var cctv = SettingsService.LoadSettings().Cctv;
        _webRtcPort = cctv.WebRtcPort;
        var enabled = cctv.Cameras
            .Where(c => c.Enabled && !string.IsNullOrWhiteSpace(c.Name) && !string.IsNullOrWhiteSpace(c.RtspUrl))
            .ToList();
        _cameras = enabled.Take(MaxConcurrentCameras).ToList();
        _hiddenCount = Math.Max(0, enabled.Count - _cameras.Count);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 그리드 타일 플레이어 시작 (목록 로드 후 1회)
        if (!_gridStarted && _cameras.Count > 0)
        {
            _gridStarted = true;
            foreach (var cam in _cameras)
            {
                var sid = MediaMtxId(cam.Name);
                await JS.InvokeVoidAsync("cctvWhep.start", $"cctv-grid-{sid}", _webRtcPort, sid);
            }
        }

        // 모달 플레이어 — 확대 대상이 바뀌면 이전 것 정지 후 새로 시작
        var wantId = _expanded is null ? null : $"cctv-modal-{MediaMtxId(_expanded.Name)}";
        if (wantId != _modalStartedId)
        {
            if (_modalStartedId is not null)
                await JS.InvokeVoidAsync("cctvWhep.stop", _modalStartedId);

            if (wantId is not null && _expanded is not null)
                await JS.InvokeVoidAsync("cctvWhep.start", wantId, _webRtcPort, MediaMtxId(_expanded.Name));

            _modalStartedId = wantId;
        }
    }

    private void Expand(CctvCamera cam) => _expanded = cam;

    private void Collapse() => _expanded = null;

    private async Task ResyncAsync()
    {
        await MediaMtx.SyncAsync();
        await JS.InvokeVoidAsync("uiUtils.showSnackbar", MediaMtx.LastSyncMessage,
            MediaMtx.LastSyncOk ? "success" : "error");
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("cctvWhep.stopAll"); }
        catch { /* 회로 이미 종료 */ }
    }
}
