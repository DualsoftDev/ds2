@page "/user-tags"
@using DSPilot.Models.UserTagAlerts
@using DSPilot.Repositories
@using DSPilot.Services
@inject UserTagAlertService AlertService
@inject IUserTagAlertRepository AlertRepo
@inject DsProjectService ProjectService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>UserTag 알림 - DSPilot</PageTitle>

<div class="user-tags-page">
    <section class="card user-tags-hero">
        <div class="user-tags-hero-top">
            <div>
                <div class="user-tags-eyebrow">UserTag Alerts</div>
                <h4 class="user-tags-title">UserTag 알림 / 추이</h4>
                <div class="user-tags-subtitle">
                    AASX 에 정의된 UserTag 가 PLC 에서 조건 충족 시 자동 기록된 이벤트의 실시간 + 기간별 추이입니다.
                </div>
            </div>
            <div class="user-tags-hero-actions">
                <div class="user-tags-counter-row">
                    <span class="chip chip-level-info" title="Info">INFO @(_levelCounts.GetValueOrDefault("Info", 0))</span>
                    <span class="chip chip-level-warning" title="Warning">WARN @(_levelCounts.GetValueOrDefault("Warning", 0))</span>
                    <span class="chip chip-level-error" title="Error">ERR @(_levelCounts.GetValueOrDefault("Error", 0))</span>
                </div>
            </div>
        </div>
    </section>

    @* ── 기간 / 필터 ── *@
    <section class="card user-tags-panel">
        <div class="user-tags-panel-header">
            <div>
                <h6 class="typo-h6">기간 및 필터</h6>
                <div class="typo-caption user-tags-muted">
                    현재 기간: @_periodStartLocal.ToString("yyyy-MM-dd HH:mm") ~ @_periodEndLocal.ToString("yyyy-MM-dd HH:mm")
                    (버킷: @BucketLabel(_granularity))
                </div>
            </div>
            <div class="user-tags-alert-controls">
                <button class="btn btn-sm @(_periodPreset == "today" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPreset("today"))">오늘</button>
                <button class="btn btn-sm @(_periodPreset == "7d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPreset("7d"))">지난 7일</button>
                <button class="btn btn-sm @(_periodPreset == "30d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPreset("30d"))">지난 30일</button>
                <button class="btn btn-sm @(_periodPreset == "60d" ? "btn-primary" : "btn-outlined")" @onclick="@(() => SetPreset("60d"))">지난 60일</button>
            </div>
        </div>

        <div class="user-tags-filter-row">
            <input class="form-field" @bind="_searchText" @bind:event="oninput" placeholder="이름 / 주소 검색..." />
            <select class="form-field" @bind="_levelFilter">
                <option value="">전체 레벨</option>
                <option value="Info">Info</option>
                <option value="Warning">Warning</option>
                <option value="Error">Error</option>
            </select>
            <select class="form-field" @bind="_systemFilter">
                <option value="">전체 System</option>
                @foreach (var s in _systemOptions)
                {
                    <option value="@s">@s</option>
                }
            </select>
            <button class="btn btn-outlined" @onclick="ApplyFiltersAsync">조회</button>
            <button class="btn btn-outlined" @onclick="ExportCsvAsync" disabled="@(_dataPage.Count == 0)">CSV 내보내기</button>
        </div>
    </section>

    @* ── KPI 카드 ── *@
    <section class="card user-tags-panel">
        <div class="ut-kpi-row">
            <div class="ut-kpi">
                <div class="ut-kpi-label">총 알림</div>
                <div class="ut-kpi-value">@_totalCount.ToString("N0")</div>
            </div>
            <div class="ut-kpi">
                <div class="ut-kpi-label">Error</div>
                <div class="ut-kpi-value ut-kpi-error">@_levelCounts.GetValueOrDefault("Error", 0).ToString("N0")</div>
            </div>
            <div class="ut-kpi">
                <div class="ut-kpi-label">Warning</div>
                <div class="ut-kpi-value ut-kpi-warn">@_levelCounts.GetValueOrDefault("Warning", 0).ToString("N0")</div>
            </div>
            <div class="ut-kpi">
                <div class="ut-kpi-label">가장 빈번한 태그</div>
                <div class="ut-kpi-value-small">
                    @if (_topRows.Count > 0)
                    {
                        @($"{_topRows[0].Name} ({_topRows[0].Count:N0})")
                    }
                    else
                    {
                        <span class="user-tags-muted">-</span>
                    }
                </div>
            </div>
        </div>
    </section>

    @* ── 차트 영역 ── *@
    <section class="card user-tags-panel">
        <div class="user-tags-panel-header">
            <div>
                <h6 class="typo-h6">시계열 추이</h6>
                <div class="typo-caption user-tags-muted">레벨별 스택 막대 (Error: 빨강 / Warn: 주황 / Info: 파랑)</div>
            </div>
        </div>
        <div class="ut-chart-tall">
            <canvas id="ut-trend-chart"></canvas>
        </div>
    </section>

    <div class="ut-chart-row">
        <section class="card user-tags-panel ut-chart-half">
            <h6 class="typo-h6">태그별 Top 10</h6>
            <div class="ut-chart-md">
                <canvas id="ut-top-chart"></canvas>
            </div>
        </section>
        <section class="card user-tags-panel ut-chart-half">
            <h6 class="typo-h6">레벨 비율</h6>
            <div class="ut-chart-md">
                <canvas id="ut-level-doughnut"></canvas>
            </div>
        </section>
    </div>

    @* ── 데이터 테이블 (DB query) ── *@
    <section class="card user-tags-panel">
        <div class="user-tags-panel-header">
            <div>
                <h6 class="typo-h6">알림 이력 (@_totalCount.ToString("N0") 건, 페이지 @(_page + 1) / @MaxPage)</h6>
                <div class="typo-caption user-tags-muted">최신순. 페이지당 @PageSize 건.</div>
            </div>
            <div class="user-tags-alert-controls">
                <button class="btn btn-sm btn-outlined" @onclick="PrevPageAsync" disabled="@(_page == 0)">이전</button>
                <button class="btn btn-sm btn-outlined" @onclick="NextPageAsync" disabled="@(_page + 1 >= MaxPage)">다음</button>
            </div>
        </div>

        @if (_dataPage.Count == 0)
        {
            <div class="ut-empty">
                <span class="material-icons">notifications_none</span>
                <p>조회 기간 / 필터에 해당하는 알림이 없습니다.</p>
            </div>
        }
        else
        {
            <div class="ut-table-wrapper">
                <table class="ut-table">
                    <thead>
                        <tr>
                            <th style="width: 170px;">시각</th>
                            <th>레벨</th>
                            <th>System</th>
                            <th>이름</th>
                            <th>주소</th>
                            <th>조건</th>
                            <th>값</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _dataPage)
                        {
                            <tr class="@LevelRowClass(a.LogLevel)">
                                <td><span class="ut-time">@a.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></td>
                                <td><span class="chip @LevelChipClass(a.LogLevel)">@a.LogLevel</span></td>
                                <td>@a.SystemName</td>
                                <td><strong>@a.Name</strong></td>
                                <td><code>@a.TagAddress</code></td>
                                <td><span class="user-tags-muted">@DescribeOp(a.MatchOp, a.MatchValue)</span></td>
                                <td><code>@a.ActualValue</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ── 정의 목록 ── *@
    @if (!ProjectService.IsLoaded)
    {
        <section class="card user-tags-panel user-tags-empty">
            <span class="material-icons">info</span>
            <div class="typo-h6 mt-2">프로젝트가 로드되지 않았습니다.</div>
            <div class="typo-body2 mt-1">AASX 파일을 인식하면 자동으로 UserTag 정의가 표시됩니다.</div>
        </section>
    }
    else if (_definitions.Count == 0)
    {
        <section class="card user-tags-panel user-tags-empty">
            <span class="material-icons">info</span>
            <div class="typo-h6 mt-2">정의된 UserTag 가 없습니다.</div>
            <div class="typo-body2 mt-1">Promaker 의 사용자 태그 패널에서 추가하세요.</div>
        </section>
    }
    else
    {
        <section class="card user-tags-panel">
            <div class="user-tags-panel-header user-tags-section-toggle" @onclick="ToggleDefinitions">
                <div>
                    <h6 class="typo-h6">정의된 UserTag (@_definitions.Count)</h6>
                    <div class="typo-caption user-tags-muted">AASX 의 System 정의를 기반으로 모니터링되는 태그</div>
                </div>
                <span class="material-icons" style="font-size:22px;">
                    @(_showDefinitions ? "expand_more" : "chevron_right")
                </span>
            </div>
            @if (_showDefinitions)
            {
                <div class="ut-table-wrapper">
                    <table class="ut-table">
                        <thead>
                            <tr>
                                <th>System</th>
                                <th>이름</th>
                                <th>레벨</th>
                                <th>주소</th>
                                <th>타입</th>
                                <th>매칭 조건</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _definitions)
                            {
                                <tr>
                                    <td>@d.SystemName</td>
                                    <td><strong>@d.Name</strong></td>
                                    <td><span class="chip @LevelChipClass(d.LogLevel)">@d.LogLevel</span></td>
                                    <td><code>@d.TagAddress</code></td>
                                    <td>@d.ValueType</td>
                                    <td>@DescribeOp(d.MatchOp, d.MatchValue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private const int PageSize = 100;

    private IReadOnlyList<UserTagDefinition> _definitions = Array.Empty<UserTagDefinition>();
    private IReadOnlyList<UserTagAlertRecord> _dataPage = Array.Empty<UserTagAlertRecord>();
    private IReadOnlyList<UserTagAlertBucket> _buckets = Array.Empty<UserTagAlertBucket>();
    private IReadOnlyList<UserTagAlertTopRow> _topRows = Array.Empty<UserTagAlertTopRow>();
    private IReadOnlyDictionary<string, int> _levelCounts = new Dictionary<string, int>();
    private int _totalCount;
    private int _page;
    private bool _showDefinitions = true;

    // 기간 / 필터 상태
    private string _periodPreset = "7d";
    private DateTime _periodStartLocal = DateTime.Now.AddDays(-7);
    private DateTime _periodEndLocal = DateTime.Now;
    private string _granularity = "day";
    private string _searchText = string.Empty;
    private string _levelFilter = string.Empty;
    private string _systemFilter = string.Empty;
    private List<string> _systemOptions = new();

    private IJSObjectReference? _chartModule;
    private CancellationTokenSource? _refreshCts;

    private int MaxPage => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        _definitions = AlertService.GetDefinitions();
        _systemOptions = _definitions.Select(d => d.SystemName).Distinct().OrderBy(s => s).ToList();
        SetPresetState("7d");
        AlertService.AlertsChanged += OnAlertsChanged;
        await LoadFromDbAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chartModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/user-tag-trend-chart.js");
        }
        await DrawChartsAsync();
    }

    private async Task DrawChartsAsync()
    {
        if (_chartModule is null) return;
        try
        {
            var bucketsJs = _buckets.Select(b => new
            {
                bucketStartIso = b.BucketStart.ToLocalTime().ToString("o"),
                level = b.LogLevel,
                count = b.Count,
            }).ToArray();
            await _chartModule.InvokeVoidAsync("renderTrendChart", "ut-trend-chart", bucketsJs, _granularity);

            var topJs = _topRows.Take(10).Select(t => new { name = t.Name, level = t.LogLevel, count = t.Count }).ToArray();
            await _chartModule.InvokeVoidAsync("renderTopChart", "ut-top-chart", topJs);

            await _chartModule.InvokeVoidAsync("renderLevelDoughnut", "ut-level-doughnut", _levelCounts);
        }
        catch (Exception)
        {
            // 페이지 전환 직후 canvas 가 사라진 경우 등 — 무시
        }
    }

    private void OnAlertsChanged()
    {
        // Background thread → UI dispatcher. 너무 잦은 재조회는 부담이라
        // 알림이 새로 들어오면 한 번만 LoadFromDbAsync 호출.
        _ = InvokeAsync(async () =>
        {
            await LoadFromDbAsync();
            StateHasChanged();
            await DrawChartsAsync();
        });
    }

    private async Task LoadFromDbAsync()
    {
        _refreshCts?.Cancel();
        _refreshCts = new CancellationTokenSource();
        var ct = _refreshCts.Token;
        try
        {
            var startUtc = _periodStartLocal.ToUniversalTime();
            var endUtc = _periodEndLocal.ToUniversalTime();
            var name = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
            var level = string.IsNullOrWhiteSpace(_levelFilter) ? null : _levelFilter;
            var sys = string.IsNullOrWhiteSpace(_systemFilter) ? null : _systemFilter;

            _totalCount = await AlertRepo.CountAlertsAsync(startUtc, endUtc, name, level, sys, ct);
            if (_page * PageSize >= _totalCount) _page = 0;
            _dataPage = await AlertRepo.QueryAlertsAsync(startUtc, endUtc, name, level, sys, PageSize, _page * PageSize, ct);
            _buckets = await AlertRepo.GetBucketCountsAsync(startUtc, endUtc, _granularity, name, level, sys, ct);
            _topRows = await AlertRepo.GetTopByNameAsync(startUtc, endUtc, 10, level, sys, ct);
            _levelCounts = await AlertRepo.GetLevelCountsAsync(startUtc, endUtc, name, sys, ct);
        }
        catch (OperationCanceledException)
        {
            // skip
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 0;
        await LoadFromDbAsync();
    }

    private void SetPresetState(string preset)
    {
        _periodPreset = preset;
        var now = DateTime.Now;
        switch (preset)
        {
            case "today":
                _periodStartLocal = now.Date;
                _periodEndLocal = now;
                _granularity = "hour";
                break;
            case "7d":
                _periodStartLocal = now.Date.AddDays(-6);
                _periodEndLocal = now;
                _granularity = "day";
                break;
            case "30d":
                _periodStartLocal = now.Date.AddDays(-29);
                _periodEndLocal = now;
                _granularity = "day";
                break;
            case "60d":
                _periodStartLocal = now.Date.AddDays(-59);
                _periodEndLocal = now;
                _granularity = "week";
                break;
        }
        _page = 0;
    }

    private async Task SetPreset(string preset)
    {
        SetPresetState(preset);
        await LoadFromDbAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_page == 0) return;
        _page--;
        await LoadFromDbAsync();
    }

    private async Task NextPageAsync()
    {
        if ((_page + 1) >= MaxPage) return;
        _page++;
        await LoadFromDbAsync();
    }

    private async Task ExportCsvAsync()
    {
        if (_chartModule is null) return;
        // 현재 필터의 전체 결과를 export (큰 데이터 가능 → 한 번에 가져옴)
        var startUtc = _periodStartLocal.ToUniversalTime();
        var endUtc = _periodEndLocal.ToUniversalTime();
        var name = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
        var level = string.IsNullOrWhiteSpace(_levelFilter) ? null : _levelFilter;
        var sys = string.IsNullOrWhiteSpace(_systemFilter) ? null : _systemFilter;

        var all = await AlertRepo.QueryAlertsAsync(startUtc, endUtc, name, level, sys, 100000, 0);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Timestamp,LogLevel,System,Name,TagAddress,ValueType,MatchOp,MatchValue,ActualValue");
        foreach (var a in all)
        {
            sb.AppendLine(string.Join(",",
                CsvEscape(a.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")),
                CsvEscape(a.LogLevel),
                CsvEscape(a.SystemName),
                CsvEscape(a.Name),
                CsvEscape(a.TagAddress),
                CsvEscape(a.ValueType),
                CsvEscape(a.MatchOp),
                CsvEscape(a.MatchValue ?? string.Empty),
                CsvEscape(a.ActualValue)));
        }

        var fileName = $"UserTagAlerts_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await _chartModule.InvokeVoidAsync("downloadCsv", fileName, sb.ToString());
    }

    private void ToggleDefinitions() => _showDefinitions = !_showDefinitions;

    private static string CsvEscape(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    private static string DescribeOp(string op, string? matchValue)
    {
        var mv = string.IsNullOrWhiteSpace(matchValue) ? "?" : matchValue;
        return op switch
        {
            "RisingEdge"  => "0 → 1",
            "FallingEdge" => "1 → 0",
            "Changed"     => "값 변경",
            "Eq"          => $"= {mv}",
            "Neq"         => $"≠ {mv}",
            "Gt"          => $"> {mv}",
            "Gte"         => $"≥ {mv}",
            "Lt"          => $"< {mv}",
            "Lte"         => $"≤ {mv}",
            _             => op ?? "?",
        };
    }

    private static string BucketLabel(string g) => g switch
    {
        "hour"  => "1시간",
        "day"   => "1일",
        "week"  => "1주",
        "month" => "1개월",
        _       => g,
    };

    private static string LevelChipClass(string? level) => level switch
    {
        "Error" => "chip-level-error",
        "Warning" => "chip-level-warning",
        _ => "chip-level-info",
    };

    private static string LevelRowClass(string? level) => level switch
    {
        "Error" => "ut-row-error",
        "Warning" => "ut-row-warning",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        AlertService.AlertsChanged -= OnAlertsChanged;
        _refreshCts?.Cancel();
        if (_chartModule is not null)
        {
            try { await _chartModule.DisposeAsync(); } catch { }
        }
    }
}
