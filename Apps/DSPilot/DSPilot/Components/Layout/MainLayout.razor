@inherits LayoutComponentBase
@implements IDisposable
@using DSPilot.Services
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject IJSRuntime JS

@* Swiss Technical 셸 — 정적 /app/*.html(shell.js)과 동일한 사이드바 + 슬림 앱바.
   남은 Blazor 페이지(/flow·/editor·/pw)에 적용. 구 헤더(로고/DEMO/상단 nav/상태 배지) 제거. *@
<div class="layout @ThemeService.GetThemeClass()">
    <header class="app-bar">
        <button class="btn-icon" @onclick="ToggleDrawer" title="메뉴">
            <span class="material-icons">menu</span>
        </button>
        <a class="dsp-brand" href="/" title="DSPilot">
            <img src="/images/logo.png" alt="DSPilot" />
        </a>
        <span class="header-page-title">@GetPageTitle()</span>
        <div class="spacer"></div>
        <button class="btn-icon" @onclick="ToggleTheme" title="테마 전환">
            <span class="material-icons">@(ThemeService.IsDarkMode ? "light_mode" : "dark_mode")</span>
        </button>
        <a class="btn-icon" href="/settings" title="설정">
            <span class="material-icons">settings</span>
        </a>
    </header>

    <aside class="drawer @(_drawerOpen ? "" : "drawer-closed")">
        <NavMenu />
    </aside>

    <main class="main-content @(_drawerOpen ? "" : "drawer-closed")">
        <PlcConnectionBanner />
        <div class="container">
            @Body
        </div>
    </main>
</div>

<div id="snackbar-container"></div>

<PromakerOfflineDialog />

@code {
    private bool _drawerOpen = true;
    private string _currentPath = "/";

    protected override void OnInitialized()
    {
        _currentPath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ThemeService.OnThemeChanged += OnThemeChanged;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dspilot-theme");
        if (saved == "dark")
        {
            ThemeService.SetDarkMode(true);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = "/" + Nav.ToBaseRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private string GetPageTitle()
    {
        var path = _currentPath.TrimEnd('/');
        return path switch
        {
            "" or "/" => "대시보드",
            "/heatmap" => "동작편차",
            "/cycle-time-analysis" => "사이클 분석",
            "/uptime" => "가동시간·이상 분석",
            "/cctv" => "CCTV",
            "/plc-debug" => "PLC 디버그",
            "/settings" => "설정",
            "/flow" => "Flow Workspace",
            "/pw" => "Power Tools",
            _ => ""
        };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await JS.InvokeVoidAsync("localStorage.setItem", "dspilot-theme", ThemeService.IsDarkMode ? "dark" : "light");
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
