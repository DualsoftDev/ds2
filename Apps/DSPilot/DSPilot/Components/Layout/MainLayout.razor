@inherits LayoutComponentBase
@implements IDisposable
@using DSPilot.Services
@inject DsProjectService ProjectService
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject DspDbService DbService
@inject UserTagAlertService AlertService
@inject DemoModeService Demo
@inject IJSRuntime JS

<div class="layout @ThemeService.GetThemeClass()">
    <header class="app-bar">
        <button class="btn-icon" @onclick="ToggleDrawer" title="메뉴">
            <span class="material-icons">menu</span>
        </button>
        <div style="display: flex; align-items: center; cursor: pointer;" @onclick="@(() => Nav.NavigateTo("/"))">
            <img src="images/logo.png" alt="DSPilot Logo" height="28" />
        </div>
        @if (!Demo.IsBypassed)
        {
            <span class="header-demo-badge" title="데모 모드 — 기동 후 @(FormatTs(DemoModeService.DemoDuration)) 사용 가능 (남은 @FormatTs(Demo.Remaining))">DEMO</span>
        }
        <span class="header-page-title">@GetPageTitle()</span>
        <div class="spacer"></div>
        <nav class="header-nav">
            <a href="" class="header-nav-link @(IsActive("/"))">대시보드</a>
            <a href="heatmap" class="header-nav-link @(IsActive("/heatmap"))">동작편차</a>
            <a href="cycle-time-analysis" class="header-nav-link @(IsActive("/cycle-time-analysis"))">사이클 분석</a>
        </nav>
        <HubStatusBadge />
        @if (!DbService.HasData)
        {
            <div class="header-loading-indicator" title="PLC 데이터 수집 중">
                <span class="material-icons">sync</span>
                <span>데이터 수집 중</span>
            </div>
        }
        <button class="header-usertag-badge level-@_topAlertLevel @(_windowTotalCount == 0 ? "is-empty" : "") @(_windowErrorCount > 0 ? "has-error-dot" : "")"
                @onclick="@(() => Nav.NavigateTo("/user-tags"))"
                title="최근 @(WindowMinutes)분 UserTag 활동: 총 @(_windowTotalCount)건 (Info @_windowInfoCount / Warn @_windowWarnCount / Err @_windowErrorCount)">
            <span class="material-icons header-usertag-icon">monitoring</span>
            <svg class="header-usertag-spark" viewBox="0 0 60 16" preserveAspectRatio="none" aria-hidden="true">
                <polyline points="@_sparkPath" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <span class="header-usertag-breakdown">
                <span class="header-usertag-chip is-info @(_windowInfoCount == 0 ? "is-zero" : "")" title="Info">
                    <span class="header-usertag-dot"></span>@FormatCount(_windowInfoCount)
                </span>
                <span class="header-usertag-chip is-warning @(_windowWarnCount == 0 ? "is-zero" : "")" title="Warning">
                    <span class="header-usertag-dot"></span>@FormatCount(_windowWarnCount)
                </span>
                <span class="header-usertag-chip is-error @(_windowErrorCount == 0 ? "is-zero" : "")" title="Error">
                    <span class="header-usertag-dot"></span>@FormatCount(_windowErrorCount)
                </span>
            </span>
        </button>
        <button class="btn-icon" @onclick="ToggleTheme" title="테마 전환">
            <span class="material-icons">@(ThemeService.IsDarkMode ? "light_mode" : "dark_mode")</span>
        </button>
        <button class="btn-icon" @onclick="@(() => Nav.NavigateTo("/settings"))" title="설정">
            <span class="material-icons">settings</span>
        </button>
    </header>

    <aside class="drawer @(_drawerOpen ? "" : "drawer-closed")">
        <NavMenu />
    </aside>

    <main class="main-content @(_drawerOpen ? "" : "drawer-closed")">
        <PlcConnectionBanner />
        <div class="container">
            @if (Demo.IsBlocked && !IsOnPwPage)
            {
                <div class="demo-blocked-overlay">
                    <div class="demo-blocked-card">
                        <span class="material-icons demo-blocked-icon">lock_clock</span>
                        <h3>DEMO 만료</h3>
                        <p>데모 사용 시간(@FormatTs(DemoModeService.DemoDuration))이 종료되었습니다.</p>
                        <p>서비스 관리자에게 문의해 주세요.</p>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>
</div>

<div id="snackbar-container"></div>

<PromakerOfflineDialog />

@code {
    private bool _drawerOpen = false;

    private string _projectName = "DSPilot";
    private string _currentPath = "/";

    private const int WindowMinutes = 60;
    private const int SparkBuckets = 12;
    private static readonly TimeSpan WindowRefreshInterval = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan DemoTickInterval = TimeSpan.FromSeconds(30);
    private System.Threading.Timer? _demoTickTimer;

    private bool IsOnPwPage =>
        _currentPath.Equals("/pw", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("/pw/", StringComparison.OrdinalIgnoreCase);

    private int _windowInfoCount;
    private int _windowWarnCount;
    private int _windowErrorCount;
    private int _windowTotalCount;
    private string _topAlertLevel = "none";
    private string _sparkPath = "0,15 60,15";
    private System.Threading.Timer? _windowRefreshTimer;

    protected override void OnInitialized()
    {
        var project = ProjectService.GetProject();
        if (project != null)
            _projectName = project.Name;

        _currentPath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;

        RefreshAlertCounts();
        AlertService.AlertsChanged += OnAlertsChanged;

        // 윈도우는 시간에 따라 미끄러지므로, 신규 알림 이벤트와 별개로 주기적 재계산이 필요.
        _windowRefreshTimer = new System.Threading.Timer(
            _ => InvokeAsync(() => { RefreshAlertCounts(); StateHasChanged(); }),
            null, WindowRefreshInterval, WindowRefreshInterval);

        // 데모 모드 만료 시점에 자동으로 차단 오버레이가 떠야 하므로 주기적 재렌더링이 필요.
        Demo.StateChanged += OnDemoStateChanged;
        _demoTickTimer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null, DemoTickInterval, DemoTickInterval);
    }

    private void OnDemoStateChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ThemeService.OnThemeChanged += OnThemeChanged;
        DbService.OnDataChanged += OnDbDataChanged;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dspilot-theme");
        if (saved == "dark")
        {
            ThemeService.SetDarkMode(true);
        }
    }

    private void OnAlertsChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshAlertCounts();
            StateHasChanged();
        });
    }

    private void RefreshAlertCounts()
    {
        // PlcTagLog.DateTime 가 DateTime.Now (Local) 로 기록되므로 비교도 Local 기준.
        var now = DateTime.Now;
        var windowStart = now.AddMinutes(-WindowMinutes);
        var bucketMinutes = (double)WindowMinutes / SparkBuckets;
        var buckets = new int[SparkBuckets];

        int info = 0, warn = 0, err = 0;
        foreach (var a in AlertService.GetAlerts())
        {
            if (a.Timestamp < windowStart) continue;
            switch (a.LogLevel)
            {
                case "Error": err++; break;
                case "Warning": warn++; break;
                default: info++; break;
            }
            var idx = (int)((a.Timestamp - windowStart).TotalMinutes / bucketMinutes);
            if (idx < 0) idx = 0;
            else if (idx >= SparkBuckets) idx = SparkBuckets - 1;
            buckets[idx]++;
        }
        _windowInfoCount = info;
        _windowWarnCount = warn;
        _windowErrorCount = err;
        _windowTotalCount = info + warn + err;
        _topAlertLevel = err > 0 ? "error" : warn > 0 ? "warning" : info > 0 ? "info" : "none";
        _sparkPath = BuildSparkPath(buckets);
    }

    private static string FormatCount(int n) => n > 99 ? "99+" : n.ToString();

    private static string BuildSparkPath(int[] buckets)
    {
        const double width = 60;
        const double height = 16;
        const double padY = 1.5;
        int max = 0;
        foreach (var v in buckets) if (v > max) max = v;
        var step = buckets.Length > 1 ? width / (buckets.Length - 1) : 0;
        var sb = new System.Text.StringBuilder(buckets.Length * 10);
        for (int i = 0; i < buckets.Length; i++)
        {
            double x = i * step;
            double y = max == 0
                ? height - padY
                : padY + (1 - (double)buckets[i] / max) * (height - 2 * padY);
            if (i > 0) sb.Append(' ');
            sb.Append(x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }

    private void OnDbDataChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = "/" + Nav.ToBaseRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private string IsActive(string path) =>
        _currentPath.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private string GetPageTitle()
    {
        var path = _currentPath.TrimEnd('/');
        return path switch
        {
            "" or "/" => "대시보드",
            "/heatmap" => "동작편차",
            "/cycle-time-analysis" => "사이클 분석",
            "/settings" => "설정",
            "/editor" => "에디터",
            _ => ""
        };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await JS.InvokeVoidAsync("localStorage.setItem", "dspilot-theme", ThemeService.IsDarkMode ? "dark" : "light");
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private static string FormatTs(TimeSpan t)
        => $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        DbService.OnDataChanged -= OnDbDataChanged;
        AlertService.AlertsChanged -= OnAlertsChanged;
        Demo.StateChanged -= OnDemoStateChanged;
        _windowRefreshTimer?.Dispose();
        _demoTickTimer?.Dispose();
    }
}
