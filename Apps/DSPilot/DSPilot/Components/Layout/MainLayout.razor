@inherits LayoutComponentBase
@implements IDisposable
@using DSPilot.Services
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject DemoModeService Demo
@inject IJSRuntime JS

@* Swiss Technical 셸 — 정적 /app/*.html(shell.js)과 동일한 사이드바 + 슬림 앱바.
   남은 Blazor 페이지(/flow·/editor·/pw)에 적용. 구 헤더(로고/DEMO/상단 nav/상태 배지) 제거. *@
<div class="layout @ThemeService.GetThemeClass()">
    <header class="app-bar">
        <button class="btn-icon" @onclick="ToggleDrawer" title="메뉴">
            <span class="material-icons">menu</span>
        </button>
        <a class="dsp-brand" href="/" title="DSPilot">
            <span class="dsp-brand-mark"></span>
            <span class="dsp-brand-word">DS<b>Pilot</b></span>
        </a>
        <span class="header-page-title">@GetPageTitle()</span>
        <div class="spacer"></div>
        <button class="btn-icon" @onclick="ToggleTheme" title="테마 전환">
            <span class="material-icons">@(ThemeService.IsDarkMode ? "light_mode" : "dark_mode")</span>
        </button>
        <a class="btn-icon" href="/settings" title="설정">
            <span class="material-icons">settings</span>
        </a>
    </header>

    <aside class="drawer @(_drawerOpen ? "" : "drawer-closed")">
        <NavMenu />
    </aside>

    <main class="main-content @(_drawerOpen ? "" : "drawer-closed")">
        <PlcConnectionBanner />
        <div class="container">
            @if (Demo.IsBlocked && !IsOnPwPage)
            {
                <div class="demo-blocked-overlay">
                    <div class="demo-blocked-card">
                        <span class="material-icons demo-blocked-icon">lock_clock</span>
                        <h3>DEMO 만료</h3>
                        <p>데모 사용 시간(@FormatTs(DemoModeService.DemoDuration))이 종료되었습니다.</p>
                        <p>서비스 관리자에게 문의해 주세요.</p>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>
</div>

<div id="snackbar-container"></div>

<PromakerOfflineDialog />

@code {
    private bool _drawerOpen = true;
    private string _currentPath = "/";

    private static readonly TimeSpan DemoTickInterval = TimeSpan.FromSeconds(30);
    private System.Threading.Timer? _demoTickTimer;

    private bool IsOnPwPage =>
        _currentPath.Equals("/pw", StringComparison.OrdinalIgnoreCase)
        || _currentPath.StartsWith("/pw/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _currentPath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;

        // 데모 모드 만료 시점에 자동으로 차단 오버레이가 떠야 하므로 주기적 재렌더링.
        Demo.StateChanged += OnDemoStateChanged;
        _demoTickTimer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, DemoTickInterval, DemoTickInterval);
    }

    private void OnDemoStateChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ThemeService.OnThemeChanged += OnThemeChanged;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dspilot-theme");
        if (saved == "dark")
        {
            ThemeService.SetDarkMode(true);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = "/" + Nav.ToBaseRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private string GetPageTitle()
    {
        var path = _currentPath.TrimEnd('/');
        return path switch
        {
            "" or "/" => "대시보드",
            "/heatmap" => "동작편차",
            "/cycle-time-analysis" => "사이클 분석",
            "/call-test" => "Call 사이클",
            "/user-tags" => "이상발생 관리",
            "/cctv" => "CCTV",
            "/plc-debug" => "PLC 디버그",
            "/settings" => "설정",
            "/editor" => "에디터",
            "/flow" => "Flow Workspace",
            "/pw" => "Power Tools",
            _ => ""
        };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await JS.InvokeVoidAsync("localStorage.setItem", "dspilot-theme", ThemeService.IsDarkMode ? "dark" : "light");
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private static string FormatTs(TimeSpan t)
        => $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        Demo.StateChanged -= OnDemoStateChanged;
        _demoTickTimer?.Dispose();
    }
}
