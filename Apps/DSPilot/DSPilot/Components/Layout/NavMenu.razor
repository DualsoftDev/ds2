@implements IDisposable
@inject DsProjectService ProjectService
@inject NavigationManager Nav
@inject AppSettingsService AppSettings
@inject DspDbService Db
@inject HubSubscriberService Hub
@inject PlcConnectionStatusTracker PlcStatus
@inject DSPilot.Repositories.IUserTagAlertRepository AlertRepo
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.SignalR.Client

@* Swiss 사이드바 — 정적 shell.js 와 동일한 4-섹션 구성:
   페이지 바로가기 / 라인요약 / 시스템 / agent 통신 상태.
   주요 페이지는 정적(/route)이라 일반 a 태그(전체 페이지 이동). 라이브 값은 서비스 이벤트로 갱신. *@
<nav class="nav-menu">
    @* ── 1. 페이지 바로가기 ── *@
    <div class="nav-section-head"><span class="eyebrow">페이지 바로가기</span></div>
    <a class="nav-link @(_isHome ? "active" : "")" href="/">
        <span class="material-icons">space_dashboard</span> 대시보드
    </a>
    <a class="nav-link" href="/heatmap">
        <span class="material-icons">gradient</span> 동작편차
    </a>
    <a class="nav-link" href="/cycle-time-analysis">
        <span class="material-icons">equalizer</span> 사이클 분석
    </a>
    <a class="nav-link" href="/uptime">
        <span class="material-icons">monitor_heart</span> 가동시간·이상
        @if (_anomalyActiveCount > 0)
        {
            <span class="nav-link-badge" title="최근 10분 내 Error 알림">@_anomalyActiveCount</span>
        }
    </a>
    <a class="nav-link" href="/cctv">
        <span class="material-icons">videocam</span> CCTV
    </a>
    @if (_showPlcDebug)
    {
        <a class="nav-link" href="/plc-debug">
            <span class="material-icons">bug_report</span> PLC 디버그
        </a>
    }

    @* ── 2. 라인요약 (가동/대기 + 가동률) ── *@
    <div class="nav-section-head"><span class="eyebrow">라인요약</span></div>
    <div class="nav-section-body line-summary">
        <div class="ls-counts">
            <span class="ls-count ls-running"><span class="ls-dot"></span>가동 <b>@_running</b></span>
            <span class="ls-count ls-idle"><span class="ls-dot"></span>대기 <b>@_idle</b></span>
        </div>
        <div>
            <div class="ls-eff-row">
                <span>라인 효율</span>
                <span class="ls-eff-val">@(_lineTotal > 0 ? $"{_efficiencyPct}%" : "—")</span>
            </div>
            <div class="progress-bar">
                <div class="progress-bar-fill" style="width:@(_lineTotal > 0 ? _efficiencyPct : 0)%"></div>
            </div>
        </div>
    </div>

    @* ── 3. 시스템 (system → flow 트리) ── *@
    <div class="nav-section-head"><span class="eyebrow">시스템</span></div>
    @if (ProjectService.IsLoaded && _systemFlowMap.Count > 0)
    {
        @foreach (var systemFlows in _systemFlowMap)
        {
            <div class="nav-sys">
                <img src="images/aas.png" alt="AAS" />
                <span class="nav-sys-name">@systemFlows.Key</span>
            </div>
            <div class="nav-flows">
                @{ var flowList = systemFlows.Value; }
                @for (int i = 0; i < flowList.Count; i++)
                {
                    var idx = i;
                    var flow = flowList[idx];
                    var isLast = idx == flowList.Count - 1;
                    var isSelected = _selectedFlow == flow.Name;
                    <button type="button"
                            class="nav-flow @(isSelected ? "is-selected" : "") @(isLast ? "is-last" : "")"
                            @onclick="@(() => NavigateToFlow(flow.Name))">
                        <span class="nav-flow-line-v"></span>
                        <span class="nav-flow-line-h"></span>
                        <span class="nav-flow-name">@flow.Name</span>
                    </button>
                }
            </div>
        }
    }
    else
    {
        <div class="nav-section-empty">프로젝트 미로드</div>
    }

    @* ── 4. 설정 ── *@
    <div class="nav-section-head"><span class="eyebrow">설정</span></div>
    <a class="nav-link" href="/settings">
        <span class="material-icons">settings</span> 설정
    </a>

    @* ── 5. agent 통신 상태 (Hub + PLC) ── *@
    <div class="nav-section-head"><span class="eyebrow">agent 통신 상태</span></div>
    <div class="nav-section-body agent-status">
        <div class="ag-row is-@_hubLevel" title="@_hubTooltip">
            <span class="ag-dot ag-@_hubLevel"></span>
            <span class="ag-label">Promaker Hub</span>
            <span class="ag-state">@_hubLabel</span>
        </div>
        <div class="ag-row is-@_plcLevel" title="@_plcTooltip">
            <span class="ag-dot ag-@_plcLevel"></span>
            <span class="ag-label">PLC 어댑터</span>
            <span class="ag-state">@_plcLabel</span>
        </div>
    </div>

    @* ── 마지막 갱신 ── *@
    <div class="nav-updated">
        <span class="nav-updated-dot @(_hubLevel == "down" ? "is-stale" : "")"></span>
        마지막 갱신 <b>@_lastUpdate.ToString("HH:mm:ss")</b>
    </div>
</nav>

@code {
    private Dictionary<string, List<Ds2.Core.Flow>> _systemFlowMap = new();
    private string? _selectedFlow;
    private bool _isHome;
    private bool _showPlcDebug = true;

    // 라인요약
    private int _lineTotal;
    private int _running;
    private int _idle;
    private int _efficiencyPct;

    // agent 통신 상태
    private string _hubLevel = "pending";
    private string _hubLabel = "연결 중";
    private string _hubTooltip = "";
    private string _plcLevel = "muted";
    private string _plcLabel = "—";
    private string _plcTooltip = "";

    // 이상발생 활성 건수 (최근 10분 Error) — push 이벤트가 없어 주기 폴링.
    private int _anomalyActiveCount;
    private System.Threading.Timer? _anomalyTimer;
    private static readonly TimeSpan AnomalyInterval = TimeSpan.FromSeconds(12);

    private DateTime _lastUpdate = DateTime.Now;

    protected override void OnInitialized()
    {
        UpdateLocationState(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        _showPlcDebug = AppSettings.LoadSettings().Ui.ShowPlcDebug;

        if (ProjectService.IsLoaded)
        {
            foreach (var system in ProjectService.GetActiveSystems())
            {
                var flows = ProjectService.GetFlows(system.Id);
                if (flows.Count > 0)
                {
                    _systemFlowMap[system.Name] = flows;
                }
            }
        }

        // 라이브 데이터 초기 계산 + 구독
        RecomputeLines();
        RecomputeAgent();
        _lastUpdate = DateTime.Now;

        Db.OnDataChanged += OnDbChanged;
        Hub.StatusChanged += OnHubChanged;
        PlcStatus.StatusChanged += OnPlcChanged;

        // 이상발생 건수 폴링 (즉시 1회 + 12초 주기). 실패해도 사이드바엔 영향 없음.
        _anomalyTimer = new System.Threading.Timer(
            _state => { _ = RefreshAnomalyAsync(); }, null, TimeSpan.Zero, AnomalyInterval);
    }

    private void OnDbChanged()
    {
        if (RecomputeLines())
        {
            _lastUpdate = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnHubChanged(HubConnectionState _)
    {
        RecomputeAgent();
        _lastUpdate = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private void OnPlcChanged()
    {
        RecomputeAgent();
        _lastUpdate = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>스냅샷에서 가동/대기/가동률 재계산. 값이 바뀐 경우에만 true(렌더 트리거).</summary>
    private bool RecomputeLines()
    {
        var flows = Db.Snapshot.Flows;
        var total = flows.Count;
        var running = flows.Count(f => f.State == "Going");
        var idle = total - running;
        var eff = total > 0 ? (int)Math.Round(running * 100.0 / total) : 0;

        if (total == _lineTotal && running == _running && idle == _idle && eff == _efficiencyPct)
            return false;

        _lineTotal = total;
        _running = running;
        _idle = idle;
        _efficiencyPct = eff;
        return true;
    }

    /// <summary>Hub 연결 상태 + PLC 어댑터 연결을 통합해 두 행(Hub/PLC)의 표시 상태를 갱신.</summary>
    private void RecomputeAgent()
    {
        var hub = Hub.CurrentStatus;
        (_hubLevel, _hubLabel, _hubTooltip) = hub switch
        {
            HubConnectionState.Connected => ("ok", "정상", "Promaker 모니터링 허브 연결됨"),
            HubConnectionState.Connecting => ("pending", "연결 중", "Promaker 허브 연결 시도 중"),
            HubConnectionState.Reconnecting => ("pending", "재연결 중", "Promaker 허브 재연결 중"),
            _ => ("down", "끊김", "Promaker 5051 모니터링 허브 연결 없음 — Promaker 실행/모니터링 확인"),
        };

        var statuses = PlcStatus.CurrentStatuses;
        var plcTotal = statuses.Count;
        var plcDown = statuses.Count(s => !s.IsConnected);

        if (hub != HubConnectionState.Connected)
        {
            // 허브가 끊기면 PLC 상태 캐시가 비워져 알 수 없음.
            _plcLevel = "muted";
            _plcLabel = "—";
            _plcTooltip = "허브 연결 후 PLC 상태가 표시됩니다";
        }
        else if (plcTotal == 0)
        {
            _plcLevel = "muted";
            _plcLabel = "보고 없음";
            _plcTooltip = "보고된 PLC 어댑터가 없습니다";
        }
        else if (plcDown > 0)
        {
            _plcLevel = "down";
            _plcLabel = $"{plcDown}대 끊김";
            _plcTooltip = string.Join("\n", statuses.Where(s => !s.IsConnected)
                .Select(s => $"{s.Name} ({s.Vendor} {s.IpAddress}:{s.Port}) — {s.LastError}"));
        }
        else
        {
            _plcLevel = "ok";
            _plcLabel = $"{plcTotal}대 연결";
            _plcTooltip = string.Join("\n", statuses.Select(s => $"{s.Name} ({s.IpAddress}:{s.Port})"));
        }
    }

    private async Task RefreshAnomalyAsync()
    {
        try
        {
            var now = DateTime.UtcNow;
            var count = await AlertRepo.CountAlertsAsync(
                now - TimeSpan.FromMinutes(10), now, null, "Error", null);
            if (count != _anomalyActiveCount)
            {
                _anomalyActiveCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // 사이드바 안정성 우선 — 카운트 조회 실패는 무시.
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateLocationState(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void NavigateToFlow(string flowName)
    {
        _selectedFlow = flowName;
        Nav.NavigateTo($"/flow?name={Uri.EscapeDataString(flowName)}");
    }

    private void UpdateLocationState(string location)
    {
        var absoluteUri = Nav.ToAbsoluteUri(location);
        var relativePath = Nav.ToBaseRelativePath(absoluteUri.ToString());
        _isHome = relativePath is "" or "/";

        if (relativePath.Equals("flow", StringComparison.OrdinalIgnoreCase))
        {
            var query = QueryHelpers.ParseQuery(absoluteUri.Query);
            _selectedFlow = query.TryGetValue("name", out var flowName)
                ? flowName.ToString()
                : null;
            return;
        }

        _selectedFlow = null;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Db.OnDataChanged -= OnDbChanged;
        Hub.StatusChanged -= OnHubChanged;
        PlcStatus.StatusChanged -= OnPlcChanged;
        _anomalyTimer?.Dispose();
    }
}
