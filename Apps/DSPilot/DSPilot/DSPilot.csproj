<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1.38</Version>
    <ApplicationIcon>DSPilot.ico</ApplicationIcon>
    <NoWarn>MSB3277</NoWarn>
    <!-- Tailwind(stitch) 빌드 의존성: node_modules 를 SDK 기본 glob(**/*.json 등)에서 제외.
         빌드 산출물 wwwroot/css/stitch*.css 는 정상 포함(wwwroot). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- 일일 브리핑 메일링(EmailBriefingService) — SMTP 발송. System.Net.Mail.SmtpClient 는 MS 비권장이라 MailKit 채택. -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- direct-to-MX 발송 모드용 MX 레코드 조회(.NET 내장 MX 질의 없음). 릴레이 모드는 미사용. -->
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- CCTV 스냅샷 오버레이 합성 (CctvOverlayRenderer). System.Drawing 은 Windows 전용이라 배제(bLinux). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <!-- 서비스 호스팅: Windows(서비스)·Linux(systemd) 양쪽 라이프사이클 통합. 둘 다 해당 OS 에서만 활성. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\solutions\Core\Ds2.Core\Ds2.Core.fsproj" />
    <ProjectReference Include="..\..\..\solutions\Core\Ds2.Editor\Ds2.Editor.fsproj" />
    <ProjectReference Include="..\..\..\solutions\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <ProjectReference Include="..\..\..\solutions\Backend\Ds2.Backend.Common\Ds2.Backend.Common.fsproj" />
    <ProjectReference Include="..\..\..\solutions\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings는 프로그램이 시작 시 자동 생성하므로 publish에서 제외 -->
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- dsp.conf(정본 시크릿) 은 dev 로컬 실행용으로만 프로젝트폴더에 존재. 배포 산출물(bin/publish/tarball)에는
         절대 포함하지 않는다 — 설치본/설치 스크립트가 설치 시점에 배치하고 600/ACL 로 잠근다.
         (dev 실행은 content root=프로젝트폴더에서 직접 읽으므로 output 복사 불필요.) -->
    <None Update="dsp.conf" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="dsp.conf" />
  </ItemGroup>

  <!--
    Secrets 관리 — dsp.conf(gitignore, 실제 값) 이 없을 때의 개발자 안내/자동복사.
    정본(canonical)은 사내 private cloudworks repo 의 deploy/dsp.conf (appsettings.Secrets.sample.json 참조).
    파일명 dsp.conf 는 표적성 낮추려 의도적으로 무해하게(pv.conf 관례) — 런타임이 그대로 읽는 이름(Program.cs).
    내용은 appsettings.Secrets.json 과 동일 JSON. dev 로컬 실행은 content root(=프로젝트폴더)에서 직접 읽는다.
    동작:
      1) 환경변수 DUALSOFT_SECRETS_DIR 의 정본이 있으면 → 프로젝트폴더\dsp.conf 로 자동 복사(무마찰).
      2) 여전히 없고 RequireSecrets=true(옵트인) → 빌드 error.
      3) 그 외 없으면 → 빌드 warning(복사 안내). 기본값 — Ds2.sln/CI·타 앱 빌드는 안 깨진다.
    하드 차단: dotnet build -p:RequireSecrets=true
    ★ dsp.conf 는 아래 ItemGroup 에서 publish/output 산출물에 포함하지 않는다(설치본/설치 스크립트가 설치 시점 배치).
  -->
  <Target Name="EnsureDspSecrets" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_DspSecretsPath>$(MSBuildProjectDirectory)\dsp.conf</_DspSecretsPath>
      <!-- 정본 후보: $(DUALSOFT_SECRETS_DIR)\dsp.conf → \appsettings.Secrets.json(구 이름도 허용) -->
      <_DspSecretsSrc Condition="'$(DUALSOFT_SECRETS_DIR)' != '' And Exists('$(DUALSOFT_SECRETS_DIR)\dsp.conf')">$(DUALSOFT_SECRETS_DIR)\dsp.conf</_DspSecretsSrc>
      <_DspSecretsSrc Condition="'$(_DspSecretsSrc)' == '' And '$(DUALSOFT_SECRETS_DIR)' != '' And Exists('$(DUALSOFT_SECRETS_DIR)\appsettings.Secrets.json')">$(DUALSOFT_SECRETS_DIR)\appsettings.Secrets.json</_DspSecretsSrc>
      <!-- 하위호환: 예전 dev 가 프로젝트폴더에 appsettings.Secrets.json 을 두었으면 그것도 있음으로 인정(재복사·경고 안 함) -->
      <_DspSecretsHave Condition="Exists('$(_DspSecretsPath)') Or Exists('$(MSBuildProjectDirectory)\appsettings.Secrets.json')">true</_DspSecretsHave>
    </PropertyGroup>

    <!-- 1) 자동 복사: 정본이 환경변수 경로에 있으면 → dsp.conf -->
    <Copy Condition="'$(_DspSecretsHave)' != 'true' And '$(_DspSecretsSrc)' != ''"
          SourceFiles="$(_DspSecretsSrc)" DestinationFiles="$(_DspSecretsPath)" SkipUnchangedFiles="true" />
    <Message Condition="Exists('$(_DspSecretsPath)') And '$(_DspSecretsSrc)' != ''"
             Importance="high" Text="DSPilot: dsp.conf ← $(_DspSecretsSrc) (DUALSOFT_SECRETS_DIR 자동 복사)" />

    <!-- 2) 여전히 없음 + 하드 게이트 옵트인 → error -->
    <Error Condition="'$(_DspSecretsHave)' != 'true' And !Exists('$(_DspSecretsPath)') And '$(RequireSecrets)' == 'true'"
           Code="DSP0001"
           Text="dsp.conf 가 없습니다. 사내 cloudworks repo 의 deploy/dsp.conf 를 $(MSBuildProjectDirectory)\dsp.conf 로 복사하거나, 환경변수 DUALSOFT_SECRETS_DIR 을 그 폴더로 지정하세요(또는 appsettings.Secrets.sample.json 복사 후 dsp.conf 로 저장·값 입력)." />

    <!-- 3) 없음 + 기본 → warning (CI/타 앱 빌드는 안 깨짐) -->
    <Warning Condition="'$(_DspSecretsHave)' != 'true' And !Exists('$(_DspSecretsPath)') And '$(RequireSecrets)' != 'true'"
             Code="DSP0001"
             Text="dsp.conf 가 없어 CloudWorks 연동/브리핑이 '미구성'으로 동작합니다. 사내 cloudworks repo 의 deploy/dsp.conf 를 이 폴더에 dsp.conf 로 복사하거나 DUALSOFT_SECRETS_DIR 환경변수를 지정하세요(하드 차단: -p:RequireSecrets=true)." />
  </Target>

  <ItemGroup>
    <!-- Exclude backup folder from build -->
    <Compile Remove="_backup/**" />
    <Content Remove="_backup/**" />
    <EmbeddedResource Remove="_backup/**" />
    <None Remove="_backup/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 오프라인용 로컬 폰트/라이브러리를 publish에 포함 -->
    <Content Update="wwwroot\fonts\**" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot\lib\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
