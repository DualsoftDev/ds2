<?xml version="1.0" encoding="utf-8" ?>
<!--
  DSPilot 로그 설정. 파일 경로의 %property{LogDirectory} 는 DSPilot.Infrastructure.SharedFileLogging 이
  기동 시 공유 폴더(%ProgramData%\DualSoft\Shared\dspilot\logs)로 채운다 — Agent 의 로그와 한 뿌리 아래에
  모여야 "Agent 가 태그를 내보냈는가 ↔ DSPilot 이 받았는가" 를 시간순으로 대조할 수 있다.

  root 는 WARN 이다. 종전에 DSPilot 은 log4net 을 아예 설정하지 않아 참조 라이브러리(F# 백엔드)의 log4net
  호출이 전부 무음이었는데, 이제 설정이 붙으면서 살아난다. 갑자기 INFO 전량을 파일에 쓰면 조용하던 경로가
  디스크 I/O 를 타게 되므로, 살아나는 범위를 "진짜 문제(WARN 이상)" 로 제한한다.
  애플리케이션 로그(ILogger)는 아래 DSPilot.Runtime 로거가 따로 받는다.
-->
<log4net>
  <root>
    <level value="WARN" />
    <appender-ref ref="ConsoleAppender" />
    <appender-ref ref="FileAppender" />
  </root>

  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="[%level] %message%newline" />
    </layout>
  </appender>

  <appender name="FileAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDirectory}/plc-capture.log" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="5" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
  </appender>

  <appender name="PlcRawFileAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDirectory}/plc-raw.log" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <rollingStyle value="Composite" />
    <datePattern value="-yyyy-MM-dd" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="20MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} %-5level %message%newline" />
    </layout>
  </appender>

  <!--
    애플리케이션 로그(ILogger) 수신구. SharedFileLoggerProvider 가 이 이름으로만 기록한다.
    %thread 를 쓰지 않는 이유: 실제 기록은 전용 writer 스레드가 하므로 의미가 없고, 대신 호출 시점의
    스레드 번호를 메시지 앞에 실어 보낸다. 보존은 날짜별 14개(= 2주치 현장 추적).
  -->
  <appender name="DsPilotFileAppender" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%property{LogDirectory}/dspilot.log" />
    <appendToFile value="true" />
    <encoding value="utf-8" />
    <rollingStyle value="Composite" />
    <datePattern value="-yyyy-MM-dd" />
    <maxSizeRollBackups value="14" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>

  <!-- additivity=false — root 의 콘솔/plc-capture 로 번지지 않게. 레벨 게이트는 ILogger 쪽(MinimumLevel)이 담당. -->
  <logger name="DSPilot.Runtime" additivity="false">
    <level value="ALL" />
    <appender-ref ref="DsPilotFileAppender" />
  </logger>

  <logger name="PlcGateway.Raw" additivity="false">
    <level value="INFO" />
    <appender-ref ref="PlcRawFileAppender" />
  </logger>
</log4net>
