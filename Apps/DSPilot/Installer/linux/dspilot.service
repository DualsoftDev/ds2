# DSPilot systemd 유닛 템플릿. install.sh 가 @TOKEN@ 을 치환해 /etc/systemd/system/dspilot.service 로 설치한다.
# Type=notify 는 앱의 UseSystemd()(Microsoft.Extensions.Hosting.Systemd) 가 READY=1 을 보내므로 동작한다.
[Unit]
Description=DSPilot - PLC Monitoring & Analysis Service
After=network-online.target dspilot-mediamtx.service
Wants=network-online.target

[Service]
Type=notify
User=@USER@
Group=@USER@
WorkingDirectory=@WORKDIR@
ExecStart=@EXEC@
# Production 환경: appsettings.Production.json(사용자 설정 영속 저장소) 자동 로드 + 상세 오류 비노출.
Environment=ASPNETCORE_ENVIRONMENT=Production
# 공유 디렉터리 단일 소스 — plc.db / oee.db / project.aasx 가 모두 이 폴더로 정합된다(SharedPaths).
Environment=DUALSOFT_SHARED_DIR=@SHARED_DIR@
Restart=on-failure
RestartSec=10
# ASP.NET Core 는 SIGINT 로 graceful shutdown 한다.
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=dspilot
@AMBIENT_CAP@

[Install]
WantedBy=multi-user.target
