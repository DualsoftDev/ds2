<Window x:Class="DSPilot.AasxSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSPilot AasxSimulator"
        Height="640" Width="880"
        AllowDrop="True"
        Drop="OnAasxDrop"
        DragOver="OnAasxDragOver">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PLC 설정 -->
        <GroupBox Header="PLC 연결" Grid.Row="0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="타입:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbPlcType" Grid.Column="1" SelectionChanged="OnPlcTypeChanged">
                    <ComboBoxItem Content="LS"/>
                    <ComboBoxItem Content="Mitsubishi"/>
                </ComboBox>

                <TextBlock Text="IP:" VerticalAlignment="Center" Margin="16,0,8,0" Grid.Column="2"/>
                <TextBox x:Name="TxtIp" Grid.Column="3"/>

                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="16,0,8,0" Grid.Column="4"/>
                <TextBox x:Name="TxtPort" Grid.Column="5"/>

                <TextBlock x:Name="LblPlcModel" Text="모델:" VerticalAlignment="Center" Margin="16,0,8,0" Grid.Column="6"/>
                <ComboBox x:Name="CmbPlcModel" Grid.Column="7">
                    <ComboBoxItem Content="XGI"/>
                    <ComboBoxItem Content="XGK"/>
                    <ComboBoxItem Content="XGT"/>
                </ComboBox>

                <TextBlock x:Name="LblMxProtocol" Text="Protocol:" VerticalAlignment="Center" Margin="16,0,8,0" Grid.Column="6"
                           Visibility="Collapsed"/>
                <ComboBox x:Name="CmbMxProtocol" Grid.Column="7" Visibility="Collapsed">
                    <ComboBoxItem Content="UDP"/>
                    <ComboBoxItem Content="TCP"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- AASX 파일 -->
        <GroupBox Header="AASX 파일 (드래그 &amp; 드롭 지원)" Grid.Row="1" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtAasxPath" Grid.Column="0"/>
                <Button Grid.Column="1" Content="..." Width="32" Margin="6,0,0,0" Click="OnBrowseAasx"/>
                <Button x:Name="BtnValidate" Grid.Column="2" Content="검증" Width="80" Margin="6,0,0,0" Click="OnValidate"/>
            </Grid>
        </GroupBox>

        <!-- 실행 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnStart" Content="▶ 시작" Width="100" Height="32" Click="OnStart"/>
            <Button x:Name="BtnStop"  Content="■ 중지" Width="100" Height="32" Margin="8,0,0,0" Click="OnStop" IsEnabled="False"/>
            <Button Content="로그 지우기" Width="100" Height="32" Margin="8,0,0,0" Click="OnClearLog"/>
            <TextBlock Text="속도:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox x:Name="CmbSpeed" Width="80" VerticalAlignment="Center">
                <ComboBoxItem Content="0.25x" Tag="0.25"/>
                <ComboBoxItem Content="0.5x"  Tag="0.5"/>
                <ComboBoxItem Content="1x"    Tag="1"   IsSelected="True"/>
                <ComboBoxItem Content="2x"    Tag="2"/>
                <ComboBoxItem Content="5x"    Tag="5"/>
                <ComboBoxItem Content="10x"   Tag="10"/>
            </ComboBox>
            <TextBlock x:Name="LblCycle" Text="Cycle: 0" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <!-- 로그 -->
        <GroupBox Header="로그" Grid.Row="3" Margin="0,8,0,0">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </GroupBox>

        <!-- 상태바 -->
        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="LblStatus" Text="대기 중"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
