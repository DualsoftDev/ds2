@page "/assets"

<PageTitle>Assets</PageTitle>

<h1>등록된 자산 (파일럿)</h1>
<p class="lead">
    AAS 파일 SSOT — <code>/var/ds/aid-store/shells/*.json</code> 에 파일로 존재.
    OPC UA 서버가 파일 변경을 감지하여 노드 트리를 갱신합니다 (FileSystemWatcher).
</p>

<section class="mt-4">
    <h2>스펙 §04 파일럿 5자산</h2>
    <div class="row g-3">
        @foreach (var asset in Pilot)
        {
            <div class="col-md-6">
                <div class="card p-3">
                    <h5>@asset.Name <small class="text-muted">@asset.Kind</small></h5>
                    <p class="mb-1"><code>@asset.GlobalAssetId</code></p>
                    <p class="mb-1"><b>@asset.SignalCount signals</b> · @asset.Description</p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    record PilotAsset(string Name, string Kind, string GlobalAssetId, int SignalCount, string Description);

    static readonly PilotAsset[] Pilot = new[]
    {
        new PilotAsset("CNC01",  "OPC UA (스핀들·모터·사이클)",  "urn:dualsoft:asset:cnc01", 3, "가공 머시닝센터"),
        new PilotAsset("PM03",   "Modbus TCP (전력미터)",         "urn:dualsoft:asset:pm03",  1, "라인 전력 계량"),
        new PilotAsset("VIB11",  "MQTT (진동 센서)",               "urn:dualsoft:asset:vib11", 1, "베어링 진동 RMS"),
        new PilotAsset("VIS02",  "HTTP (비전 검사기)",             "urn:dualsoft:asset:vis02", 1, "PASS/FAIL 판정"),
        new PilotAsset("BCR05",  "AutoID · OPC 30010 (바코드)",   "urn:dualsoft:asset:bcr05", 1, "라인 트레이서빌리티"),
    };
}
