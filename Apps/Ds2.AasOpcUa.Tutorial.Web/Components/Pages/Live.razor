@page "/live"
@rendermode InteractiveServer
@inject UaLiveClientService Ua

<PageTitle>Live UA</PageTitle>

<h1>Live · OPC UA Client</h1>
<p class="lead">Ds2.OpcUa.Server 에 접속하여 자산 Variable 실시간 조회 (ADR-002 결정론적 NodeId).</p>

<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label>UA Endpoint</label>
            <input class="form-control" @bind="endpoint" placeholder="opc.tcp://localhost:48400" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="Connect" disabled="@connecting">
                @if (connecting) { <span class="spinner-border spinner-border-sm me-1"></span> } Connect
            </button>
            <button class="btn btn-outline-secondary" @onclick="Disconnect" disabled="@connecting">Disconnect</button>
        </div>
    </div>
    <p class="mt-2">
        <b>Status</b>:
        @if (Ua.IsConnected)
        {
            <span class="badge bg-success ms-1">연결됨</span>
        }
        else if (status.StartsWith("연결 실패"))
        {
            <span class="badge bg-danger ms-1">오프라인</span>
        }
        @(" " + status)
    </p>
    @if (status.Contains("BadNotConnected") || status.Contains("BadTimeout"))
    {
        <div class="alert alert-warning mt-2 mb-0 py-2">
            <b>Ds2.OpcUa.Server 가 실행 중이지 않습니다.</b>
            <code class="d-block mt-1">dotnet run --project Solutions/Runtime/Ds2.OpcUa.Server</code>
        </div>
    }
</div>

<div class="card p-3 mb-3">
    <h5>Namespaces</h5>
    @if (Ua.IsConnected)
    {
        <ol>
            @foreach (var uri in Ua.NamespaceUris())
            {
                <li><code>@uri</code></li>
            }
        </ol>
    }
    else
    {
        <p><em>먼저 Connect 를 실행하세요.</em></p>
    }
</div>

<div class="card p-3">
    <h5>Variable Read</h5>
    <div class="row g-2">
        <div class="col-md-4">
            <label>GlobalAssetId (urn)</label>
            <input class="form-control" @bind="assetId" />
        </div>
        <div class="col-md-4">
            <label>SignalId</label>
            <input class="form-control" @bind="signalId" />
        </div>
        <div class="col-auto align-self-end">
            <button class="btn btn-success" @onclick="Read" disabled="@(!Ua.IsConnected)">Read</button>
        </div>
    </div>
    <table class="table mt-3">
        <thead><tr><th>Time</th><th>NamespaceIndex</th><th>Value</th><th>StatusCode</th></tr></thead>
        <tbody>
            @foreach (var r in reads)
            {
                <tr>
                    <td><small>@r.At.ToString("HH:mm:ss.fff")</small></td>
                    <td>@r.NsIndex</td>
                    <td><b>@(r.Value?.ToString() ?? "(null)")</b></td>
                    <td>
                        @if (r.Status == 0)
                        {
                            <span class="badge bg-success">Good</span>
                        }
                        else
                        {
                            <code>0x@(r.Status.ToString("X8"))</code>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted"><small>Server 가 5자산 seed nodeset 을 로드했으면 예: <code>urn:dualsoft:asset:cnc01</code> + <code>line1.cnc01.spindle-speed</code> (초기값 0.0).</small></p>
</div>

@code {
    string endpoint = "opc.tcp://localhost:48400";
    string assetId = "urn:dualsoft:asset:cnc01";
    string signalId = "line1.cnc01.spindle-speed";
    string status = "미연결";
    bool connecting;

    record ReadRow(DateTime At, int NsIndex, double? Value, uint Status);
    readonly List<ReadRow> reads = new();

    async Task Connect()
    {
        connecting = true;
        status = "연결 중…";
        StateHasChanged();
        status = await Ua.ConnectAsync(endpoint);
        connecting = false;
    }

    async Task Disconnect()
    {
        status = await Ua.DisconnectAsync();
    }

    void Read()
    {
        var (ns, v, st) = Ua.ReadValue(assetId, signalId);
        reads.Insert(0, new ReadRow(DateTime.Now, ns, v, st));
        if (reads.Count > 20) reads.RemoveRange(20, reads.Count - 20);
    }
}
