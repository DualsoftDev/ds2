<Project>
  <Import Project="../../Solutions/Directory.Build.props" />

  <!-- BuildVersion.txt 가 Hub 버전의 SSOT. csproj 의 <Version> 라인은 두지 않는다 —
       매 빌드 시 이 props 가 값을 읽어 Version / AssemblyVersion / FileVersion 에 주입한다. -->
  <PropertyGroup>
    <HubVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)BuildVersion.txt').Trim())</HubVersion>
    <Version>$(HubVersion)</Version>
    <AssemblyVersion>$(HubVersion)</AssemblyVersion>
    <FileVersion>$(HubVersion)</FileVersion>
  </PropertyGroup>
</Project>
