<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- 로깅 -->
  <ItemGroup>
    <PackageVersion Include="log4net" Version="3.3.0" />
  </ItemGroup>
  <!-- Ds2.Hub (Windows Service 헤드리스 수집·모니터링) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>
  <!-- Ds2.Hub.Tray (알림 영역 상태 표시) -->
  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="9.0.5" />
  </ItemGroup>
  <!-- Ds2.Hub.Shared — OPC UA 클라이언트 + AID southbound 어댑터 -->
  <ItemGroup>
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.375.457" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="NModbus" Version="3.0.83" />
  </ItemGroup>
</Project>
