         Promaker WPF 쪽 csproj 와 동일 HintPath. -->
    <Reference Include="Ev2.PLC.Common.FS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Common.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\..\..\Solutions\Backend\Ds2.Backend.Plc\Ds2.Backend.Plc.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
  </ItemGroup>

</Project>
