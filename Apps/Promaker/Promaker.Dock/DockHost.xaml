<UserControl x:Class="Promaker.Dock.DockHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking">
    <!-- PR-D3 에서 DockLayoutManager 안 LayoutGroup 트리 구성 + 6 anchor + Document area.
         현 시점은 skeleton (빈 LayoutRoot). 외부 노출 API = IDockManager. -->
    <dxdo:DockLayoutManager x:Name="_dockLayout">
        <dxdo:LayoutGroup x:Name="_rootGroup" Orientation="Horizontal" />
    </dxdo:DockLayoutManager>
</UserControl>
