<UserControl x:Class="Promaker.Dock.DockHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking">
    <UserControl.Resources>
        <!--
            pane caption 폰트/높이 통일 (DockHost.xaml) — DX Office2019Black 의 LayoutPanel caption 기본 폰트가
            DocumentPanel(Workspace) 탭보다 커서 Explorer/Simulation 등 헤더만 크게 보이는 문제 차단.
            Workspace(문서 탭) 기준으로 LayoutPanel caption 폰트를 낮춰 전 pane 통일. caption 은 폰트+패딩 기반
            auto-height 라 폰트 축소 시 헤더 높이도 함께 축소됨. SSOT — 아래 두 caption template 이 공유.
        -->
        <sys:Double x:Key="PaneCaptionFontSize">12</sys:Double>

        <!-- Help 버튼 없는 LayoutPanel(Simulation/Log/LLM Chat) 용 caption — 폰트 크기만 명시 통일. -->
        <DataTemplate x:Key="PaneCaption">
            <TextBlock Text="{Binding Caption, RelativeSource={RelativeSource AncestorType={x:Type dxdo:LayoutPanel}}}"
                       FontSize="{StaticResource PaneCaptionFontSize}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!--
            PR-D9 — MJ2 Help 버튼 복구. baseline AvalonDock 의 AnchorableHeaderTemplate / AnchorableTitleTemplate
            에 박혀 있던 explorer/properties/history 3 anchor 의 caption 영역 ? Help 버튼을 DX
            BaseLayoutItem.CaptionTemplate 로 이식. anchor.HasHelp=true 시 DockHost.RegisterAnchor 에서
            BaseLayoutItem.CaptionTemplate 으로 본 Resource 적용.

            DataContext 박제: DX BaseLayoutItem.CaptionTemplate 의 DataContext 는 BaseLayoutItem 인스턴스
            (DX 24.1 정합). 그래서 TextBlock.Text 는 {Binding Caption}, Button.Tag 는 {Binding Name}
            (RegisterAnchor 에서 Name = ContentId 로 set — ApplyAnchorMetadata 참조).

            Help 버튼 visual: Promaker.Dock 외부 의존 0 박제 — 추가 NuGet (MahApps.IconPacks 등) 회피.
            단순 ? 텍스트 + Padding/Margin + 투명 Background. Theme.Controls.Forms.xaml 의 HelpButton Style
            은 Promaker.Dock 에서 참조 불가 (격리 §7 #4 — Promaker 본체 Themes 미참조).
        -->
        <DataTemplate x:Key="AnchorCaptionWithHelp">
            <!-- Caption / Tag binding: AncestorType=LayoutPanel 로 명시 (CaptionTemplate 의 DataContext 는
                 DX chrome 내부 구조에 따라 string 또는 BaseLayoutItem 일 수 있음 — visual tree ancestor 가 안전).
                 Help 뱃지 visual: Theme.Controls.Forms.xaml 의 HelpButton (파란 원형 ? 뱃지) 와 시각 통일 —
                 Promaker.Dock 격리상 직접 Style 참조 불가, inline Border + TextBlock 으로 동등 visual.
                 DynamicResource (AccentBrush / AccentTextBrush) lookup 은 Application.Resources 까지 도달 OK.
                 Click 핸들러: PreviewMouseLeftButtonDown — DX caption drag chrome 의 mouse capture 차단 의무
                 (e.Handled=true). 일반 Button.Click event 는 chrome 가로채서 동작 안 함. -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Caption, RelativeSource={RelativeSource AncestorType={x:Type dxdo:LayoutPanel}}}"
                           FontSize="{StaticResource PaneCaptionFontSize}"
                           VerticalAlignment="Center"/>
                <Border Width="14" Height="14"
                        CornerRadius="7"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        Cursor="Hand"
                        ToolTip="도움말"
                        Tag="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type dxdo:LayoutPanel}}}"
                        PreviewMouseLeftButtonDown="HelpBadge_PreviewMouseLeftButtonDown">
                    <TextBlock Text="?"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-1,0,0"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!--
        PR-D3 — done-dock-avalon.md §3.1 의 "안 A" (Welcome/Open 통합 LayoutDocument) 를 DX LayoutGroup 트리로 이전.

        외곽: horizontal LayoutGroup
          ├─ Left  : explorerPanel (LayoutPanel, ItemWidth=320)
          ├─ Center: vertical LayoutGroup
          │           ├─ documentGroup (DocumentGroup) — Welcome / Canvas DocumentPanel 등록처
          │           └─ bottomGroup   (LayoutGroup, Horizontal, ItemHeight=200)
          │                ├─ simulationPanel (LayoutPanel) — BottomLeft
          │                └─ logPanel        (LayoutPanel) — BottomRight (post-D8 fix: Log 독립 승격)
          └─ Right : vertical LayoutGroup (ItemWidth=280)
                      ├─ propertyPanel  (LayoutPanel)
                      ├─ historyPanel   (LayoutPanel, ItemHeight=220)
                      └─ llmChatPanel   (LayoutPanel, Closed=True 기본 닫힘)

        외부 노출 API = IDockManager. DX type 은 본 UserControl 안에서만 사용.
        size 보존 / drag-drop / floating 동작은 DX DockLayoutManager 가 native 처리 — 별도 보정 코드 없음.
    -->
    <dxdo:DockLayoutManager x:Name="_dockLayout">
        <dxdo:LayoutGroup x:Name="_rootGroup" Orientation="Horizontal">

            <!-- Left column: Explorer -->
            <dxdo:LayoutPanel x:Name="_explorerPanel"
                              Caption="Explorer"
                              ItemWidth="320" />

            <!-- Center column: Document area + Bottom (Simulation | Log horizontal split) -->
            <dxdo:LayoutGroup x:Name="_centerGroup" Orientation="Vertical">

                <!-- Document area (Welcome / Canvas) — RegisterDocument 가 DocumentPanel 추가 -->
                <dxdo:DocumentGroup x:Name="_documentGroup" />

                <!-- Bottom: Simulation (좌) + Log (우) horizontal split. ItemHeight=200 박제, 사용자 docking 으로 재배치 가능. -->
                <dxdo:LayoutGroup x:Name="_bottomGroup" Orientation="Horizontal" ItemHeight="200">
                    <dxdo:LayoutPanel x:Name="_simulationPanel"
                                      Caption="Simulation" />
                    <dxdo:LayoutPanel x:Name="_logPanel"
                                      Caption="Log" />
                </dxdo:LayoutGroup>
            </dxdo:LayoutGroup>

            <!-- Right column: Properties / History / LlmChat -->
            <dxdo:LayoutGroup x:Name="_rightGroup" Orientation="Vertical" ItemWidth="280">

                <dxdo:LayoutPanel x:Name="_propertyPanel"
                                  Caption="Properties" />

                <dxdo:LayoutPanel x:Name="_historyPanel"
                                  Caption="History"
                                  ItemHeight="220" />

                <!-- LlmChat: 기본 닫힘. 사용자가 보기 메뉴 / LLM 토글로 열어야 노출. -->
                <dxdo:LayoutPanel x:Name="_llmChatPanel"
                                  Caption="LLM Chat"
                                  Closed="True" />
            </dxdo:LayoutGroup>

        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>
</UserControl>
