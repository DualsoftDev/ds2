<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RootNamespace>Promaker.Dock</RootNamespace>
    <AssemblyName>Promaker.Dock</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    PR-A1 — DevExpress 11종 Reference HintPath / DXInstallRoot / NoWarn(MSB3277) / ImplicitUsings=disable 모두 제거.
    AvalonDock 은 일반 NuGet PackageReference 로 사용 (Promaker 본체에 transitive 노출되어도 무해 — MIT 단일 어셈블리).
    Promaker.Dock 격리 경계는 IDockManager API 표면으로 유지 — AvalonDock type 은 본 csproj 안에서만 사용.
  -->
  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" />
  </ItemGroup>

</Project>
