<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Promaker.Agent</RootNamespace>
    <AssemblyName>Promaker.Agent</AssemblyName>
    <!-- Version 은 Promaker 와 동일 SSOT (Directory.Build.props 가 BuildVersion.txt 주입). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MSB3277: Dual.Common.Base.FS 가 System.ServiceProcess.ServiceController 9.0.0.5 를 끌어오고
         Microsoft.Extensions.Hosting.WindowsServices 9.0.0 은 9.0.0.0 을 끌어와 minor 충돌.
         실런타임에는 9.0.0.5 가 binding redirect 로 사용되어 무해 — DSPilot.csproj 와 동일 처리. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <!-- 헤드리스 모니터링 핵심: BackendHost(5051 read-only SignalR Hub + PLC Scan).
         Promaker WPF Monitoring + RealPLC 분기가 호출하던 BackendHost.startWithPlcConfigReadOnly 를
         Agent 가 SYSTEM 컨텍스트에서 대신 호출. -->
    <ProjectReference Include="..\..\..\Solutions\Backend\Ds2.Backend\Ds2.Backend.fsproj" />
    <!-- Agent 단일 호스팅: engine ↔ Hub 브리지 (IRuntimeHubSession 실제 구현). R1: 이 어셈블리만 Runtime+Backend 둘 다 참조. -->
    <ProjectReference Include="..\..\..\Solutions\Backend\Ds2.Backend.Runtime\Ds2.Backend.Runtime.fsproj" />
    <!-- AASX → DsStore 로드 (shared project.aasx 읽어 IOMap 빌드). -->
    <ProjectReference Include="..\..\..\Solutions\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <!-- DsStore, SignalIOMap. -->
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.Core\Ds2.Core.fsproj" />
    <!-- UserTag panel extensions (GetAllUserTagsForProject) — PLC 구독 목록에 UserTag 주소 추가용. -->
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.Editor\Ds2.Editor.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
    <!-- 공유 POCO + 경로 + Gateway 빌더 (Phase 0 산출물). -->
    <ProjectReference Include="..\Promaker.Shared\Promaker.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- LS XGT USB 로더 수집(Ds2.Backend.Plc LsUsbAdapter → Ev2.PLC.Usb)이 P/Invoke 로 여는 네이티브 libusb-1.0.
         Ev2.PLC.Usb 의 리졸버는 NativeLibrary.TryLoad("libusb-1.0.dll") 평문 이름이라 Promaker.Agent.exe 와
         같은 폴더에 있어야 한다(runtimes\<rid>\native 아님). 이 프로젝트가 USB 를 실제로 여는 유일한 Windows
         프로세스이고(Promaker.exe·DSPilot.exe 는 열지 않음), 두 인스톨러(Promaker Setup.iss · DSPilot.iss)가
         publish 폴더를 통째로 {app}\Agent 에 복사하므로 여기 한 곳에서 출력에 실으면 설치본에도 따라간다.
         LGPL-2.1 — 라이선스 전문(LICENSE-*)과 출처/해시(NOTICE-*)를 DLL 옆에 함께 배치한다(고지 의무).
         Exists 조건: ExternalDlls 스냅샷이 없는 환경(CI 부분 체크아웃)에서도 빌드는 되게 — USB 접속만 실패. -->
    <None Include="..\..\..\ExternalDlls\libusb-1.0.dll" Link="libusb-1.0.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\ExternalDlls\libusb-1.0.dll')" />
    <None Include="..\..\..\ExternalDlls\LICENSE-libusb-1.0.txt" Link="LICENSE-libusb-1.0.txt"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\ExternalDlls\LICENSE-libusb-1.0.txt')" />
    <None Include="..\..\..\ExternalDlls\NOTICE-libusb-1.0.txt" Link="NOTICE-libusb-1.0.txt"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\ExternalDlls\NOTICE-libusb-1.0.txt')" />
  </ItemGroup>

</Project>
