<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- WPF MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- JSON 편집 탭 에디터 (검색/바꾸기 + syntax highlighting). MIT, ICSharpCode. -->
    <PackageVersion Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>
  <!-- 로깅 -->
  <ItemGroup>
    <PackageVersion Include="log4net" Version="3.3.0" />
  </ItemGroup>
  <!-- 아이콘 팩 -->
  <ItemGroup>
    <PackageVersion Include="MahApps.Metro.IconPacks.Material" Version="6.0.0" />
  </ItemGroup>
  <!-- Markdown 렌더 -->
  <ItemGroup>
    <PackageVersion Include="MdXaml" Version="1.27.0" />
  </ItemGroup>
  <!-- WebView2 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2277.86" />
  </ItemGroup>
  <!-- AvalonDock (MIT) — Promaker.Dock 캡슐화 -->
  <ItemGroup>
    <PackageVersion Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
  </ItemGroup>

  <!-- 시스템 트레이 아이콘 — Monitoring 모드 백그라운드 전환용 -->
  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.0" />
  </ItemGroup>

  <!-- SignalR Client + 테스트 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Promaker.Agent (Windows Service 헤드리스 모니터링) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="9.0.5" />
  </ItemGroup>

  <!-- OPC UA — Promaker 는 Ds2.OpcUa.Server 의 EmbeddedUaServer 를 인프로세스 구동.
       Solutions/Runtime/Ds2.OpcUa.Server 와 동일 버전 1.5.375.457 고정. -->
  <ItemGroup>
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Core" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.375.457" />
    <!-- Microsoft.Extensions.Hosting — Ds2.OpcUa.Server 가 Worker SDK 이므로 hosting 스택 필요. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.5" />
  </ItemGroup>
  <!-- AID southbound adapters owned by Promaker.Agent. -->
  <ItemGroup>
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="NModbus" Version="3.0.83" />
  </ItemGroup>
</Project>
