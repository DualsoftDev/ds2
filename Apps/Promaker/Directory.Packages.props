<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- WPF MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- JSON 편집 탭 에디터 (검색/바꾸기 + syntax highlighting). MIT, ICSharpCode(ILSpy/SharpDevelop).
         AvalonDock(도킹) 과 이름만 닮은 별개 텍스트 에디터 컨트롤. -->
    <PackageVersion Include="AvalonEdit" Version="6.3.0.90" />
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <!-- LLM Chat 첨부 (review F3) — App.xaml.cs 의 CodePagesEncodingProvider 등록용. -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <!-- LLM Chat 첨부 Phase 3b (rev 15) — PDF 페이지 수 추출 (Apache 2.0, iText AGPL 회피). -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <!-- done-lighthouse-kb-index.md r9 보류 신설 → r11/s5e-r0 결정: Solutions/Directory.Packages.props 의 LightHouse 와 동일 3.5.1 명시.
         PdfPig 0.1.14 가 transitive 로 OpenXml 3.1.1 을 끌어와 LightHouse 의 3.5.1 과 MSB3277 충돌 → Promaker scope 에서도 3.5.1 로 통일. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Phase 4 — sqlite-vec native binary (vec0 extension). lib 의 PrivateAssets="all" 이라 native asset
         transitive 안 됨 → Promaker publish output 에 직접 의무. version SSOT = Solutions/Directory.Packages.props
         의 sqlite-vec 와 동일 0.1.7-alpha.2.1 (drift 의무 cross-PR 추적). -->
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
  </ItemGroup>
  <!-- LLM API Providers (Phase 2) — Anthropic / OpenAI / OllamaSharp + Microsoft.Extensions.AI 공통 추상 -->
  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="12.20.0" />
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <!-- HKMC H-Chat phase 2 — Azure OpenAI deployment routing 위해 신규 의존성.
         Apps/Shared/Directory.Packages.props 와 버전 정합 의무 (drift 시 NU1605). -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.5.2" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.2" />
  </ItemGroup>
  <!-- 로깅 -->
  <ItemGroup>
    <PackageVersion Include="log4net" Version="3.3.0" />
  </ItemGroup>
  <!-- 아이콘 팩 -->
  <ItemGroup>
    <PackageVersion Include="MahApps.Metro.IconPacks.Material" Version="6.0.0" />
  </ItemGroup>
  <!-- Markdown 렌더 — LLM chat assistant 응답 내 ```md ``` fence 자동 인식 + FlowDocument inline 렌더.
       done-llm-markdown.md 권장안 B1. Markdig 파서 + AvalonEdit syntax highlight. MIT. -->
  <ItemGroup>
    <PackageVersion Include="MdXaml" Version="1.27.0" />
  </ItemGroup>
  <!-- WebView2 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2277.86" />
  </ItemGroup>
  <!-- PR-A1 (DX 제거 + AvalonDock 복귀):
       DevExpress.Wpf.Docking → Dirkster.AvalonDock (MIT) 재교체.
       Promaker.Dock.csproj 가 PackageReference 로 직접 참조. AvalonDock type 외부 노출 차단은 IDockManager 표면으로 유지.
       VS2013 테마 패키지로 light/dark 양쪽 (Promaker ThemeManager 연동) 지원. -->
  <ItemGroup>
    <PackageVersion Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
  </ItemGroup>

  <!-- 시스템 트레이 아이콘 (WPF 네이티브) — Monitoring 모드 백그라운드 전환용 -->
  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.0" />
  </ItemGroup>

  <!-- SignalR Client -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Promaker.Agent (Windows Service 헤드리스 모니터링) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <!-- Promaker.AgentTray 가 sc 서비스 상태/start mode 조회에 사용 (DSPilot.csproj 와 동일 버전). -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="9.0.5" />
  </ItemGroup>
</Project>
