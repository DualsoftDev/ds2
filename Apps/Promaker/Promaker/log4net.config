<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- 날짜별 롤링 파일 (rollingStyle=Date — size roll 없음, 하루 1파일). 실제 파일명: logs/ds2-YYYYMMDD.log
       staticLogFileName=false → 활성 파일에도 날짜 부착. preserveLogFileNameExtension=true 로 .log 확장자 보존
       (이 옵션이 없으면 ds2.log20260608 처럼 확장자가 깨진다). datePattern 앞 '-' 로 base 와 날짜 구분.
       각 log line 은 compact pid token [pidN] 만 출력하고,
       실행 단위는 PROMAKER_RUN_BEGIN / PROMAKER_RUN_END marker 의 runId 로 구분한다.
       날짜 rolling 은 PromakerRollingFileAppender 가 이전 파일에 PROMAKER_LOG_DATE_ROLL_END,
       새 파일에 PROMAKER_LOG_DATE_ROLL_BEGIN marker 를 남긴다.
       주의: 날짜 파일은 자동 정리되지 않고 누적된다 (보관 정리는 별도 sweep 사안). -->
  <appender name="RollingFile" type="Promaker.Logging.PromakerRollingFileAppender, Promaker">
    <file value="logs/ds2.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'-'yyyyMMdd" />
    <staticLogFileName value="false" />
    <preserveLogFileNameExtension value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%-5level] [%property{PromakerLogPid}] %logger{1} — %message%newline%exception" />
    </layout>
  </appender>

  <!-- Visual Studio 출력 창 -->
  <appender name="Debug" type="log4net.Appender.DebugAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="[%-5level] %logger{1} — %message%newline" />
    </layout>
  </appender>

  <!-- GUI Log dock (logAnchor / Controls/Logging/AppLogView) — Promaker.Logging.WpfObservableAppender.
       AppLogState.Instance 가 ObservableCollection 으로 누적, ICollectionView 가 ComboBox 선택값 이상만 필터.
       threshold=DEBUG 는 appender 자체의 floor (logger level 단계에서 차단되면 의미 없음 — root <level> 또는
       <logger name=...> override 가 우선). 향후 RollingFile 만 INFO 로 올리고 GUI 는 DEBUG 유지처럼
       appender 별 차이를 두고 싶을 때 활용. -->
  <appender name="Wpf" type="Promaker.Logging.WpfObservableAppender, Promaker">
    <threshold value="DEBUG" />
  </appender>

  <root>
    <level value="DEBUG" />
    <appender-ref ref="RollingFile" />
    <appender-ref ref="Debug" />
    <appender-ref ref="Wpf" />
  </root>

  <!-- ASP.NET Core / Kestrel / SignalR 의 Information 레벨 노이즈 차단:
       원위치·Control 모드에서 hub/PLC 게이트웨이 시작·종료 시 hosting/routing/connection
       관련 Information 로그가 다량 출력돼 우리 도메인 로그를 묻기 때문에 WARN 이상만 통과.
       (Graceful shutdown 시 cancel 토큰 1차 예외 자체는 .NET 런타임이 직접 출력하므로
        log4net 필터로는 막을 수 없다. VS 디버그 → 예외 설정에서 별도로 제어.) -->
  <logger name="Microsoft.AspNetCore">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft.Hosting">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft.Extensions.Hosting">
    <level value="WARN" />
  </logger>
</log4net>
