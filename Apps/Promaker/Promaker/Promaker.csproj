<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <RootNamespace>Promaker</RootNamespace>
    <AssemblyName>Promaker</AssemblyName>
    <!-- Version / AssemblyVersion / FileVersion 는 Directory.Build.props 가 BuildVersion.txt 에서 주입. -->
    <ApplicationIcon>Assets\Promaker.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OtherFlags>
    </OtherFlags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CS9057: OllamaSharp 5.4.25 의 SourceGenerator 어셈블리 OllamaSharp.SourceGenerators.dll 이 Roslyn 5.0.0.0 을 참조하는데, 현재 .NET
         SDK 9.0.301 의 Roslyn 은 4.14.0.0. SourceGenerator 자체만 비활성 — 실 런타임 영향 없음 ([OllamaTool] attribute scan
         비활성 = MCP 외부 tool 자동 등록 안 되는 정도).
         **사용 영향 없음** (R7 cross-check 2026-05-11 — Microsoft Learn Roslyn version mapping 확인): (a) .NET SDK 가 Roslyn 5.0+ 를 탑재 = **VS 2026 (18.0) / .NET 10 SDK** (VS 17.x 까지 Roslyn 4.x 정합), 또는 (b) OllamaSharp 가 Roslyn 4.x 로 downgrade. 그때까지 NoWarn 정합. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- review S5a-m4: Promaker.Tests 가 LightHouseClient 의 internal ctor 호출 (mock HttpClient 주입).
         reflection 우회 대신 명시 InternalsVisibleTo — 향후 internal API 변경 시 compile-time 검출. -->
    <InternalsVisibleTo Include="Promaker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="log4net" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <!-- AvalonDock (PR-1a) + Metro 테마 (Promaker 메인 윈도우 docking + ResourceDictionary 일괄 적용). -->
    <PackageReference Include="Dirkster.AvalonDock" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.Metro" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- App.xaml.cs OnStartup 의 CodePagesEncodingProvider.RegisterProvider entry-point 책임 (todo §4.2c).
         기능상 transitive (Ds2.LightHouse) 로 충분하나, entry-point assembly 의 *명시적 자기 의존* 으로 잔류 —
         미래에 LightHouse 가 CodePages 의존 끊으면 본 line 이 NuGet restore 단계에서 fail-fast 안전망 역할 (review M2). -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- Phase 2 — API providers (Anthropic / OpenAI / Ollama via Microsoft.Extensions.AI IChatClient) -->
    <PackageReference Include="Anthropic" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- LLM Chat 첨부 — Phase 3b 의 PDF 첨부 등 (LlmChatViewModel.Attachments.cs 의 LoadAcceptedAttachments). -->
    <PackageReference Include="PdfPig" />
    <!-- todo-lighthouse-kb-index.md r11/s5e-r0 결정: PdfPig 0.1.14 의 OpenXml 3.1.1 transitive 와
         Ds2.LightHouse 의 3.5.1 충돌 (MSB3277) 해소용 명시. CPM 의 3.5.1 적용. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Phase 4 — sqlite-vec native binary (vec0 extension load 의무, lib 의 PrivateAssets=all 우회).
         Promaker 가 AttachmentIngestService 안에서 lib 의 Indexer 호출 → lib 의 SqliteStore 가 LoadExtension("vec0")
         → vec0.dll 이 Promaker publish output 에 있어야 함.
         ExcludeAssets=contentFiles — sqlite-vec NuGet 의 Vector.cs C# wrapper (SqliteConnection 직접 의존) compile
         차단. lib (F#) 가 raw LoadExtension + SQL string path 만 사용 — Vector.cs wrapper 미사용. -->
    <PackageReference Include="sqlite-vec" ExcludeAssets="contentFiles" />
  </ItemGroup>
  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Promaker.ico" />
    <Resource Include="Assets\SdfFile.ico" />
    <Resource Include="Resources\Icons\aas.png" />
    <Resource Include="Assets\Runtime\**\*.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <!-- LLM system prompt = LlmAgent/Prompts/*.md (전체 마크다운 concat). PromptLoader 로드. -->
    <EmbeddedResource Include="LlmAgent\Prompts\*.md" />
    <EmbeddedResource Remove="LlmAgent\Prompts\CLAUDE.md" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\Solutions\View\Ds2.View3D\wwwroot\models\**\*" Link="wwwroot\models\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 패키지 추가 콘텐츠 + 빌드 리소스 -->
    <Content Include="..\..\..\Solutions\View\Ds2.View3D\wwwroot\device-preview.html" Link="wwwroot\device-preview.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\Solutions\View\Ds2.View3D\wwwroot\DEVICE_JSON_SPEC.md" Link="wwwroot\DEVICE_JSON_SPEC.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- AAStoXGI 의존 — XGI_Template.xml / IECFunctionInfo.json 등 AAStoPLC.dll 의 EmbeddedResource. 배포 후 PlcConfig 가 AppData\PlcTemplate\ 로 풀어줌. -->
  </ItemGroup>
  <ItemGroup>
    <!-- AAStoPLC, AAStoPLC.LadderEditor 등 PLC 도메인 (dsev2cpu) 디펜던시 묶음.
         디펜던시의 ExternalDlls 로 통합 — 향후 dll 정리 시 본 entry 정합. -->
    <Reference Include="AAStoPLC">
      <HintPath>..\..\..\ExternalDlls\AAStoPLC.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AAStoPLC.LadderEditor">
      <HintPath>..\..\..\ExternalDlls\AAStoPLC.LadderEditor.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- PLC 도메인 디펜던시 Ev2.PLC.Common 의 PlcDataType 등 도메인 모듈.
         PlcSettings 의 디펜던시는 C# 패키지 외부 — 직접 참조 없이 EmbeddedResource 만 박제. -->
    <Reference Include="Ev2.PLC.Common.FS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Common.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.Core\Ds2.Core.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\View\Ds2.View3D\Ds2.View3D.Core\Ds2.View3D.Core.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Convert\Ds2.IOList\Ds2.IOList.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Convert\Ds2.CSV\Ds2.CSV.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Convert\Ds2.Mermaid\Ds2.Mermaid.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.Editor\Ds2.Editor.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.LightHouse\Ds2.LightHouse.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Tools\Ds2.LightHouse.Ollama\Ds2.LightHouse.Ollama.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Core\Ds2.LlmAgent\Ds2.LlmAgent.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Runtime\Ds2.Runtime.Report\Ds2.Runtime.Report.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Backend\Ds2.Backend\Ds2.Backend.fsproj" />
    <ProjectReference Include="..\..\..\Solutions\Backend\Ds2.Backend.Common\Ds2.Backend.Common.fsproj" />
  </ItemGroup>
</Project>
