<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        MdXaml MarkdownScrollViewer 의 MarkdownStyle 로 주입할 다크 테마 FlowDocument 스타일.
        done-llm-markdown.md Phase 2.
        WPF 정석: Resources 는 DependencyProperty 가 아니므로 <Setter Property="Resources"> 불가.
        <Style.Resources> (자식 element) 로 keyed sub-style 주입.
        MdXaml 1.27 의 sub-style key 규약: element 의 Tag 로 "Heading1"~"Heading6" / "CodeSpan" /
        "CodeBlock" / "Blockquote" 강제. implicit Paragraph style 은 keyed Heading 들을 덮어쓸 위험이
        있어 두지 않음.
    -->

    <Style x:Key="LlmMarkdownStyle" TargetType="FlowDocument">
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="PagePadding" Value="0"/>

        <Style.Resources>
            <!-- Heading H1~H6 — MdXaml Tag 기반 lookup -->
            <Style x:Key="Heading1" TargetType="Paragraph">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>
            <Style x:Key="Heading2" TargetType="Paragraph">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,6,0,4"/>
            </Style>
            <Style x:Key="Heading3" TargetType="Paragraph">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>
            <Style x:Key="Heading4" TargetType="Paragraph">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>
            <Style x:Key="Heading5" TargetType="Paragraph">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>
            <Style x:Key="Heading6" TargetType="Paragraph">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>

            <!-- Inline code (`...`) — MdXaml Tag = CodeSpan, Span TargetType -->
            <Style x:Key="CodeSpan" TargetType="Span">
                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace"/>
            </Style>

            <!-- Fenced code block (```…```) — MdXaml Tag = CodeBlock, Paragraph TargetType -->
            <Style x:Key="CodeBlock" TargetType="Paragraph">
                <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>

            <!-- Hyperlink — implicit (Tag 기반 lookup 외 — 모든 Hyperlink 에 적용) -->
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Style>

            <!-- Blockquote — MdXaml Tag = Blockquote, Section TargetType -->
            <Style x:Key="Blockquote" TargetType="Section">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="Padding" Value="8,0,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            </Style>

            <!-- Table / TableCell — implicit (모든 표에 적용) -->
            <Style TargetType="Table">
                <Setter Property="CellSpacing" Value="0"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>
            <Style TargetType="TableCell">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>

            <!-- List (ul/ol) — implicit. MdXaml/FlowDocument 의 default indent 가 매우 크므로 (≈ 40px)
                 Margin 좌측 0 + Padding 0 + MarkerOffset 으로 marker 와 텍스트 간격만 좁게. -->
            <Style TargetType="List">
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="Padding" Value="20,0,0,0"/>
                <Setter Property="MarkerOffset" Value="6"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <!-- ListItem — Paragraph 내부 Margin 축소 (item 간 간격). -->
            <Style TargetType="ListItem">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
