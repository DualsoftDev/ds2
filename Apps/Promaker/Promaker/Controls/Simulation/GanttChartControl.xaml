<UserControl x:Class="Promaker.Controls.GanttChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource TertiaryBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="RowLabelStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="전체 Call 펼치기" Click="OnExpandAllCalls"/>
                <MenuItem Header="전체 Call 접기" Click="OnCollapseAllCalls"/>
                <Separator/>
                <MenuItem Header="전체 Work 펼치기" Click="OnExpandAllWorks"/>
                <MenuItem Header="전체 Work 접기" Click="OnCollapseAllWorks"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 좌상단: 이름 헤더 -->
        <Border Grid.Column="0" Grid.Row="0"
                Background="{DynamicResource PanelHeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,1">
            <TextBlock Text="Work / Call"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- 우상단: 시간 눈금자 + 표시 윈도우 프리셋 -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="{DynamicResource PanelHeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                ClipToBounds="True">
            <Grid>
                <Canvas x:Name="TimeRulerCanvas"/>
                <!-- 간트 표시 윈도우(분) — 빨간 타임라인(현재) 기준 최근 N분만 표시. (구) PLC 설정
                     다이얼로그 슬라이더에서 이사 — 순수 뷰 설정이라 제어 대상(간트) 옆에 둔다. -->
                <ComboBox x:Name="WindowPresetCombo"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Width="80" Height="20" Margin="0,0,4,0"
                          FontSize="10" Padding="6,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="OnWindowPresetChanged"
                          ToolTip="간트 표시 범위 — 빨간 타임라인(현재) 기준 최근 N분만 표시합니다. 그보다 오래된 구간은 스크롤해도 보이지 않습니다."/>
            </Grid>
        </Border>

        <!-- 좌측: 행 라벨 -->
        <ScrollViewer Grid.Column="0" Grid.Row="1"
                      x:Name="LabelScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnLabelScrollChanged">
            <ItemsControl x:Name="RowLabelsControl"
                          ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder"
                                Height="{Binding RowHeight}"
                                Style="{StaticResource RowLabelStyle}"
                                Margin="0,0,0,2"
                                Tag="{Binding}"
                                MouseLeftButtonDown="OnRowLabelMouseDown"
                                Cursor="Hand">
                            <Grid Margin="{Binding IndentMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="ExpandedIcon" Grid.Column="0"
                                      Width="12" Height="12" Margin="2,0,4,0"
                                      Fill="{DynamicResource SecondaryTextBrush}"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M7,14L12,9L17,14H7Z"
                                      Visibility="Collapsed" Cursor="Hand"
                                      MouseLeftButtonDown="OnToggleIconClick"/>
                                <Path x:Name="CollapsedIcon" Grid.Column="0"
                                      Width="12" Height="12" Margin="2,0,4,0"
                                      Fill="{DynamicResource SecondaryTextBrush}"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M7,10L12,15L17,10H7Z"
                                      Visibility="Collapsed" Cursor="Hand"
                                      MouseLeftButtonDown="OnToggleIconClick"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="10" VerticalAlignment="Center"
                                           Padding="4,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                                <!-- ApiCall 전용 — 막대 위(Plan)/아래(I/O)에 맞춘 PLN/I/O 세로 표식 -->
                                <StackPanel x:Name="IoLabels" Grid.Column="2"
                                            VerticalAlignment="Center" Margin="4,0,6,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="PLN" FontSize="8" Height="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                    <TextBlock Text="I/O" FontSize="8" Height="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasChildren}" Value="True"/>
                                    <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ExpandedIcon" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasChildren}" Value="True"/>
                                    <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CollapsedIcon" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsWork}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource GanttWorkRowBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCall}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource GanttCallRowBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsApiCall}" Value="True">
                                <Setter TargetName="IoLabels" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 우측: 타임라인 캔버스 -->
        <Border Grid.Column="1" Grid.Row="1" ClipToBounds="True"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
            <Grid>
                <ScrollViewer x:Name="TimelineScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnTimelineMouseWheel"
                              ScrollChanged="OnTimelineScrollChanged">
                    <Canvas x:Name="TimelineCanvas"
                            Background="Transparent" ClipToBounds="False"
                            MouseLeftButtonDown="OnTimelineMouseDown"
                            MouseMove="OnTimelineMouseMove"
                            MouseLeftButtonUp="OnTimelineMouseUp"/>
                </ScrollViewer>
                <Canvas x:Name="CurrentTimeOverlay" IsHitTestVisible="False" ClipToBounds="True">
                    <Line x:Name="CurrentTimeLine" Y1="0"
                          Stroke="#FF4444" StrokeThickness="2" StrokeDashArray="4,2"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- 툴팁 팝업 -->
        <Popup x:Name="TooltipPopup" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=TimelineCanvas}"
               Placement="Mouse" HorizontalOffset="10" VerticalOffset="10">
            <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8,6">
                <StackPanel x:Name="TooltipContent" MinWidth="120">
                    <TextBlock x:Name="TooltipTitle" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Separator Margin="0,4" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock x:Name="TooltipState" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TooltipTime" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="TooltipDuration" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
