<UserControl x:Class="Promaker.Controls.Logging.AppLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Promaker.Behaviors">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LogWarnBrush"    Color="#FFA500"/>
        <SolidColorBrush x:Key="LogErrorBrush"   Color="#FF4444"/>
        <SolidColorBrush x:Key="LogFatalBrush"   Color="#FF00FF"/>
        <!-- Simulation 도메인 색 — LogSeverity 의 Ready/Going/Finish/Homing/Timeout/System 매핑. -->
        <SolidColorBrush x:Key="SimReadyBrush"   Color="#90A4AE"/>
        <SolidColorBrush x:Key="SimGoingBrush"   Color="#42A5F5"/>
        <SolidColorBrush x:Key="SimFinishBrush"  Color="#66BB6A"/>
        <SolidColorBrush x:Key="SimHomingBrush"  Color="#26C6DA"/>
        <SolidColorBrush x:Key="SimTimeoutBrush" Color="#EF5350"/>
        <SolidColorBrush x:Key="SimSystemBrush"  Color="#AB47BC"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SecondaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4">
            <TextBlock Text="Level:" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <ComboBox ItemsSource="{Binding LevelChoices}"
                      SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                      Width="80" Margin="6,0"/>
            <TextBlock Text="(ERROR 항상 표시)" Margin="8,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" FontStyle="Italic"/>
            <CheckBox Content="Simulation 만"
                      IsChecked="{Binding IsSimulationOnly, Mode=TwoWay}"
                      Margin="14,0,0,0" VerticalAlignment="Center"
                      Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="AppLogListBox"
                 b:CtrlWheelZoom.IsEnabled="True"
                 ItemsSource="{Binding View}"
                 Background="{DynamicResource SecondaryBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 FontFamily="Consolas" FontSize="11"
                 BorderThickness="0" SelectionMode="Extended"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.IsDeferredScrollingEnabled="True">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="전체 복사"   Click="AppLogCopyAll_Click"/>
                    <MenuItem Header="선택 복사"   Click="AppLogCopySelected_Click"/>
                    <Separator/>
                    <MenuItem Header="로그 위치 열기" Click="AppLogOpenFolder_Click"/>
                    <MenuItem Header="로그 지우기" Click="AppLogClear_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- AppLogEntry.Display SSOT. 색은 Category 우선, 그다음 Level fallback. -->
                    <TextBlock Text="{Binding Display}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Style.Triggers>
                                    <!-- Level 기반 -->
                                    <DataTrigger Binding="{Binding Level.Name}" Value="DEBUG">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level.Name}" Value="WARN">
                                        <Setter Property="Foreground" Value="{StaticResource LogWarnBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level.Name}" Value="ERROR">
                                        <Setter Property="Foreground" Value="{StaticResource LogErrorBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level.Name}" Value="FATAL">
                                        <Setter Property="Foreground" Value="{StaticResource LogFatalBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <!-- Category 우선 (Simulation 도메인). Level 트리거를 덮어쓴다. -->
                                    <DataTrigger Binding="{Binding Category}" Value="Ready">
                                        <Setter Property="Foreground" Value="{StaticResource SimReadyBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Going">
                                        <Setter Property="Foreground" Value="{StaticResource SimGoingBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Finish">
                                        <Setter Property="Foreground" Value="{StaticResource SimFinishBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Homing">
                                        <Setter Property="Foreground" Value="{StaticResource SimHomingBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Timeout">
                                        <Setter Property="Foreground" Value="{StaticResource SimTimeoutBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="System">
                                        <Setter Property="Foreground" Value="{StaticResource SimSystemBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
