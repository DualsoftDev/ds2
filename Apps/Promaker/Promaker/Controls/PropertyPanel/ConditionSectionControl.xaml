<UserControl x:Class="Promaker.Controls.ConditionSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="clr-namespace:Promaker.Help"
             xmlns:conv="clr-namespace:Promaker.Presentation"
             x:Name="Root">
    <UserControl.Resources>
        <conv:MatchStateToBrushConverter x:Key="MatchToBrush"/>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="0,2,0,4"
            Background="{DynamicResource TertiaryBackgroundBrush}"
            AllowDrop="True"
            DragEnter="Border_DragEnter"
            DragLeave="Border_DragLeave"
            DragOver="Border_DragOver"
            Drop="Border_Drop">
        <StackPanel>
            <!-- Header -->
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" Padding="4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderText, ElementName=Root}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Style="{DynamicResource HelpButton}"
                                Command="{x:Static help:HelpNavigator.NavigateCommand}"
                                CommandParameter="{Binding HelpTopic, ElementName=Root}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="&#x270E;"
                            ToolTip="일괄 편집"
                            Style="{DynamicResource InlineListButton}"
                            Command="{Binding EditConditionsCommand, ElementName=Root}"
                            CommandParameter="{Binding EditConditionsParameter, ElementName=Root}"/>
                </Grid>
            </Border>

            <!-- Condition group list — 각 그룹은 헤더(remove 버튼) + 신호 행들 -->
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border AllowDrop="True"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                DragEnter="ConditionItem_DragEnter"
                                DragLeave="ConditionItem_DragLeave"
                                DragOver="ConditionItem_DragOver"
                                Drop="ConditionItem_Drop"
                                Tag="{Binding}">
                            <StackPanel Margin="4,2">
                                <!-- 그룹 헤더: 삭제 버튼 + 실제 조건 수식 표시. -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="x"
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource InlineListButton}"
                                            ToolTip="조건 그룹 삭제"
                                            Command="{Binding RemoveConditionCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                    <!-- 그룹 부정 토글 — 부정은 leaf 가 아니라 그룹이 진다.
                                         기호(NOT) 대신 «그래서 무슨 일이 일어나는가» 를 적어 수식과 따로 읽히지 않게 한다. -->
                                    <Button Grid.Column="1"
                                            Margin="3,0,0,0"
                                            Padding="5,0"
                                            FontSize="9"
                                            VerticalAlignment="Center"
                                            Content="{Binding InvertLabel}"
                                            ToolTip="{Binding InvertTip}"
                                            Command="{Binding ToggleConditionInvertedCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInverted}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AlwaysLightTextBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource ConditionSkipBadgeBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Column="2"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Loaded="FormulaBlock_Loaded"
                                               DataContextChanged="FormulaBlock_DataContextChanged"/>
                                </Grid>

                                <!-- 그룹 안의 ApiCall 신호 리스트 — 중첩(NOT/AND/OR) 포함 평탄화. -->
                                <ItemsControl ItemsSource="{Binding AllLeafRows}" Margin="14,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="x"
                                                        Style="{DynamicResource InlineListButton}"
                                                        ToolTip="이 ApiCall 제거"
                                                        Command="{Binding RemoveConditionApiCallCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0"
                                                           Text="{Binding ApiDefDisplayName}"
                                                           ToolTip="{Binding ApiDefDisplayName}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="{Binding InputSpecText}"/>
                                                <Button Grid.Column="3"
                                                        Content="ValueSpec"
                                                        Style="{DynamicResource InlineListButton}"
                                                        ToolTip="OutputSpec / InputSpec 편집"
                                                        Command="{Binding EditConditionApiCallSpecCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 시뮬 동작 중 leaf 별 [현재:X / 기대:Y] 표시 — RuntimeText 가 비어있는 row 는 자동 숨김. -->
                                <ItemsControl ItemsSource="{Binding AllLeafRows}" Margin="14,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RuntimeText}"
                                                       FontSize="9"
                                                       FontStyle="Italic"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding IsMatched, Converter={StaticResource MatchToBrush}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RuntimeText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drop hint (shown when empty) -->
            <TextBlock x:Name="DropHint"
                       Text="Tree에서 Call을 여기로 드래그하세요"
                       FontSize="10"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,6"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
