<UserControl x:Class="Promaker.Controls.SystemPlcSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Promaker.Presentation"
             x:Name="Root">
    <!-- System 속성 패널의 "PLC 연결" 섹션 (Active System = PLC 1대).
         DataContext 는 PropertyPanelState(부모 상속). 저장 → store(AID endpoint) 기록 → 파일 저장 시 AASX 에 실림.
         Passive(디바이스) 시스템은 숨김. 연결 방식(Ethernet TCP/UDP · USB)에 따라 IP/Port 행과 USB 행이 갈린다. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="0,2,0,8"
            Visibility="{Binding ShowSystemPlc, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource TertiaryBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SystemPlcHeader}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button Grid.Column="1"
                            Content="저장"
                            ToolTip="LS·SX 벤더: 이 System 의 AID endpoint 에 저장(파일 저장 시 AASX 에 기록) · Mitsubishi: 전역 PLC 연결에 저장"
                            Style="{StaticResource InlineListButton}"
                            Command="{Binding ApplySystemPlcCommand}"
                            IsEnabled="{Binding IsPlcDirty}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="6,6,6,8">
                <!-- 벤더 / 연결 방식 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="벤더" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding PlcVendorChoices}"
                                  SelectedItem="{Binding PlcVendor}"
                                  FontSize="11" Padding="4,2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="연결 방식" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding PlcTransportChoices}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding PlcTransport}"
                                  FontSize="11" Padding="4,2"
                                  ToolTip="Ethernet(TCP) · Ethernet(UDP, Mitsubishi MC 프로토콜 전용) · USB(LS XGI/XGK/XGB 의 CPU 전면 USB 로더 포트). 수집하는 PC(Agent 직접) 또는 Edge 단말(위임)에 PLC 가 USB 로 직결돼 있어야 합니다."/>
                    </StackPanel>
                </Grid>

                <!-- IP / Port — 이더넷 -->
                <Grid Margin="0,6,0,0"
                      Visibility="{Binding IsPlcEthernet, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="IP" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"
                                 ToolTip="예: 192.168.0.10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"
                                 ToolTip="LS 기본 2004 / Mitsubishi 기본 5007 / MICREX-SX 기본 509"/>
                    </StackPanel>
                </Grid>

                <!-- USB 장치 — 선택 키는 AID 에 `xgt+usb://localhost/<키>` 로 저장된다. -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding IsPlcUsb, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="USB 장치 (비우면 첫 장치)" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Padding="4,2" FontSize="11"
                                 Text="{Binding PlcUsbDeviceSelector, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="장치 선택 키 — 목록번호 · serial · bus:addr(예 3:4) · product 부분일치. 비우면 첫 매칭 장치에 붙습니다. Edge 위임 수집이면 Edge 단말에 붙은 장치 기준입니다."/>
                        <Button Grid.Column="1" Content="검색" Margin="4,0,0,0"
                                Style="{StaticResource InlineListButton}"
                                Command="{Binding RefreshPlcUsbDevicesCommand}"
                                ToolTip="이 PC 에 연결된 LS PLC USB 장치를 조회합니다. libusb-1.0 이 실행 폴더에 있어야 하고, XG5000 이 온라인 접속 중이면 포트를 점유합니다."/>
                    </Grid>
                    <ComboBox Margin="0,4,0,0" FontSize="11" Padding="4,2"
                              Visibility="{Binding HasPlcUsbDevices, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding PlcUsbDevices}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding PlcSelectedUsbDevice}"
                              ToolTip="고르면 위 선택 키가 그 장치의 serial(없으면 bus:addr)로 채워집니다."/>
                    <TextBlock Text="{Binding PlcUsbDeviceHint}" FontSize="10"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Scan / Timeout -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Scan (ms)" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcScanIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"
                                 ToolTip="PLC 스캔 주기 (ms)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Timeout (ms)" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- LS 이더넷 전용 -->
                <CheckBox Content="내장 이더넷"
                          FontSize="11" Margin="0,6,0,0"
                          Visibility="{Binding IsPlcLsEthernet, Converter={StaticResource BoolToVis}}"
                          IsChecked="{Binding PlcLocalEthernet}"
                          ToolTip="체크 해제 시 FEnet 모듈"/>

                <!-- MX 전용 -->
                <Grid Margin="0,6,0,0"
                      Visibility="{Binding IsPlcVendorMx, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Network No." FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcNetworkNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"
                                 ToolTip="기본 0 (자국)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Station No." FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding PlcStationNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,2" FontSize="11"
                                 ToolTip="기본 255 (자국 CPU, hex FF)"/>
                    </StackPanel>
                </Grid>

                <!-- SX 전용 — AID InterfaceMicrexSx endpoint 에 저장된다(AASX 에 실림).
                     Promaker.Agent 는 게이트웨이를 AID 에서만 조립하므로, 이 값들이
                     AID 에 있어야 런타임 모니터링이 SX PLC 에 닿는다. -->
                <StackPanel Visibility="{Binding IsPlcVendorSx, Converter={StaticResource BoolToVis}}"
                            Margin="0,8,0,0">
                    <TextBlock Text="I/O 매핑표 (io_map.json)" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Padding="4,2" FontSize="11"
                                 Text="{Binding PlcSxIoMapPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="비우면 네이티브 주소(M1.2000.0 · IO.42.4)만 씁니다. IEC 원격 주소(%QX5.43.0.04)를 쓰려면 D300win 프로젝트에서 뽑은 매핑표가 필요합니다 — 어느 국번이 이미지 몇 번째 워드에 실리는지는 프로토콜로 물어볼 수 없습니다."/>
                        <Button Grid.Column="1" Content="찾아보기" Margin="4,0,0,0"
                                Style="{StaticResource InlineListButton}"
                                Command="{Binding BrowseSxIoMapCommand}"/>
                        <Button Grid.Column="2" Content="해제" Margin="4,0,0,0"
                                Style="{StaticResource InlineListButton}"
                                Command="{Binding ClearSxIoMapCommand}"
                                ToolTip="매핑표 없이 네이티브 주소만 쓰는 상태로 되돌립니다"/>
                    </Grid>

                    <!-- 쓰기 허용 — 토글 하나. 켜면 M1(사용자 메모리)에만 쓴다.
                         I/O 이미지·시스템 메모리는 화면에서 고를 값이 아니다. -->
                    <CheckBox Content="쓰기 허용 (M1 사용자 메모리)" FontSize="11"
                              Margin="0,10,0,0"
                              IsChecked="{Binding PlcSxWriteAllow}"
                              IsEnabled="{Binding IsPlcSxWriteSelectable}"
                              ToolTip="해제하면 SX 커넥터가 쓰기 권한 발급을 거부합니다(읽기 전용). 모니터링 모드에서는 선택할 수 없습니다."/>
                    <TextBlock Text="{Binding PlcSxWriteSummary}" FontSize="10"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="저장하면 이 System 의 AID InterfaceMicrexSx endpoint 에 기록됩니다 — 파일 저장 시 AASX 에 실리고 런타임 모니터링(Agent)이 이 값으로 접속합니다. 같은 System 의 LS XGT endpoint 는 함께 제거됩니다."/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
