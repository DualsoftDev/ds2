<UserControl x:Class="Promaker.Controls.MainToolbarSimulationContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:Ds2.Core;assembly=Ds2.Core"
             xmlns:conv="clr-namespace:Promaker.Presentation"
             xmlns:res="clr-namespace:Promaker.Resources">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainToolbarResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="SimulationSection" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 시뮬레이션 controls (PLAY/PAUSE + Work + 속도) -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!--
                        Monitoring + 실 PLC 모드(IsAgentDelegationMode) 에서는:
                          - 시작 전: Play 아이콘 + "모니터링 시작" (StartSimulationCommand) — Agent Hub 에 접속만 한다.
                            모델/PLC 설정 업로드(active.flag 기록)는 '저장 ▸ Agent에 업로드' 가 전담.
                          - 시작 후: Stop 아이콘 + "정지" (StopSimulationCommand) 로 토글.
                            "정지" 는 Promaker 화면만 끄고 active.flag 유지 → Agent 는 계속 동작(sticky).
                        그 외 모드(Simulation / Control 등) 는 기존 Play↔Stop 토글 유지.
                    -->
                    <Button x:Name="SimulationStartStopButton"
                            IsEnabled="{Binding HasProject}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Command" Value="{Binding Simulation.StartSimulationCommand}"/>
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.StartSimulationTooltip}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IconGreenBrush}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                            <Condition Binding="{Binding Simulation.IsSimPaused}" Value="False"/>
                                            <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Command" Value="{Binding Simulation.StopSimulationCommand}"/>
                                        <Setter Property="ToolTip" Value="{x:Static res:Strings.StopSimulationTooltip}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource IconRedBrush}"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True">
                                        <Setter Property="Command" Value="{Binding Simulation.StartSimulationCommand}"/>
                                        <Setter Property="ToolTip" Value="모니터링 명령을 Promaker.Agent 로 전송하고 DSPilot 대시보드를 띄웁니다."/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <!-- 모니터링 시작 후 같은 버튼을 "정지"로 토글. 정지 = Promaker 화면만 끔, active.flag 유지 → Agent 계속 동작. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True"/>
                                            <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Command" Value="{Binding Simulation.StopSimulationCommand}"/>
                                        <Setter Property="ToolTip" Value="모니터링 정지 — Promaker 모니터링 화면을 닫습니다. (Promaker.Agent 는 계속 동작합니다.)"/>
                                        <Setter Property="Foreground" Value="{DynamicResource IconRedBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Vertical">
                            <Grid Width="18" Height="18">
                                <iconPacks:PackIconMaterial Kind="Play"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- Sim/Control: 실행 중(비일시정지) → Play 숨김 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                        <Condition Binding="{Binding Simulation.IsSimPaused}" Value="False"/>
                                                        <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <!-- Monitoring 실행 중 → Play 숨김 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True"/>
                                                        <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                                <iconPacks:PackIconMaterial Kind="Stop"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <!-- Sim/Control: 실행 중(비일시정지) → Stop 표시 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                        <Condition Binding="{Binding Simulation.IsSimPaused}" Value="False"/>
                                                        <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <!-- Monitoring 실행 중 → Stop 표시 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True"/>
                                                        <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                            </Grid>
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RibbonIconLabel}">
                                        <Setter Property="Text" Value="PLAY"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                    <Condition Binding="{Binding Simulation.IsSimPaused}" Value="False"/>
                                                    <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="STOP"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True">
                                                <Setter Property="Text" Value="모니터링 시작"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True"/>
                                                    <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="정지"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SimulationPauseStepButton"
                            IsEnabled="{Binding HasProject}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Command" Value="{Binding Simulation.PauseSimulationCommand}"/>
                                <Setter Property="ToolTip" Value="{x:Static res:Strings.PauseSimulationTooltip}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IconOrangeBrush}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Simulation.IsSimPaused}" Value="True">
                                        <Setter Property="Command" Value="{Binding Simulation.StepSimulationCommand}"/>
                                        <Setter Property="ToolTip" Value="한 단계 실행"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <!-- Monitoring + 실 PLC (Agent 위임 모드) 에서는 Pause/Step 의미 없음 — 숨김. -->
                                    <DataTrigger Binding="{Binding Simulation.IsAgentDelegationMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Vertical">
                            <Grid Width="18" Height="18">
                                <iconPacks:PackIconMaterial Kind="Pause"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Simulation.IsSimPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                                <iconPacks:PackIconMaterial Kind="SkipNext"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Simulation.IsSimPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                            </Grid>
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RibbonIconLabel}">
                                        <Setter Property="Text" Value="PAUSE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Simulation.IsSimPaused}" Value="True">
                                                <Setter Property="Text" Value="STEP"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- 원위치(Homing) — Control 모드 + 실 PLC 연결 시에만 가시. Push-button: 누르고 있는 동안만 진행, 떼면 즉시 종료(deadman switch). -->
                    <Button x:Name="SimulationHomingButton"
                            ToolTip="{x:Static res:Strings.HomingTooltip}"
                            Visibility="{Binding Simulation.IsHomingButtonVisible, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding Simulation.IsHomingButtonHotEnabled}"
                            PreviewMouseLeftButtonDown="HomingButton_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="HomingButton_Release"
                            LostMouseCapture="HomingButton_Release">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <!-- 누름 상태: 빨간 강조 + 굵은 테두리 (deadman switch 임을 시각적으로 강조) -->
                                    <DataTrigger Binding="{Binding Simulation.IsHomingPressed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource IconRedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource IconRedBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Vertical">
                            <iconPacks:PackIconMaterial Kind="HomeImportOutline"
                                                        Width="18" Height="18"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RibbonIconLabel}">
                                        <Setter Property="Text" Value="원위치(Hold)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Simulation.IsHomingPressed}" Value="True">
                                                <Setter Property="Text" Value="진행중..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- 수동 컨트롤러 — Control + 실 PLC 연결 시에만 가시. 클릭하면 modeless 다이얼로그가 열려 디바이스별로 직접 ON/OFF 제어. -->
                    <Button x:Name="SimulationManualControlButton"
                            Click="ManualControlButton_Click"
                            ToolTip="{x:Static res:Strings.ManualControlTooltip}"
                            Visibility="{Binding Simulation.IsManualControlButtonVisible, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding Simulation.IsManualControlButtonHotEnabled}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Simulation.IsManualControlActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource IconRedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource IconRedBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Vertical">
                            <iconPacks:PackIconMaterial Kind="GestureTapButton"
                                                        Width="18" Height="18"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RibbonIconLabel}">
                                        <Setter Property="Text" Value="수동"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Simulation.IsManualControlActive}" Value="True">
                                                <Setter Property="Text" Value="활성"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <iconPacks:PackIconMaterial Kind="Autorenew"
                                                Width="12" Height="12"
                                                VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                SpinDuration="1.5"
                                                Foreground="{DynamicResource IconOrangeBrush}">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Spin" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Simulation.IsHomingPhase}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Spin" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding Simulation.SimStatusText}"
                               FontSize="9"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource IconRedBrush}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                            <Condition Binding="{Binding Simulation.IsSimPaused}" Value="False"/>
                                            <Condition Binding="{Binding Simulation.IsHomingPhase}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource IconGreenBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Simulation.IsSimulating}" Value="True"/>
                                            <Condition Binding="{Binding Simulation.IsSimPaused}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource IconOrangeBrush}"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.SimStatusText}" Value="시뮬레이션 단계 제어 중">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.IsHomingPhase}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource IconOrangeBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="PulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True" FillBehavior="Stop">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.55" Duration="0:0:0.9"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Work / 속도 / 연속투입 통합 grid: 같은 grid 의 row 라서 라벨/콤보가 자동으로 같은 가로선에 정렬됨 -->
            <Grid Margin="22,0,0,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding HasProject}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Work 칸 -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Work" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                <ComboBox Grid.Column="0" Grid.Row="1"
                          x:Name="SimWorkComboBox"
                          ItemsSource="{Binding Simulation.SimWorkItems}"
                          SelectedItem="{Binding Simulation.SelectedSimWork}"
                          Width="130"
                          MinHeight="24"
                          FontSize="11"/>
                <UniformGrid Grid.Column="0" Grid.Row="2" Columns="2" Margin="0,1,0,0">
                    <Button x:Name="ForceWorkStartButton"
                            Command="{Binding Simulation.ForceWorkStartCommand}"
                            ToolTip="{x:Static res:Strings.ForceWorkStartTooltip}"
                            IsEnabled="{Binding HasProject}"
                            Margin="0,0,2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Foreground" Value="{DynamicResource IconGreenBrush}"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="START"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ForceWorkResetButton"
                            Command="{Binding Simulation.ForceWorkResetCommand}"
                            ToolTip="{x:Static res:Strings.ForceWorkResetTooltip}"
                            IsEnabled="{Binding HasProject}"
                            Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Foreground" Value="{DynamicResource IconOrangeBrush}"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="RESET"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </UniformGrid>

                <!-- 속도 칸 (좌측 22px 간격은 column 1 자식들의 좌측 Margin 으로 부여) -->
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Static res:Strings.Speed}" FontSize="9" HorizontalAlignment="Center" Margin="22,0,0,1"/>
                <ComboBox Grid.Column="1" Grid.Row="1"
                          x:Name="SimSpeedComboBox"
                          SelectedValue="{Binding Simulation.SimSpeed}"
                          SelectedValuePath="Tag"
                          Width="110"
                          MinHeight="24"
                          FontSize="11"
                          HorizontalContentAlignment="Center"
                          Margin="22,0,0,0">
                    <ComboBoxItem Content="0.5x"><ComboBoxItem.Tag><sys:Double>0.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                    <ComboBoxItem Content="1x"><ComboBoxItem.Tag><sys:Double>1.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                    <ComboBoxItem Content="2x"><ComboBoxItem.Tag><sys:Double>2.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                    <ComboBoxItem Content="5x"><ComboBoxItem.Tag><sys:Double>5.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                    <ComboBoxItem Content="10x"><ComboBoxItem.Tag><sys:Double>10.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                </ComboBox>
                <!-- Token + 연속투입 — 같은 StackPanel 에 묶어 baseline/padding 일관 정렬 (column 1+2 RowSpan 방식) -->
                <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="22,1,0,0">
                    <Button x:Name="OpenTokenSpecButton"
                            Command="{Binding OpenTokenSpecDialogCommand}"
                            IsEnabled="{Binding HasProject}"
                            ToolTip="TokenSpec 편집"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                                <Setter Property="Foreground" Value="{DynamicResource IconGrayBrush}"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="11" Height="11"
                                                        VerticalAlignment="Center" Margin="0,0,3,0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Token" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <!-- 연속투입: Token 과 같은 padding/외곽선/baseline. IsChecked=True 일 때 AccentBrush 배경 + 흰글씨로 "눌린 이펙트". -->
                    <!-- Monitoring 또는 Control+실 PLC 일 때는 외부 owner 가 토큰 투입 — 비활성. HasProject 게이트는 부모 Grid 가 처리. -->
                    <ToggleButton x:Name="ContinuousInjectionToggle"
                                  IsChecked="{Binding Simulation.ContinuousInjection.IsEnabled}"
                                  IsEnabled="{Binding Simulation.ContinuousInjection.IsAvailable}"
                                  Margin="6,0,0,0"
                                  ToolTip="Source START 후 Ready 복귀 시 다음 토큰을 자동으로 다시 투입합니다. (Monitoring / Control+실 PLC 에서는 비활성)">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource IconGrayBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Repeat" Width="10" Height="10"
                                                        VerticalAlignment="Center" Margin="0,0,3,0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <TextBlock Text="연속투입" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 시뮬레이션 / 런타임 구분선 — 다른 ribbon 섹션과 동일 스타일/길이 (라벨 row 까지 RowSpan=2) -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                Style="{StaticResource RibbonSectionSeparator}"/>

        <!-- 런타임 controls (Runtime 버튼 + 모드/Hub 입력) -->
        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button x:Name="RuntimeSettingButton"
                        Command="{Binding ShowRuntimeSettingsCommand}"
                        IsEnabled="{Binding HasProject}"
                        ToolTip="런타임 설정 (Runtime Mode · Variant · Theme)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RibbonFlatButton}">
                            <Setter Property="Foreground" Value="{DynamicResource IconGrayBrush}"/>
                            <Setter Property="MinWidth" Value="56"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Runtime" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Vertical"
                        Margin="12,0,0,0"
                        MinWidth="130"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Simulation.SelectedRuntimeMode}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <!-- Hub 모드(Control/Monitoring/VP) status dot -->
                    <Ellipse Width="8" Height="8" Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding Simulation.NeedsHubConnection, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding Simulation.Hub.StatusText}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource IconRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Simulation.Hub.IsReconnecting}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource IconOrangeBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.Hub.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource IconGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- PR-A4 — Simulation(In-Process) 모드 status dot. IsSimulating=true → 초록 / 일시정지 → 주황 / 정지 → 회색.
                         Hub 가 없어 NeedsHubConnection 가 false 일 때만 표시 (Control/Monitoring 표시와 배타). -->
                    <Ellipse Width="8" Height="8" Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="{Binding Simulation.SimStatusText}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Fill" Value="{DynamicResource IconGrayBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Simulation.NeedsHubConnection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.IsSimulating}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource IconGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Simulation.IsSimPaused}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource IconOrangeBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
                <!-- Hub 모드 — Self-Hosted 배지 (Control/Monitoring 일 때만 노출) -->
                <TextBlock Text="{Binding Simulation.Hub.HostingLabel}"
                           FontSize="9"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0"
                           Visibility="{Binding Simulation.Hub.IsHubHost, Converter={StaticResource BoolToVis}}"/>
                <!-- PR-A4 — Simulation(In-Process) 모드 배지 — Hub 미사용임을 표시. 다른 모드의 Self-Hosted 배지와 시각 정합. -->
                <TextBlock Text="In-Process"
                           FontSize="9"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Simulation.NeedsHubConnection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding Simulation.Hub.EffectiveHubAddress, UpdateSourceTrigger=PropertyChanged}"
                         Width="130" MinHeight="24" FontSize="11"
                         Margin="0,3,0,0"
                         Padding="6,2"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding Simulation.CanChangeMode}"
                         ToolTip="Hub 주소 (host:port) — Agent 단일 호스팅이라 Control/Monitoring/VP 모두 localhost:5051"
                         Visibility="{Binding Simulation.NeedsHubConnection, Converter={StaticResource BoolToVis}}"/>
                <!-- PR-A4 — Simulation 모드 동작 시간 (SimClock: HH:mm:ss.fff). Hub 주소 textbox 와 동일 위치/높이.
                     모드 전환 시 한쪽만 노출되어 라인 정렬 유지. SimStatusText (Stopped / Running / Paused) 는 dot ToolTip 으로 노출. -->
                <TextBlock Text="{Binding Simulation.SimClock}"
                           FontSize="12" FontFamily="Consolas"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"
                           MinHeight="24"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           ToolTip="시뮬레이션 동작 시간">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Simulation.NeedsHubConnection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 테스트 전용 — 수신 신호 차단 토글: 연결 유지한 채 태그 수신만 무시해
                     "장비는 도는데 신호만 안 보이는" 통신 두절을 재현. coast/재합류 검증용.
                     DEBUG 빌드 + 허브 모드에서만 노출(릴리즈 현장 오조작 방지). -->
                <CheckBox Content="통신 차단(테스트)"
                          IsChecked="{Binding Simulation.Hub.TestSignalBlocked, Mode=TwoWay}"
                          Visibility="{Binding Simulation.ShowCommBlockTestToggle, Converter={StaticResource BoolToVis}}"
                          FontSize="10"
                          Margin="0,4,0,0"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          ToolTip="[테스트] 수신 신호를 무시해 통신 두절을 재현합니다. 해제하면 현재 위치의 신호부터 다시 수신합니다."/>
                <!-- issue #154: Monitoring(실 PLC) 시작 시 DSPilot 자동 오픈 여부 토글. IsAgentDelegationMode 일 때만 노출. -->
                <CheckBox Content="DsPilot으로 실행"
                          IsChecked="{Binding Simulation.LaunchDspilotOnMonitoring, Mode=TwoWay}"
                          Visibility="{Binding Simulation.IsAgentDelegationMode, Converter={StaticResource BoolToVis}}"
                          FontSize="10"
                          Margin="0,4,0,0"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          ToolTip="모니터링 시작 시 DSPilot 웹 대시보드를 자동으로 엽니다. 끄면 모니터링만 시작합니다."/>
            </StackPanel>
        </StackPanel>

        <!-- 섹션 라벨: 시뮬레이션 / 런타임 (각자 칸 중앙 정렬) -->
        <TextBlock Grid.Column="0" Grid.Row="1" Text="시뮬레이션" Style="{StaticResource RibbonSectionLabel}"/>
        <TextBlock Grid.Column="2" Grid.Row="1" Text="런타임" Style="{StaticResource RibbonSectionLabel}"/>
    </Grid>
</UserControl>
