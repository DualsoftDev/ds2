<Window x:Class="Promaker.Dialogs.KbManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Promaker.Behaviors"
        Title="Knowledge Base 관리"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            b:CtrlWheelZoom.IsEnabled="True">
        <Border.Resources>
            <!-- s5c-r1 — ListView GridViewColumnHeader 의 default light theme 차단. dark resource brush 정합. -->
            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
        </Border.Resources>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header chip — service 연결 상태 -->
            <TextBlock x:Name="StatusChip" Grid.Row="0"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="LightHouse Service 상태 확인 중…"/>

            <!-- 등록된 collection 목록 헤더 + Refresh + Orphan 정리 (D-S7-3c) -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="등록된 Collection (Active = chat 진입 시 검색 대상)"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="새로고침"
                        Style="{StaticResource DarkButton}"
                        Padding="10,2" Click="Refresh_Click"/>
                <Button Grid.Column="3" x:Name="OrphanCleanupButton" Content="orphan 정리"
                        Style="{StaticResource DarkButton}"
                        Padding="10,2" Click="OrphanCleanup_Click"
                        Visibility="Collapsed"
                        ToolTip="삭제된 service 에 속한 collection 을 정리합니다."/>
            </Grid>

            <!-- D-S7-3c (s6-r31) — Service TabControl. 각 tab = active service. tab 변경 시 CollectionsList ItemsSource 갱신. -->
            <TabControl Grid.Row="2" x:Name="ServicesTabControl"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Margin="0,0,0,4"
                        MinHeight="32"
                        SelectionChanged="ServiceTab_SelectionChanged"/>

            <!-- collection ListView -->
            <ListView Grid.Row="3" x:Name="CollectionsList"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource SecondaryBackgroundBrush}"
                      Margin="0,0,0,8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Active" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Active, Mode=TwoWay}"
                                              Checked="ActiveToggle_Changed"
                                              Unchecked="ActiveToggle_Changed"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="이름" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="상태" Width="80" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="파일" Width="60" DisplayMemberBinding="{Binding FileCount}"/>
                        <GridViewColumn Header="Indexer" Width="80" DisplayMemberBinding="{Binding IndexerVersion}"/>
                        <GridViewColumn Header="작업" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="재업로드"
                                                Style="{StaticResource DarkButton}"
                                                Padding="6,1" Margin="0,0,4,0"
                                                Tag="{Binding}"
                                                Click="Reupload_Click"/>
                                        <Button Content="제거"
                                                Style="{StaticResource DarkButton}"
                                                Padding="6,1"
                                                Tag="{Binding}"
                                                Click="Delete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 새 폴더 등록 영역 -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="새 Collection 등록 (폴더 → 색인 → 업로드)"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="폴더" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1" x:Name="NewFolderBox"
                                 Padding="6,4" FontFamily="Consolas" FontSize="11"
                                 ToolTip="등록할 폴더의 절대경로"/>
                        <Button Grid.Column="3" Content="…"
                                Style="{StaticResource DarkButton}"
                                Padding="10,4" Click="BrowseFolder_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="이름" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1" x:Name="NewTitleBox"
                                 Padding="6,4" FontSize="11"
                                 ToolTip="사용자 표시 이름 (collection 식별용, 모든 사용자에게 노출)"/>
                        <Button Grid.Column="3" x:Name="RegisterButton" Content="등록 시작"
                                Style="{StaticResource DarkButton}"
                                Padding="10,4" Click="Register_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 진행률 영역 (작업 중에만 표시) -->
            <Grid Grid.Row="5" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ProgressLabel"
                               FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="취소"
                            Style="{StaticResource DarkButton}"
                            Padding="10,2" Click="Cancel_Click"/>
                </Grid>
                <ProgressBar Grid.Row="1" x:Name="ProgressBarMain"
                             Height="6" Minimum="0" Maximum="1" Value="0"/>
            </Grid>

            <!-- 닫기 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기"
                        Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
