<Window x:Class="Promaker.Dialogs.ApplicationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Promaker.Behaviors"
        xmlns:dlg="clr-namespace:Promaker.Dialogs"
        Title="설정"
        Width="900" Height="720"
        MinWidth="560" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            b:CtrlWheelZoom.IsEnabled="True">
        <Border.Resources>
            <!-- dark theme 정합 — TextBox/PasswordBox default light style 차단. -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <!-- 버튼 다크 정합 — 기본 light 버튼 차단 (로그인/로그아웃/확인/취소 공통) -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 탭 컨트롤 -->
            <TabControl x:Name="SettingsTabControl" Grid.Row="0" Margin="0,0,0,10">
                <!-- 탭 0: 일반 (앱 전반 설정 — 테마 / 레이아웃 초기화) -->
                <TabItem Header="일반">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <!-- 테마 -->
                            <TextBlock Text="테마"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton x:Name="ThemeDarkRadio" Content="다크"
                                             GroupName="Theme"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,16,0"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeLightRadio" Content="라이트"
                                             GroupName="Theme"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             VerticalContentAlignment="Center"
                                             Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                            <TextBlock Text="선택 즉시 적용됩니다."
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,20" FontStyle="Italic"/>

                            <!-- Dock 레이아웃 초기화 -->
                            <TextBlock Text="Dock 레이아웃"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8">
                                저장된 dock 패널 배치를 삭제합니다. 다음 실행 시 기본 레이아웃으로 시작됩니다.
                            </TextBlock>
                            <Button Content="레이아웃 초기화"
                                    Style="{StaticResource DarkButton}"
                                    Padding="12,6" HorizontalAlignment="Left"
                                    Click="ResetLayout_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 1: AASX -->
                <TabItem Header="AASX">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <!-- IRI Prefix -->
                            <TextBlock Text="IRI Prefix"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="IriPrefixBox" Padding="6,4" Margin="0,0,0,2"/>
                            <TextBlock Text="Global Asset ID는 IRI Prefix + 프로젝트 이름으로 자동 생성됩니다"
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" FontStyle="Italic"/>

                            <!-- SplitDeviceAasx -->
                            <CheckBox x:Name="SplitDeviceAasxBox"
                                      Content="Device System을 별도 AASX 파일로 분리 저장"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="저장 시 {파일명}_devices/ 폴더에 Device별 AASX를 생성합니다"
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="20,0,0,16" FontStyle="Italic"/>

                            <!-- CreateDefaultEntitiesOnEmptyAasx -->
                            <CheckBox x:Name="CreateDefaultEntitiesBox"
                                      Content="AASX 저장 시 빈 서브모델 Properties 자동 생성"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="저장할 때 엔티티에 도메인 서브모델 Properties가 없으면 자동으로 생성합니다 (Simulation, Control, Monitoring 등)"
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="20,0,0,16" FontStyle="Italic" TextWrapping="Wrap"/>

                            <!-- EmbedPlcConnectionInAasx -->
                            <CheckBox x:Name="EmbedPlcConnectionBox"
                                      Content="AASX 저장 시 PLC 접속 정보 포함"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="현재 PLC 설정(벤더/IP/포트)을 프로젝트 파일에 함께 저장합니다. 다른 PC에서 열어도 그 PC에 남아 있던 IP가 아니라 프로젝트에 저장된 IP가 적용됩니다. 끄면 내부망 IP가 외부로 전달되는 파일에 실리지 않습니다"
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="20,0,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 2: PLC -->
                <TabItem Header="PLC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <!-- 신호 템플릿은 AASX 내 FBTagMapPresets 로 완전 이전됨 (외부 파일 불필요). -->
                            <!-- FBTagMap 설정은 IO Wizard 내부로 이전됨 (B안: IoList = 단일 진실원) -->

                            <!-- XGI 템플릿 파일 -->
                            <TextBlock Text="XGI 템플릿 파일"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PlcXgiTemplatePathBox" Grid.Column="0"
                                         Padding="6,4" FontFamily="Consolas" FontSize="11"/>
                                <Button Grid.Column="2" Content="..."
                                        Style="{StaticResource DarkButton}"
                                        Padding="10,4" Click="BrowsePlcXgiTemplate_Click"/>
                            </Grid>
                            <TextBlock Text="XGI_Template.xml 경로 (필수) — 비우면 자동으로 디폴트 경로로 복원됩니다."
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" FontStyle="Italic"/>

                            <!-- XG5000 실행 파일 -->
                            <TextBlock Text="XG5000 실행 파일"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PlcXg5000ExePathBox" Grid.Column="0"
                                         Padding="6,4" FontFamily="Consolas" FontSize="11"/>
                                <Button Grid.Column="2" Content="..."
                                        Style="{StaticResource DarkButton}"
                                        Padding="10,4" Click="BrowsePlcXg5000Exe_Click"/>
                            </Grid>
                            <TextBlock Text="XG5000.exe 경로 (필수) — 비우면 자동으로 기본 설치 경로로 복원됩니다."
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>


                <!-- 탭 3: OPC UA (서버) — Promaker 가 EmbeddedUaServer 를 인프로세스 호스팅 -->
                <TabItem Header="OPC UA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel x:Name="OpcUaTabRoot">
                            <!-- 사용/안사용 토글 · 나머지 필드는 이 체크박스에 바인딩된 IsEnabled 로 dim. -->
                            <CheckBox x:Name="OpcUaEnabledBox"
                                      Content="런타임 시작 시 OPC UA 서버 구동"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="체크 해제 시 서버를 기동하지 않습니다. 아래 설정은 체크된 경우에만 적용됩니다."
                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="20,0,0,16" FontStyle="Italic" TextWrapping="Wrap"/>

                            <StackPanel x:Name="OpcUaFieldsPanel"
                                        IsEnabled="{Binding IsChecked, ElementName=OpcUaEnabledBox}">
                                <TextBlock Text="Endpoint URL (서버 바인딩)"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="OpcUaEndpointUrlBox" Padding="6,4" Margin="0,0,0,2"
                                         FontFamily="Consolas" FontSize="11"/>
                                <TextBlock Text="예: opc.tcp://localhost:62541/Ds2/OpcUa/Server"
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,16" FontStyle="Italic"/>

                                <!-- Application 식별 -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Application Name"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaApplicationNameBox" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Application URI"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaApplicationUriBox" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 세션 상한 · 타임아웃 -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="최대 세션 수"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaMaxSessionsBox" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="세션 타임아웃 (ms)"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaSessionTimeoutBox" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Sampling · Publishing 인터벌 -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="최소 Sampling (ms)"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaMinSamplingIntervalBox" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="기본 Sampling (ms)"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaDefaultSamplingIntervalBox" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Publishing (ms)"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBox x:Name="OpcUaPublishingIntervalBox" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="OpcUaAllowAnonymousBox"
                                          Content="Anonymous 세션 허용 (개발 편의)"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="운영에서는 해제하고 UserName/Certificate 인증만 허용하세요."
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="20,0,0,12" FontStyle="Italic" TextWrapping="Wrap"/>

                                <CheckBox x:Name="OpcUaAutoAcceptCertsBox"
                                          Content="클라이언트 인증서 자동 신뢰 (개발 편의)"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="운영에서는 반드시 해제하고 신뢰 인증서를 %AppData%\Dualsoft\Promaker\OpcUa\certs\trusted 에 배치하세요."
                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="20,0,0,4" FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 탭 4: 프리셋 -->
                <TabItem Header="프리셋">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 프리셋/SystemType 입력 패널 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 프리셋 입력 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="프리셋" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="PresetTextBox" Padding="6,4"/>
                            </StackPanel>

                            <!-- SystemType 입력 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SystemType" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="SystemTypeTextBox" Padding="6,4" Text="Motor"/>
                            </StackPanel>

                            <!-- 추가 버튼 -->
                            <Button Grid.Column="4" Content="추가"
                                    Style="{StaticResource DarkButton}"
                                    Padding="12,4" VerticalAlignment="Bottom"
                                    Click="AddPreset_Click"/>

                            <!-- 제거 버튼 -->
                            <Button Grid.Column="6" Content="제거"
                                    Style="{StaticResource DarkButton}"
                                    Padding="12,4" VerticalAlignment="Bottom"
                                    Click="RemovePreset_Click"/>
                        </Grid>

                        <!-- 매핑 리스트 + 순서 조절 버튼 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0" x:Name="PresetMappingListBox"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Background="{DynamicResource SecondaryBackgroundBrush}"
                                     SelectionChanged="PresetMappingListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 순서 조절 버튼 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="▲"
                                        Style="{StaticResource DarkButton}"
                                        Padding="8,2" Margin="0,0,0,4"
                                        ToolTip="위로 이동"
                                        Click="MoveUp_Click"/>
                                <Button Content="▼"
                                        Style="{StaticResource DarkButton}"
                                        Padding="8,2"
                                        ToolTip="아래로 이동"
                                        Click="MoveDown_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- 탭 4: 클라우드(PV) 계정 -->
                <TabItem Header="클라우드 계정">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="클라우드(PV) 계정"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="PvStatusText" Text="로그인되지 않음"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PvLoginButton" Content="로그인" Width="110" Padding="8,4"
                                        Click="PvLoginButton_Click"/>
                                <Button x:Name="PvLogoutButton" Content="로그아웃" Width="110" Margin="8,0,0,0" Padding="8,4"
                                        Click="PvLogoutButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="로그인 세션은 앱을 닫으면 해제됩니다 (자동 로그인 없음). 서버 주소는 설치본에 내장됩니다."
                                       FontSize="10" FontStyle="Italic"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Buttons (ScrollViewer 밖에 배치) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="12,4" Margin="0,0,4,0"
                        Click="Ok_Click" IsDefault="True"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
