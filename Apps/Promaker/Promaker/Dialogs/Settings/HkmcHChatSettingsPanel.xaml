<UserControl x:Class="Promaker.Dialogs.HkmcHChatSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- 제목 -->
        <TextBlock Text="H-Chat (HKMC 사내망) — Personal API Key 모드"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="0,16,0,8"/>

        <!-- Base URL -->
        <TextBlock Text="Base URL" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
        <TextBox x:Name="HkmcBaseUrlBox" Padding="6,4" FontFamily="Consolas" Margin="0,0,0,2"
                 ToolTip="운영: https://internal-apigw-kr.hmg-corp.io/hchat-in/api / 검증/개발 환경은 직접 수정"/>
        <TextBlock Text="default = 운영 (https://internal-apigw-kr.hmg-corp.io/hchat-in/api). 검증/개발 환경은 직접 수정."
                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,12" FontStyle="Italic" TextWrapping="Wrap"/>

        <!-- API Key (DPAPI) -->
        <TextBlock Text="H-Chat API Key (DPAPI 암호화 저장)" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="HkmcApiKeyBox" Grid.Column="0" Padding="6,4" FontFamily="Consolas"/>
            <Button Grid.Column="2" Content="지우기"
                    Style="{StaticResource DarkButton}"
                    Padding="10,4" Click="HkmcClearKey_Click"/>
        </Grid>
        <TextBlock Text="Personal API Key. Project ID 는 사용하지 않습니다 (결정 #2 정합)."
                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,12" FontStyle="Italic" TextWrapping="Wrap"/>

        <!-- Claude Model -->
        <TextBlock Text="Claude Model ID" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
        <TextBox x:Name="HkmcClaudeModelBox" Padding="6,4" FontFamily="Consolas" Margin="0,0,0,2"
                 ToolTip="예: claude-sonnet-4-6 (사용자 입력 필수, default 빈 문자열)"/>
        <TextBlock Text="예: claude-sonnet-4-6 (사용자 입력 필수)"
                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,12" FontStyle="Italic"/>

        <!-- OpenAI Model -->
        <TextBlock Text="OpenAI Model ID" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
        <TextBox x:Name="HkmcOpenAiModelBox" Padding="6,4" FontFamily="Consolas" Margin="0,0,0,2"
                 ToolTip="예: gpt-5 (Azure deployment name, 사용자 입력 필수)"/>
        <TextBlock Text="예: gpt-5 (Azure deployment name, 사용자 입력 필수)"
                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,12" FontStyle="Italic"/>

        <!-- 안내 -->
        <TextBlock TextWrapping="Wrap"
                   FontSize="10" FontStyle="Italic"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,4,0,16"
                   Text="본 패널은 사내망 (현대/기아) 환경에서만 사용합니다. ENABLE_HKMC 환경변수가 설정된 상태에서만 표시됩니다."/>
    </StackPanel>
</UserControl>
