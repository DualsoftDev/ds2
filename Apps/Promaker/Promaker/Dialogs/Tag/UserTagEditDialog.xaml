<Window x:Class="Promaker.Dialogs.UserTagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용자 태그 편집"
        Width="440" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 이름 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="이름"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <TextBox x:Name="NameBox" Padding="6,4"/>
            </StackPanel>

            <!-- 로그 레벨 — 사용자 태그는 모두 Error 로 취급(운영 정책). Warning/Info 는 존재하지만 미사용. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="로그 레벨"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>
                <Border Background="{DynamicResource TertiaryBackgroundBrush}"
                        Padding="8,4" CornerRadius="3" HorizontalAlignment="Left">
                    <TextBlock Text="Error (고정 — 사용자 태그는 모두 Error 로 취급)"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- 태그 주소 -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="태그 주소"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <TextBox x:Name="AddressBox" Padding="6,4"/>
            </StackPanel>

            <!-- 값 타입 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="값 타입"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <ComboBox x:Name="ValueTypeCombo" Padding="6,4"
                          SelectionChanged="ValueTypeCombo_SelectionChanged"/>
            </StackPanel>

            <!-- 매칭 조건 -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Text="매칭 조건 (어떤 값에서 알림 발생)"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MatchOpCombo" Grid.Column="0" Padding="6,4"
                              SelectionChanged="MatchOpCombo_SelectionChanged"/>
                    <TextBox x:Name="MatchValueBox" Grid.Column="2" Padding="6,4"
                             ToolTip="비교에 사용할 기준값 (Bit는 0/1, 수치형은 숫자, 문자열형은 문자열)"
                             TextChanged="MatchValueBox_TextChanged"/>
                </Grid>
            </StackPanel>

            <!-- 미리보기 -->
            <Border Grid.Row="5"
                    Background="{DynamicResource TertiaryBackgroundBrush}"
                    Padding="8,6" Margin="0,0,0,8" CornerRadius="3">
                <TextBlock x:Name="PreviewText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="12,4" Margin="0,0,4,0"
                        Click="Ok_Click" IsDefault="True"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
