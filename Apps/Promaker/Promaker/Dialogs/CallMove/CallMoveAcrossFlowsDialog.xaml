<Window x:Class="Promaker.Dialogs.CallMoveAcrossFlowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow 간 Call 이동/복사"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <StackPanel Margin="14">
            <TextBlock x:Name="HeaderText"
                       FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="대상 Flow 의 Device System 을 어떻게 처리할지 선택하세요."
                       FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,12"/>

            <StackPanel Margin="0,0,0,4">
                <RadioButton x:Name="RadioClone"
                             GroupName="DeviceMode"
                             Content="Device System 복사 (기본)"
                             IsChecked="True"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             FontWeight="SemiBold"
                             Margin="0,0,0,2"/>
                <TextBlock Text="{}{대상Flow}_{devAlias} 이름으로 새 Device System + ApiDef 복제. 가장 안전한 선택."
                           FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="20,0,0,10" TextWrapping="Wrap"/>

                <RadioButton x:Name="RadioRename"
                             GroupName="DeviceMode"
                             Content="Prefix 교체 (Device 재사용)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             FontWeight="SemiBold"
                             Margin="0,0,0,2"/>
                <TextBlock Text="원본 Device System 의 이름을 {대상Flow}_{devAlias} 로 변경. 다른 Flow Call 이 같은 Device 를 공유하지 않을 때만 가능."
                           FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="20,0,0,10" TextWrapping="Wrap"/>

                <RadioButton x:Name="RadioKeep"
                             GroupName="DeviceMode"
                             Content="Device 참조 유지"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             FontWeight="SemiBold"
                             Margin="0,0,0,2"/>
                <TextBlock Text="Device System 손대지 않음. 새 Call 이 원본 Device 의 ApiDef 를 그대로 참조 (=두 Flow 가 같은 Device 공유)."
                           FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="20,0,0,12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="14,4" Margin="0,0,6,0"
                        Click="OnOk_Click" IsDefault="True"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="14,4" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
