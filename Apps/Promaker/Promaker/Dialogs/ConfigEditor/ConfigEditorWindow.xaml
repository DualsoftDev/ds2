<Window x:Class="Promaker.Dialogs.ConfigEditor.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Input Matching Config"
        Height="760" Width="1260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SecondaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4,4,0,0"
                                Margin="2,0,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Input Matching Config" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="기본 탭은 모델 생성 결과에 직접 영향이 큰 항목만 노출합니다. 전체 JSON은 고급 탭에서 직접 수정할 수 있습니다."
                       Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="기본" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Flow 선택" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="기본 선택 Flow: 비우면 전체 Flow, 채우면 매칭되는 Flow만 모델로 생성. 제외 Flow 키워드: 매칭되는 Flow는 결과에서 제외. 한 줄에 하나씩 입력."
                                                   Style="{StaticResource HintTextStyle}"/>
                                        <TextBlock Text="와일드카드: *HOP* = HOP 포함(HOP1·HOP2…) · HOP* = HOP 로 시작 · *HOP = HOP 로 끝 · HOP = 정확히 HOP 만"
                                                   Style="{StaticResource HintTextStyle}" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                                        <TextBlock Text="기본 선택 Flow"/>
                                        <TextBox Text="{Binding FlowInclusions, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="92"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                                        <TextBlock Text="제외 Flow 키워드"/>
                                        <TextBox Text="{Binding FlowKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="92"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="이름 분해" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="CSV 변수명을 Flow / Work / Call로 나누는 핵심 옵션입니다. 우측 미리보기로 결과를 확인하세요."
                                                   Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                                        <TextBlock Text="Work 깊이"/>
                                        <TextBox Text="{Binding WorkSplitDepth, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Height="42"/>
                                        <TextBlock Text="0 = 자동" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,6,0">
                                        <TextBlock Text="API 접미사"/>
                                        <TextBox Text="{Binding CompoundSuffixes, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="132"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,10,0,0">
                                        <TextBlock Text="I/O 토큰"/>
                                        <TextBox Text="{Binding IoTypeTokens, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="132"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="기본 제외 및 표시명" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Device / API 제외 키워드: 매칭되는 항목은 변환 결과에서 제외됩니다. 표시명 제거 토큰: UI 표시용 축약일 뿐 변환을 막지 않습니다. 한 줄에 하나씩 입력."
                                                   Style="{StaticResource HintTextStyle}"/>
                                        <TextBlock Text="와일드카드: *ext* = ext 포함 · ext* = ext 로 시작 · *ext = ext 로 끝 · ext = 정확히 ext 만"
                                                   Style="{StaticResource HintTextStyle}" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                                        <TextBlock Text="Device 제외 키워드"/>
                                        <TextBox Text="{Binding DeviceKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="110"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,6,0">
                                        <TextBlock Text="API 제외 키워드"/>
                                        <TextBox Text="{Binding ApiKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="110"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,10,0,0">
                                        <TextBlock Text="표시명 제거 토큰"/>
                                        <TextBox Text="{Binding RemoveTokensForDisplay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 AcceptsReturn="True"
                                                 Height="110"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="고급" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <!-- SymmetryRules: Output ↔ Input 패턴 페어 -->
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="대칭 규칙 (SymmetryRules)" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Output 패턴이 매칭되면 자동으로 동일 위치의 Input 패턴을 짝지웁니다 (예: _Y_ ↔ _X_)."
                                               Style="{StaticResource HintTextStyle}"/>
                                    <DataGrid ItemsSource="{Binding SymmetryRules}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="True"
                                              CanUserDeleteRows="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Background="{DynamicResource TertiaryBackgroundBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              Margin="0,10,0,0"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Output 패턴" Binding="{Binding OutputPattern}" Width="*"/>
                                            <DataGridTextColumn Header="Input 패턴"  Binding="{Binding InputPattern}"  Width="*"/>
                                            <DataGridTextColumn Header="설명"        Binding="{Binding Description}"   Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ExplicitMappings: Output ↔ Input 키워드 직접 매핑 -->
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="명시적 매핑 (ExplicitMappings)" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="패턴 매칭 외에 *키워드 1:1 매핑* 을 강제하는 룰입니다. 예: 'ADV' Output → 'LS_Adv' Input."
                                               Style="{StaticResource HintTextStyle}"/>
                                    <DataGrid ItemsSource="{Binding ExplicitMappings}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="True"
                                              CanUserDeleteRows="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Background="{DynamicResource TertiaryBackgroundBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              Margin="0,10,0,0"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Output 키워드" Binding="{Binding OutputKeyword}" Width="*"/>
                                            <DataGridTextColumn Header="Input 키워드"  Binding="{Binding InputKeyword}"  Width="*"/>
                                            <DataGridTextColumn Header="설명"          Binding="{Binding Description}"   Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Node Connection Rules: Call sequences / Work connections / Device pairs / AutoPre -->
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="노드 연결 룰 (NodeConnectionRules)" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Mermaid/CSV import 후 자동 생성되는 Arrow 의 룰입니다. Call 순서, Work 연결 패턴, Device 페어, AutoPre 룰."
                                               Style="{StaticResource HintTextStyle}"/>

                                    <Expander Header="Call 순서 (CallSequences)" IsExpanded="False" Margin="0,10,0,0"
                                              Foreground="{DynamicResource PrimaryTextBrush}">
                                        <DataGrid ItemsSource="{Binding CallSequences}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="{DynamicResource TertiaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  MinHeight="120"
                                                  Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="이름"  Binding="{Binding Name}"  Width="*"/>
                                                <DataGridTextColumn Header="순서"  Binding="{Binding Steps}" Width="2*"/>
                                                <DataGridTextColumn Header="타입"  Binding="{Binding Type}"  Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander Header="Work 연결 (WorkConnections)" IsExpanded="False" Margin="0,8,0,0"
                                              Foreground="{DynamicResource PrimaryTextBrush}">
                                        <DataGrid ItemsSource="{Binding WorkConnections}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="{DynamicResource TertiaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  MinHeight="120"
                                                  Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="From"  Binding="{Binding FromPattern}" Width="*"/>
                                                <DataGridTextColumn Header="To"    Binding="{Binding ToPattern}"   Width="*"/>
                                                <DataGridTextColumn Header="타입"  Binding="{Binding Type}"        Width="110"/>
                                                <DataGridTextColumn Header="모드"  Binding="{Binding Mode}"        Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander Header="Device 페어 (DevicePairs)" IsExpanded="False" Margin="0,8,0,0"
                                              Foreground="{DynamicResource PrimaryTextBrush}">
                                        <DataGrid ItemsSource="{Binding DevicePairs}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="{DynamicResource TertiaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  MinHeight="100"
                                                  Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Device 1" Binding="{Binding Device1}" Width="*"/>
                                                <DataGridTextColumn Header="Device 2" Binding="{Binding Device2}" Width="*"/>
                                                <DataGridTextColumn Header="타입"     Binding="{Binding Type}"    Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>

                                    <Expander Header="AutoPre 룰 (AutoPreRules)" IsExpanded="False" Margin="0,8,0,0"
                                              Foreground="{DynamicResource PrimaryTextBrush}">
                                        <DataGrid ItemsSource="{Binding AutoPreRules}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="{DynamicResource TertiaryBackgroundBrush}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  MinHeight="100"
                                                  Margin="0,6,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Source 패턴" Binding="{Binding SourcePattern}" Width="*"/>
                                                <DataGridTextColumn Header="Target 패턴" Binding="{Binding TargetPattern}" Width="*"/>
                                                <DataGridTextColumn Header="타입"        Binding="{Binding Type}"          Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="XGK 슬롯" Style="{StaticResource TabItemStyle}"
                         Visibility="{Binding XgkTabVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="XGK 슬롯별 P-주소 범위" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource HintTextStyle}">
                                        XGK 는 입력/출력이 모두 <Run FontWeight="Bold">P</Run> 접두로 시작하기 때문에 주소만으로 방향을 구분할 수 없습니다.
                                        XG5000 의 <Run FontWeight="Bold">I/O 파라미터</Run> 화면에서 본 슬롯 구성을 그대로 입력하세요.
                                        (예: 슬롯 0 = XGI-D28A/B → Input, P00000 ~ P0003F)
                                        설정된 범위 안에 들어오는 P-주소는 해당 Direction 으로 분류됩니다.
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="+ 슬롯 추가"
                                                Command="{Binding AddXgkSlotCommand}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="기본값 (XGI-D28x×2 / XGQ-TR×2)"
                                                Command="{Binding LoadDefaultXgkSlotsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="JSON 가져오기"
                                                Command="{Binding ImportXgkSlotsCommand}"
                                                ToolTip="별도 JSON 파일에서 XGK 슬롯 구성을 불러옵니다 (저장 버튼으로 확정)"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="JSON 내보내기"
                                                Command="{Binding ExportXgkSlotsCommand}"
                                                ToolTip="현재 XGK 슬롯 구성을 별도 JSON 파일로 저장합니다"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding XgkSlots}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Background="{DynamicResource TertiaryBackgroundBrush}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              Margin="0,10,0,0"
                                              MinHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="슬롯"   Binding="{Binding Slot}"         Width="60"/>
                                            <DataGridTextColumn Header="모듈"   Binding="{Binding Module}"       Width="*"/>
                                            <DataGridComboBoxColumn Header="방향" SelectedItemBinding="{Binding Direction}" Width="100">
                                                <DataGridComboBoxColumn.ItemsSource>
                                                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                        <sys:String>Input</sys:String>
                                                        <sys:String>Output</sys:String>
                                                        <sys:String>Memory</sys:String>
                                                    </x:Array>
                                                </DataGridComboBoxColumn.ItemsSource>
                                            </DataGridComboBoxColumn>
                                            <DataGridTextColumn Header="시작 주소" Binding="{Binding AddressStart}" Width="120"/>
                                            <DataGridTextColumn Header="끝 주소"   Binding="{Binding AddressEnd}"   Width="120"/>
                                            <DataGridTextColumn Header="설명"     Binding="{Binding Description}"  Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="JSON 편집" Style="{StaticResource TabItemStyle}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="전체 input-matching-config.json 을 직접 편집합니다. (Ctrl+F 찾기 / Ctrl+H 바꾸기) *기본/고급* 탭에 노출되지 않은 섹션 (Vendors / DeviceNaming / WorkNaming / DisplayNaming 등) 은 여기서 수정하세요."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"/>

                        <!-- 에디터 + VSCode 식 find/replace 오버레이를 같은 셀에 겹쳐 우상단에 띄운다. -->
                        <Grid Grid.Row="1">
                            <avalonedit:TextEditor x:Name="JsonEditor"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   ShowLineNumbers="True"
                                                   WordWrap="False"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   BorderBrush="{DynamicResource BorderBrush}"
                                                   BorderThickness="1"
                                                   Padding="6"/>

                            <Border x:Name="FindReplaceOverlay" Visibility="Collapsed"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,20,0"
                                    Background="{DynamicResource TertiaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="4">
                                <Border.Resources>
                                    <!-- 아이콘 색 명시 (벡터 아이콘이 버튼 배경에 묻히던 문제 해결) -->
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                    <!-- 검색/바꾸기 입력 — 한 줄 전용 (EditorTextBoxStyle 의 multiline/스크롤 회피) -->
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="Height" Value="26"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="7,0"/>
                                        <Setter Property="MinWidth" Value="28"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="7,0"/>
                                        <Setter Property="MinWidth" Value="28"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 왼쪽 chevron: 바꾸기 행 펼침/접음 (VSCode 식) -->
                                    <ToggleButton x:Name="ExpandReplaceBtn" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                  Width="18" VerticalAlignment="Stretch" Margin="0,0,2,0"
                                                  ToolTip="바꾸기 표시/숨김"
                                                  Checked="OnToggleReplaceRow" Unchecked="OnToggleReplaceRow">
                                        <iconPacks:PackIconMaterial x:Name="ExpandIcon" Kind="ChevronRight" Width="12" Height="12"/>
                                    </ToggleButton>

                                    <!-- 찾기 행 -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                        <TextBox x:Name="FindBox" Width="190"
                                                 TextChanged="OnFindTextChanged" KeyDown="OnFindBoxKeyDown"/>
                                        <ToggleButton x:Name="MatchCaseBtn" Margin="3,0,0,0"
                                                      ToolTip="대소문자 구분" Click="OnSearchOptionChanged">
                                            <iconPacks:PackIconMaterial Kind="FormatLetterCase" Width="15" Height="15"/>
                                        </ToggleButton>
                                        <ToggleButton x:Name="WholeWordBtn" Margin="2,0,0,0"
                                                      ToolTip="단어 단위" Click="OnSearchOptionChanged">
                                            <TextBlock Text="ab" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </ToggleButton>
                                        <ToggleButton x:Name="RegexBtn" Margin="2,0,0,0"
                                                      ToolTip="정규식" Click="OnSearchOptionChanged">
                                            <iconPacks:PackIconMaterial Kind="Regex" Width="15" Height="15"/>
                                        </ToggleButton>
                                        <TextBlock x:Name="ResultText" Text="결과 없음" VerticalAlignment="Center"
                                                   Margin="8,0" MinWidth="56"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <Button ToolTip="이전 (Shift+Enter)" Click="OnFindPrev">
                                            <iconPacks:PackIconMaterial Kind="ChevronUp" Width="15" Height="15"/>
                                        </Button>
                                        <Button Margin="2,0,0,0" ToolTip="다음 (Enter)" Click="OnFindNext">
                                            <iconPacks:PackIconMaterial Kind="ChevronDown" Width="15" Height="15"/>
                                        </Button>
                                        <Button Margin="2,0,0,0" ToolTip="닫기 (Esc)" Click="OnCloseOverlay">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 바꾸기 행 -->
                                    <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2,4,2,2">
                                        <TextBox x:Name="ReplaceBox" Width="190"
                                                 KeyDown="OnReplaceBoxKeyDown"/>
                                        <Button Content="바꾸기" Margin="3,0,0,0" Padding="8,2"
                                                ToolTip="현재 항목 바꾸기 (Enter)" Click="OnReplaceCurrent"/>
                                        <Button Content="모두 바꾸기" Margin="2,0,0,0" Padding="8,2" Click="OnReplaceAll"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="미리보기" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="샘플 변수명이 실제 모델 이름으로 어떻게 갈라지는지 확인합니다."
                                   Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="샘플 변수명"/>
                        <TextBox Text="{Binding PreviewSampleSymbol, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditorTextBoxStyle}"
                                 FontFamily="Consolas"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="분해 결과" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding PreviewTokens}" FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Flow" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewFlowName}" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Work" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewWorkName}" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Device" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewDeviceName}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="API" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewApiName}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Call" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewCallName}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="표시명" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PreviewDisplayName}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,12,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PreviewSummary}"
                                       Style="{StaticResource HintTextStyle}"
                                       FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusColor}"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="JSON 보기"
                        Command="{Binding ViewJsonCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="저장 (Ctrl+S)"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
