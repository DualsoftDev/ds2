                                                    Command="{Binding DataContext.MoveSymmetryRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                    Command="{Binding DataContext.RemoveSymmetryRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: ExplicitMappings -->
            <TabItem Header="Explicit Mappings" Style="{StaticResource TabItemStyle}">
                <Grid Margin="12" Background="#252526">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="명시적 Output→Input 키워드 매핑 (정확히 일치)" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Explicit Mappings 사용법" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="특정 Output 키워드를 정확한 Input 키워드로 직접 매핑합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <TextBlock Text="언제 사용하나요?" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="• 패턴 변환 규칙으로 표현하기 어려운 경우" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 특수한 명명 규칙이 있는 변수" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 기존 규칙을 오버라이드하고 싶을 때" Foreground="#A0A0A0" TextWrapping="Wrap"/>

                                        <TextBlock Text="예시" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap">
                                            <Run Text="• " Foreground="#81C784"/>
                                            <Run Text="WORK_COMP_RST" Foreground="#81C784"/>
                                            <Run Text=" → "/>
                                            <Run Text="HOME_POS" Foreground="#64B5F6"/>
                                        </TextBlock>
                                        <TextBlock Text="  로봇 작업완료 리셋 → 홈 위치 센서" Foreground="#808080" Margin="8,2,0,0"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="• " Foreground="#81C784"/>
                                            <Run Text="GUN_OPEN" Foreground="#81C784"/>
                                            <Run Text=" → "/>
                                            <Run Text="GUN_OPEN_POS" Foreground="#64B5F6"/>
                                        </TextBlock>
                                        <TextBlock Text="  용접건 오픈 → 오픈 위치 센서" Foreground="#808080" Margin="8,2,0,0"/>

                                        <TextBlock Text="부분 일치로 동작하며 대소문자를 무시합니다." FontStyle="Italic" Foreground="#808080" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1" Content="+ 매핑 추가" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding AddExplicitMappingCommand}"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ExplicitMappings}"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Output Keyword" Binding="{Binding OutputKeyword, UpdateSourceTrigger=PropertyChanged}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#81C784"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Input Keyword" Binding="{Binding InputKeyword, UpdateSourceTrigger=PropertyChanged}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64B5F6"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0A0A0"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource MoveButtonStyle}" ToolTip="위로 이동"
                                                    Command="{Binding DataContext.MoveExplicitMappingUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource MoveButtonStyle}" ToolTip="아래로 이동"
                                                    Command="{Binding DataContext.MoveExplicitMappingDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                    Command="{Binding DataContext.RemoveExplicitMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

                        <!-- Tab 5: Node Connections -->
            <TabItem Header="Node Connections" Style="{StaticResource TabItemStyle}">
                <Grid Margin="12" Background="#252526">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Node connection rules (used for auto linking during export)" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Node Connections" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Define how calls and works connect when exporting flows." TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <TextBlock Text="Call Sequences" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="Comma separated steps, supports * wildcard." Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Text="Example: START,*_IN_OK,WORK_COMP_RST" Foreground="#808080" TextWrapping="Wrap"/>

                                        <TextBlock Text="Work Connections" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="Connect works by name pattern (From -> To), sequential or parallel." Foreground="#A0A0A0" TextWrapping="Wrap"/>

                                        <TextBlock Text="Device Pairs" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="Pair device types (e.g., SV &lt;-&gt; CT) to link related works." Foreground="#A0A0A0" TextWrapping="Wrap"/>

                                        <TextBlock Text="Arrow types" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="StartReset: start then reset" Foreground="#81C784"/>
                                        <TextBlock Text="Start: start only" Foreground="#64B5F6"/>
                                        <TextBlock Text="Reset: reset only" Foreground="#FFB74D"/>
                                        <TextBlock Text="Interlock: mutual exclusion" Foreground="#CE93D8"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <!-- Call Sequences -->
                    <Border Grid.Row="1" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Call Sequences" Style="{StaticResource SectionHeaderStyle}" Foreground="#81C784"/>
                                <Button Content="+ Add" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                        Command="{Binding AddCallSequenceCommand}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CallSequences}"
                                      Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Steps (comma, * wildcard)" Binding="{Binding Steps, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFD54F"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#81C784"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▲" Style="{StaticResource MoveButtonStyle}" ToolTip="위로 이동"
                                                            Command="{Binding DataContext.MoveCallSequenceUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="▼" Style="{StaticResource MoveButtonStyle}" ToolTip="아래로 이동"
                                                            Command="{Binding DataContext.MoveCallSequenceDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                            Command="{Binding DataContext.RemoveCallSequenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Work Connections + Device Pairs + AutoPre -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Work Connections -->
                        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Work Connections" Style="{StaticResource SectionHeaderStyle}" Foreground="#64B5F6"/>
                                    <Button Content="+ Add" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                            Command="{Binding AddWorkConnectionCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding WorkConnections}"
                                          Style="{StaticResource DataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="From" Binding="{Binding FromPattern, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="To" Binding="{Binding ToPattern, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64B5F6"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB74D"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CE93D8"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="▲" Style="{StaticResource MoveButtonStyle}" ToolTip="위로 이동"
                                                                Command="{Binding DataContext.MoveWorkConnectionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▼" Style="{StaticResource MoveButtonStyle}" ToolTip="아래로 이동"
                                                                Command="{Binding DataContext.MoveWorkConnectionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                                Command="{Binding DataContext.RemoveWorkConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Device Pairs -->
                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Device Pairs" Style="{StaticResource SectionHeaderStyle}" Foreground="#CE93D8"/>
                                    <Button Content="+ Add" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                            Command="{Binding AddDevicePairCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding DevicePairs}"
                                          Style="{StaticResource DataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device1" Binding="{Binding Device1, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Device2" Binding="{Binding Device2, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64B5F6"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB74D"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="▲" Style="{StaticResource MoveButtonStyle}" ToolTip="위로 이동"
                                                                Command="{Binding DataContext.MoveDevicePairUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▼" Style="{StaticResource MoveButtonStyle}" ToolTip="아래로 이동"
                                                                Command="{Binding DataContext.MoveDevicePairDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                                Command="{Binding DataContext.RemoveDevicePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- AutoPre Rules -->
                        <Border Grid.Column="2" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="AutoPre Rules" Style="{StaticResource SectionHeaderStyle}" Foreground="#FFD54F"/>
                                    <Button Content="+ Add" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                            Command="{Binding AddAutoPreRuleCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding AutoPreRules}"
                                          Style="{StaticResource DataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourcePattern, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Target" Binding="{Binding TargetPattern, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64B5F6"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB74D"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="▲" Style="{StaticResource MoveButtonStyle}" ToolTip="위로 이동"
                                                                Command="{Binding DataContext.MoveAutoPreRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▼" Style="{StaticResource MoveButtonStyle}" ToolTip="아래로 이동"
                                                                Command="{Binding DataContext.MoveAutoPreRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="X" Style="{StaticResource DeleteButtonStyle}" ToolTip="삭제"
                                                                Command="{Binding DataContext.RemoveAutoPreRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}"
                       VerticalAlignment="Center" FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="JSON 보기" Command="{Binding ViewJsonCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="저장 (Ctrl+S)" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
