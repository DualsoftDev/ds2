<Window x:Class="Promaker.Dialogs.ConfigEditor.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Config Editor - Input Matching Rules"
        Height="750" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0" Margin="2,0,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="KeywordTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="RowBackground" Value="#2D2D30"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E90FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E4E52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E4E52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#8B0000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CD5C5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D5A8C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E7AB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E4E4E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HelpTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Input Matching Config Editor" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="PLC 입출력 매핑 규칙을 설정합니다. 변경 후 저장(Ctrl+S)을 누르세요."
                       Foreground="#A0A0A0" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#3F3F46"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Tab 1: FilterExclusions -->
            <TabItem Header="Filter Exclusions" Style="{StaticResource TabItemStyle}">
                <Grid Margin="12" Background="#252526">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="UI 필터 기본 설정 (줄바꿈으로 구분)"
                               Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Device Keywords -->
                        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="4" Margin="0,0,6,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Device Keywords" Style="{StaticResource SectionHeaderStyle}"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Device Keywords" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="이 키워드가 포함된 Device는 기본으로 체크 해제됩니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="예시:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• cartype - 차종 관련 디바이스 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• prog - 프로그램 관련 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• em_stop - 비상정지 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• _I_ - 입력 전용 변수 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="쉼표 또는 줄바꿈으로 구분, 대소문자 무시, 부분 일치" FontStyle="Italic" Foreground="#808080" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding DeviceKeywords, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- API Keywords -->
                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="4" Margin="3,0,3,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="API Keywords" Style="{StaticResource SectionHeaderStyle}"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="API Keywords" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="이 키워드가 포함된 API는 기본으로 체크 해제됩니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="예시:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• ext - 외부 API 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• err - 에러 관련 API 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• robot - 로봇 API 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• safety - 안전 관련 API 제외" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="쉼표 또는 줄바꿈으로 구분, 대소문자 무시, 부분 일치" FontStyle="Italic" Foreground="#808080" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding ApiKeywords, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Flow Keywords (제외) -->
                        <Border Grid.Column="2" Background="#2D2D30" CornerRadius="4" Margin="3,0,3,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Flow 제외" Style="{StaticResource SectionHeaderStyle}"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Flow 제외 키워드" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="이 키워드가 포함된 Flow는 기본으로 체크 해제됩니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="참고:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• Flow는 기본적으로 S{숫자} 패턴만 자동 선택됩니다." Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• 여기에 키워드를 추가하면 추가로 제외됩니다." Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding FlowKeywords, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Flow 필터링 -->
                        <Border Grid.Column="3" Background="#2D2D30" CornerRadius="4" Margin="6,0,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Flow 필터링" Style="{StaticResource SectionHeaderStyle}" Foreground="#81C784"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Flow 필터링 (기본 체크)" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="변환 시 기본으로 체크할 Flow 목록입니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="동작 방식:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• 비어있음: 기존 S{숫자} 패턴 매칭 사용" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• 항목 있음: 입력된 Flow만 체크됨 (배타적)" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="예시:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="S141" Foreground="#81C784"/>
                                                    <TextBlock Text="S142" Foreground="#81C784"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding FlowInclusions, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- WorkNaming + ApiNaming + DisplayNaming -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- WorkSplitDepth (Work 분할 깊이) -->
                        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="0,0,6,0" MinWidth="120">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Work 분할 깊이" Style="{StaticResource SectionHeaderStyle}" Foreground="#81C784"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Work 분할 깊이 (SplitDepth) - 최대 깊이 제한" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="변수명에서 Work(Device) 이름의 최대 토큰 개수를 제한합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="처리 우선순위:" FontWeight="SemiBold" Foreground="#FF9800" Margin="0,8,0,4"/>
                                                    <TextBlock Text="1. CompoundSuffixes로 API 분리 (먼저 적용)" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="2. 결과가 최대 깊이 초과시 → 최대 깊이로 제한" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="값 설명:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• 0 = 제한 없음 (CompoundSuffixes 결과 그대로)" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• N = 최대 N개 토큰으로 제한" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="예시 (S141_SOL_INDEX_LOAD_AIR_ADV):" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• 깊이 0: CompoundSuffixes로 자동 → Work: S141_SOL_INDEX_LOAD_AIR" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="• 깊이 4: 최대 4토큰 → Work: S141_SOL_INDEX_LOAD" Foreground="#81C784"/>
                                                    <TextBlock Text="• 깊이 3: 최대 3토큰 → Work: S141_SOL_INDEX" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="기본값: 0 (제한 없음)" FontStyle="Italic" Foreground="#808080" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding WorkSplitDepth, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}"
                                         HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold"
                                         Height="36" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- CompoundSuffixes -->
                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3,0,3,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="복합 API 접미사" Style="{StaticResource SectionHeaderStyle}" Foreground="#FFB74D"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="복합 API 접미사 (Compound Suffixes)" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="끝에서부터 이 패턴에 연속 매칭되는 토큰들을 API로 결합합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="처리 우선순위:" FontWeight="SemiBold" Foreground="#FF9800" Margin="0,8,0,4"/>
                                                    <TextBlock Text="1. I/O 타입 토큰 제거 (Q, I, O 등)" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="2. 끝에서부터 CompoundSuffixes 연속 매칭 → API" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="3. Work 분할 깊이로 최대 깊이 제한 (설정시)" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="와일드카드 패턴:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• * = 0개 이상 문자 (예: *ST → 1ST, 2ST 매칭)" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="• ? = 정확히 1개 문자 (예: ?ND → 2ND 매칭)" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="예시 (S154_Q_RB1_C_1ST_IN_OK):" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="  1. Q 제거 → S154_RB1_C_1ST_IN_OK" Foreground="#808080" Margin="8,0,0,0"/>
                                                    <TextBlock Text="  2. OK 매칭, IN 미매칭 → API=OK? 아니요" Foreground="#808080" Margin="8,0,0,0"/>
                                                    <TextBlock Text="  3. *ST에 1ST 매칭, C도 매칭 → API=C_1ST_IN_OK" Foreground="#808080" Margin="8,0,0,0"/>
                                                    <TextBlock Text="  → Work=S154_RB1, API=C_1ST_IN_OK" Foreground="#81C784" Margin="8,0,0,0"/>
                                                    <TextBlock Text="기본값: OK, COMP, POS, RST, END, CHK, ?ND, ?RD, ?TH" FontStyle="Italic" Foreground="#808080" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding CompoundSuffixes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- IOTypeTokens -->
                        <Border Grid.Column="2" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3,0,3,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="I/O 타입 토큰" Style="{StaticResource SectionHeaderStyle}" Foreground="#CE93D8"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="I/O 타입 토큰 (IOTypeTokens)" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="변수명 끝에 있는 I/O 방향 표시자를 제거합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <TextBlock Text="처리 우선순위 (가장 먼저 적용):" FontWeight="SemiBold" Foreground="#FF9800" Margin="0,8,0,4"/>
                                                    <TextBlock Text="1. 마지막 토큰이 I/O 타입이면 제거" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="2. 이후 CompoundSuffixes로 API 분리" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="3. Work 분할 깊이로 제한" Foreground="#64B5F6" TextWrapping="Wrap"/>
                                                    <TextBlock Text="예시:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="• S154_RB1_ADV_Q" Foreground="#A0A0A0"/>
                                                    <TextBlock Text="  1. Q 제거 → S154_RB1_ADV" Foreground="#808080" Margin="8,0,0,0"/>
                                                    <TextBlock Text="  2. API=ADV → Work=S154_RB1" Foreground="#81C784" Margin="8,0,0,0"/>
                                                    <TextBlock Text="기본값: Q, I, O, Y, X, M" FontStyle="Italic" Foreground="#808080" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding IoTypeTokens, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- DisplayNaming: Export 시 이름 간소화 -->
                        <Border Grid.Column="3" Background="#2D2D30" CornerRadius="4" Padding="10" Margin="3,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="제거할 토큰 설정" Style="{StaticResource SectionHeaderStyle}" Foreground="#E57373"/>
                                    <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="30000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="제거할 토큰 설정" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="Export 시 DisplayName에서 제거할 토큰을 입력합니다.&#x0a;줄바꿈 또는 콤마로 구분합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>

                                                    <TextBlock Text="토큰 종류:" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                    <TextBlock Text="• 디바이스 타입: SOL, WRS, RS, LS 등" Foreground="#FFB74D"/>

                                                    <TextBlock Text="변환 예시:" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                                    <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap">
                                                        <Run Text="원본: " Foreground="#808080"/>
                                                        <Run Text="S141_SOL_CT_CLP" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="8,2,0,0">
                                                        <Run Text="→ SOL 제거: " Foreground="#808080"/>
                                                        <Run Text="S141_CT_CLP" Foreground="#81C784"/>
                                                    </TextBlock>

                                                    <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,8,0,0">
                                                        <Run Text="원본: " Foreground="#808080"/>
                                                        <Run Text="S141_WRS_CT_CLP_ADVD" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="8,2,0,0">
                                                        <Run Text="→ WRS 제거: " Foreground="#808080"/>
                                                        <Run Text="S141_CT_CLP_ADVD" Foreground="#81C784"/>
                                                    </TextBlock>

                                                    <TextBlock Text="⚠ Flow 접두사(S141 등)를 제거하면&#x0a;   매칭 및 변환 동작에 문제가 발생할 수 있습니다."
                                                               Foreground="#E57373" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding RemoveTokensForDisplay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource KeywordTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="제거할 디바이스 타입 토큰&#x0a;예: SOL, WRS, RS, LS" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: MappingSets -->
            <TabItem Header="Mapping Sets" Style="{StaticResource TabItemStyle}">
                <Grid Margin="12" Background="#252526">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="디바이스-API 매핑 규칙 (카테고리별 정리)" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Mapping Sets 사용법" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Device 이름 패턴에 따라 어떤 API를 매핑할지 정의합니다." TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <TextBlock Text="Device Keywords" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="• 와일드카드 패턴 사용: *Clamp*, *Valve*, *CYL*" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Text="• 여러 패턴은 쉼표로 구분" Foreground="#A0A0A0"/>
                                        <TextBlock Text="• 대소문자 무시, 부분 일치" Foreground="#A0A0A0"/>

                                        <TextBlock Text="API 정의" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="• Name: API 이름 (예: ADV, RET, ON, OFF)" Foreground="#A0A0A0"/>
                                        <TextBlock Text="• Out: Output 키워드 (예: O, OUT, SOL)" Foreground="#81C784"/>
                                        <TextBlock Text="• In: Input 키워드 (예: I, IN, ADVPOS, RETPOS)" Foreground="#64B5F6"/>

                                        <TextBlock Text="예시" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap">
                                            <Run Text="Device: *Clamp*"/>
                                            <LineBreak/>
                                            <Run Text="API 'ADV': Out=O,OUT / In=I,IN,ADVPOS"/>
                                            <LineBreak/>
                                            <Run Text="→ S151_Q_Clamp_O1 ↔ S151_I_Clamp_ADVPOS"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <TreeView Grid.Row="1" Background="#2D2D30" BorderBrush="#3F3F46"
                              ItemsSource="{Binding MappingCategories}">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding MappingSets}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#64B5F6"/>
                                    <TextBlock Text="{Binding MappingSets.Count, StringFormat=' ({0})'}" Foreground="#808080"/>
                                    <Button Content="+ 추가" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0"
                                            Command="{Binding DataContext.AddMappingSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252526" CornerRadius="3" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- MappingSet Header -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#3E3E42" Foreground="White" BorderThickness="0"
                                                             FontWeight="SemiBold" Padding="4,2" Width="250"/>
                                                    <Button Content="X" Style="{StaticResource DeleteButtonStyle}" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveMappingSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="삭제"/>
                                                </StackPanel>

                                                <!-- DeviceKeywords -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="Device:" Foreground="#A0A0A0" Width="50"/>
                                                    <TextBox Text="{Binding DeviceKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource KeywordTextBoxStyle}" Width="400"/>
                                                </StackPanel>

                                                <!-- APIs -->
                                                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="APIs:" Foreground="#A0A0A0"/>
                                                        <Button Content="+ API" Style="{StaticResource SmallButtonStyle}" Margin="8,0,0,0"
                                                                Command="{Binding DataContext.AddApiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Apis}" Margin="50,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="#3E3E42" Foreground="#FFD54F" BorderThickness="0"
                                                                             Width="80" Padding="4,2" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="Out:" Foreground="#A0A0A0" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBox Text="{Binding OutputKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource KeywordTextBoxStyle}" Width="120"/>
                                                                    <TextBlock Text="In:" Foreground="#A0A0A0" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBox Text="{Binding InputKeywords, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource KeywordTextBoxStyle}" Width="150"/>
                                                                    <Button Content="X" Style="{StaticResource DeleteButtonStyle}" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.RemoveApiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- Tab 3: SymmetryRules -->
            <TabItem Header="Symmetry Rules" Style="{StaticResource TabItemStyle}">
                <Grid Margin="12" Background="#252526">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Output→Input 패턴 대칭 규칙 (예: _Q_ → _I_)" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="?" Style="{StaticResource HelpButtonStyle}" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource HelpTooltipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Symmetry Rules 사용법" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Output 변수명의 패턴을 Input 패턴으로 변환하는 규칙입니다." TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <TextBlock Text="동작 원리" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="Output 변수에서 Output Pattern을 찾아 Input Pattern으로 치환하여" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Text="대응하는 Input 변수를 매칭합니다." Foreground="#A0A0A0" TextWrapping="Wrap"/>

                                        <TextBlock Text="기본 예시" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap">
                                            <Run Text="• " Foreground="#81C784"/>
                                            <Run Text="_Q_" Foreground="#81C784"/>
                                            <Run Text=" → "/>
                                            <Run Text="_I_" Foreground="#64B5F6"/>
                                            <Run Text=" (LS Q/I 대칭)"/>
                                        </TextBlock>
                                        <TextBlock Text="  S151_Q_RB1_O1 → S151_I_RB1_O1" Foreground="#808080" Margin="8,2,0,0"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="• " Foreground="#81C784"/>
                                            <Run Text="SOL_" Foreground="#81C784"/>
                                            <Run Text=" → "/>
                                            <Run Text="RS_" Foreground="#64B5F6"/>
                                            <Run Text=" (SOL→센서)"/>
                                        </TextBlock>
                                        <TextBlock Text="  S151_SOL_Valve1 → S151_RS_Valve1" Foreground="#808080" Margin="8,2,0,0"/>

                                        <TextBlock Text="와일드카드 (*) 지원" FontWeight="SemiBold" Margin="0,10,0,4"/>
                                        <TextBlock Text="OutputPattern에 * 사용: 중간 부분 무시" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="• " Foreground="#81C784"/>
                                            <Run Text="_SOL_CT_*_FLR_CLP_" Foreground="#81C784"/>
                                            <Run Text=" → "/>
                                            <Run Text="_WRS_CT_CLP_" Foreground="#64B5F6"/>
                                        </TextBlock>
                                        <TextBlock Text="  S141_SOL_CT_R_FLR_CLP_ADV → S141_WRS_CT_CLP_ADV" Foreground="#808080" Margin="8,2,0,0"/>
                                        <TextBlock Text="  (R/L 방향, FLR 부분 무시)" Foreground="#808080" Margin="8,0,0,0"/>

                                        <TextBlock Text="InputPattern에 * 사용: 후보 확장" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="• CLP_ADV → " Foreground="#A0A0A0"/>
                                            <Run Text="CLP_ADV*" Foreground="#64B5F6"/>
                                            <Run Text=" (ADV, ADV1, ADV2 모두 매칭)"/>
                                        </TextBlock>

                                        <TextBlock Text="대소문자를 무시하고 부분 일치로 동작합니다." FontStyle="Italic" Foreground="#808080" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1" Content="+ 규칙 추가" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding AddSymmetryRuleCommand}"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding SymmetryRules}"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Output Pattern" Binding="{Binding OutputPattern, UpdateSourceTrigger=PropertyChanged}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#81C784"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Input Pattern" Binding="{Binding InputPattern, UpdateSourceTrigger=PropertyChanged}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64B5F6"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A0A0A0"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#3E3E42"/>
