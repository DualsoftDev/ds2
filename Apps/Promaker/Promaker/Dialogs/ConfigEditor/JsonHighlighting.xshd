<?xml version="1.0"?>
<!-- VSCode Dark+ 스타일 JSON syntax highlighting (AvalonEdit). -->
<SyntaxDefinition name="Json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Bool"        foreground="#569CD6" />
    <Color name="Number"      foreground="#B5CEA8" />
    <Color name="String"      foreground="#CE9178" />
    <Color name="Key"         foreground="#9CDCFE" />
    <Color name="Punctuation" foreground="#D4D4D4" />

    <RuleSet ignoreCase="false">
        <Keywords color="Bool">
            <Word>true</Word>
            <Word>false</Word>
            <Word>null</Word>
        </Keywords>

        <!-- key: 콜론(:) 앞에 오는 문자열 -->
        <Rule color="Key">
            "(\\.|[^"\\])*"(?=\s*:)
        </Rule>

        <!-- 일반 문자열 값 -->
        <Rule color="String">
            "(\\.|[^"\\])*"
        </Rule>

        <!-- 숫자 -->
        <Rule color="Number">
            \b[0-9]+(\.[0-9]+)?([eE][+\-]?[0-9]+)?\b
        </Rule>

        <!-- 구두점 { } [ ] : , -->
        <Rule color="Punctuation">
            [{}\[\]:,]
        </Rule>
    </RuleSet>
</SyntaxDefinition>
