<Window x:Class="Promaker.Dialogs.ApiDefEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Ds2.Core.Store;assembly=Ds2.Core"
        Title="ApiDef 편집"
        Width="460" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 이름 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="이름"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <TextBox x:Name="NameBox" Padding="6,4"/>
            </StackPanel>

            <!-- ActionType (v10 D1 WHEN·OUT) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="ActionType (출력 시점 정책)"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>

                <RadioButton x:Name="ActionNormalRadio" Content="normal — Real(Level, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="ActionType" IsChecked="True" Margin="0,2,0,2"/>
                <RadioButton x:Name="ActionPulseRadio" Content="pulse — Real(OneShot, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="ActionType" Margin="0,2,0,2"/>
                <RadioButton x:Name="ActionSetRadio" Content="set — Real(Latched, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="ActionType" Margin="0,2,0,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="ActionTimeAppendRadio" Content="timeAppend"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="ActionType" Width="110" VerticalAlignment="Center"
                                 Checked="ActionTimeAppendRadio_Checked" Unchecked="ActionTimeAppendRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ActionTimeAppendMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="200" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="ActionPulseHoldRadio" Content="pulseHold"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="ActionType" Width="110" VerticalAlignment="Center"
                                 Checked="ActionPulseHoldRadio_Checked" Unchecked="ActionPulseHoldRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ActionPulseHoldMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="200" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>

                <RadioButton x:Name="ActionVirtRadio" Content="virt — Virtual(None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="ActionType" Margin="0,2,0,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="ActionVirtPlusRadio" Content="virtPlus"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="ActionType" Width="110" VerticalAlignment="Center"
                                 Checked="ActionVirtPlusRadio_Checked" Unchecked="ActionVirtPlusRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ActionVirtPlusMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="200" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>
            </StackPanel>

            <!-- SensingType (v10 D3 WHEN·IN) -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="SensingType (감지 시점 정책)"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,4"/>

                <RadioButton x:Name="SensingNormalRadio" Content="normal — Real(Level, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="SensingType" IsChecked="True" Margin="0,2,0,2"/>
                <RadioButton x:Name="SensingEdgeRadio" Content="edge — Real(OneShot, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="SensingType" Margin="0,2,0,2"/>
                <RadioButton x:Name="SensingLatchedRadio" Content="latched — Real(Latched, None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="SensingType" Margin="0,2,0,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="SensingDebounceRadio" Content="debounce"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="SensingType" Width="110" VerticalAlignment="Center"
                                 Checked="SensingDebounceRadio_Checked" Unchecked="SensingDebounceRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SensingDebounceMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="50" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="SensingEdgeStableRadio" Content="edgeStable"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="SensingType" Width="110" VerticalAlignment="Center"
                                 Checked="SensingEdgeStableRadio_Checked" Unchecked="SensingEdgeStableRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SensingEdgeStableMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="50" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>

                <RadioButton x:Name="SensingVirtRadio" Content="virt — Virtual(None)"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             GroupName="SensingType" Margin="0,2,0,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <RadioButton x:Name="SensingVirtPlusRadio" Content="virtPlus"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 GroupName="SensingType" Width="110" VerticalAlignment="Center"
                                 Checked="SensingVirtPlusRadio_Checked" Unchecked="SensingVirtPlusRadio_Unchecked"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="SensingVirtPlusMsBox" Width="60" Padding="4,2"
                             VerticalAlignment="Center" IsEnabled="False"
                             Text="200" PreviewTextInput="DigitOnly_PreviewTextInput"/>
                </StackPanel>
            </StackPanel>

            <!-- TX Work / RX Work -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static core:Labels.TxWork}"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,2"/>
                    <ComboBox x:Name="TxWorkCombo" DisplayMemberPath="Name" Padding="6,4"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static core:Labels.RxWork}"
                               FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,2"/>
                    <ComboBox x:Name="RxWorkCombo" DisplayMemberPath="Name" Padding="6,4"/>
                </StackPanel>
            </Grid>

            <!-- 설명 -->
            <DockPanel Grid.Row="4" Grid.RowSpan="2" Margin="0,0,0,8" LastChildFill="True">
                <TextBlock Text="설명" DockPanel.Dock="Top"
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,2"/>
                <TextBox x:Name="DescriptionBox" Padding="6,4"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>
            </DockPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="12,4" Margin="0,0,4,0"
                        Click="Ok_Click" IsDefault="True"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
