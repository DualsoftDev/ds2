<Window x:Class="Promaker.Dialogs.ProjectImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다른 프로젝트에서 시스템 가져오기"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="가져올 시스템 선택"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1"
                       x:Name="SourceText"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="설비 시스템"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ItemsControl x:Name="ActiveList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="4,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="8,0,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="디바이스"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="설비 시스템을 선택하면 그 설비가 참조하는 디바이스는 자동으로 함께 가져옵니다. 디바이스만 따로 가져오려면 여기서 선택하세요."
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <ItemsControl x:Name="PassiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="4,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="8,0,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="3"
                       Text="이름이 겹치면 자동으로 개명됩니다 (예: Main → Main_1). PLC 연결정보(endpoint)는 가져오지 않으므로 필요 시 System 속성에서 재설정하세요."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,10"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="가져오기"
                        Style="{StaticResource DarkButton}"
                        Padding="16,5"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="Ok_Click"/>
                <Button Content="취소"
                        Style="{StaticResource DarkButton}"
                        Padding="16,5"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
