<Window x:Class="Promaker.Dialogs.FileImportLauncherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일(PLC, CSV)로부터 모델만들기"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="가져올 파일 형식을 선택하세요"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>

            <RadioButton Grid.Row="1"
                         x:Name="PlcRadio"
                         IsChecked="True"
                         GroupName="ImportMode"
                         Margin="0,0,0,8"
                         Foreground="{DynamicResource PrimaryTextBrush}">
                <StackPanel>
                    <TextBlock Text="PLC 심볼 (Mitsubishi CSV / XG5000 XML)"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="PLC dump 파일을 룰 기반으로 자동 매칭 → Symbol Wizard"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Grid.Row="2"
                         x:Name="CsvRadio"
                         GroupName="ImportMode"
                         Margin="0,0,0,16"
                         Foreground="{DynamicResource PrimaryTextBrush}">
                <StackPanel>
                    <TextBlock Text="일반 CSV (모델 데이터)"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="기존 ds2 CSV 포맷의 프로젝트 import"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </RadioButton>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="확인"
                        Style="{StaticResource DarkButton}"
                        MinWidth="72"
                        Margin="0,0,6,0"
                        IsDefault="True"
                        Click="Ok_Click"/>
                <Button Content="취소"
                        Style="{StaticResource DarkButton}"
                        MinWidth="72"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
