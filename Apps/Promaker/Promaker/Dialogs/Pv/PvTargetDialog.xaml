<Window x:Class="Promaker.Dialogs.Pv.PvTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="업로드 대상 선택" Width="740" Height="440" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <!-- 컬럼 리스트 — 배경/보더/텍스트/선택/호버 전부 테마 브러시 -->
        <Style x:Key="PvColumnList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PvColumnHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- 컬럼 1: 사이트 -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PvColumnHeader}" Text="사이트"/>
                <ListBox x:Name="SiteList" Style="{StaticResource PvColumnList}"
                         DisplayMemberPath="DisplayName"
                         SelectionChanged="SiteList_SelectionChanged"/>
            </DockPanel>

            <!-- 컬럼 2: 단말 -->
            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PvColumnHeader}" Text="단말"/>
                <ListBox x:Name="EdgeList" Style="{StaticResource PvColumnList}"
                         SelectionChanged="EdgeList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 컬럼 3: 상세 -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PvColumnHeader}" Text="상세"/>
                <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="단말을 선택하세요."/>
                </Border>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="이 단말로 업로드" Width="140" Margin="0,0,8,0"
                    Style="{DynamicResource DarkButton}" IsEnabled="False" Click="Confirm_Click"/>
            <Button Content="취소" Width="90" Style="{DynamicResource DarkButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
