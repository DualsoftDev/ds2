<Window x:Class="Promaker.Dialogs.SymbolWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Symbol Import Wizard — PLC 심볼 → DS 모델 자동 생성"
        Width="1200" Height="720"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step 1: 파일 + Vendor -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Step 1 — PLC 심볼 파일 선택"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Vendor:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
	                    <ComboBox x:Name="VendorCombo" Width="160" Padding="4,2" Margin="0,0,8,0"
	                              Background="{DynamicResource TertiaryBackgroundBrush}"
	                              Foreground="{DynamicResource PrimaryTextBrush}"
	                              BorderBrush="{DynamicResource BorderBrush}">
	                        <ComboBoxItem Content="Mitsubishi" IsSelected="True"/>
	                        <ComboBoxItem Content="XGI/XG5000 (LS)"/>
	                        <ComboBoxItem Content="XGB (LS CSV)"/>
	                        <ComboBoxItem Content="XGK (LS CSV)"/>
	                        <ComboBoxItem Content="AB (미구현)"/>
	                    </ComboBox>
                    <TextBox x:Name="FilePathBox" Width="500" Padding="4,2" Margin="0,0,8,0"
                             IsReadOnly="True"
                             Background="{DynamicResource TertiaryBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
	                             Text="파일을 선택하세요 (Mitsubishi CSV, LS CSV/XML)"/>
                    <Button Content="찾기..." Style="{StaticResource DarkButton}" MinWidth="72" Click="BrowseFile_Click"/>
                    <Button Content="파싱 실행" Style="{StaticResource DarkButton}" MinWidth="80" Margin="4,0,0,0"
                            Click="Parse_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 2: Parse 상태 -->
            <TextBlock Grid.Row="1" x:Name="StatusText"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,6"
                       Text="대기 중..."/>

            <!-- Step 3: Mapping DataGrid + Preview Tree (좌우 분할) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Step 2 — 매칭 결과 (검수)"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="6"/>
                        <DataGrid x:Name="MappingGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Margin="6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address"  Binding="{Binding Address}"   Width="80"/>
                                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"      Width="*"/>
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
                                <DataGridTextColumn Header="Flow"     Binding="{Binding Flow}"      Width="100"/>
                                <DataGridTextColumn Header="Work"     Binding="{Binding Work}"      Width="100"/>
                                <DataGridTextColumn Header="Device"   Binding="{Binding Device}"    Width="100"/>
                                <DataGridTextColumn Header="Api"      Binding="{Binding Api}"       Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource TertiaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Step 3 — 생성될 DS 모델 미리보기"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="6"/>
                        <TreeView x:Name="PreviewTree" Margin="6"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Validation issues -->
            <TextBox Grid.Row="3" x:Name="IssuesBox"
                     Margin="0,8,0,0"
                     Height="60"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource TertiaryBackgroundBrush}"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>

            <!-- Step 4: Apply / Cancel + Config Editor 진입점 -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="⚙ 매칭 룰 편집 (Config Editor)"
                        Style="{StaticResource DarkButton}"
                        Click="OpenConfigEditor_Click"
                        ToolTip="input-matching-config.json 의 매칭 룰을 GUI 로 편집"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ApplyButton" Content="Step 4 — 모델 적용"
                            Style="{StaticResource DarkButton}"
                            MinWidth="120" Margin="0,0,6,0"
                            Click="Apply_Click"
                            IsEnabled="False"/>
                    <Button Content="취소"
                            Style="{StaticResource DarkButton}"
                            MinWidth="72"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
