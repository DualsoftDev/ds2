<Window x:Class="Promaker.Dialogs.ConditionTypePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="조건 유형 선택"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="16">
        <StackPanel>
            <TextBlock Text="조건 유형을 선택하세요:"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <!-- 유형이 이미 정해진 경로(속성창 섹션 드롭 / Work 대상)에서 잠금 사유를 안내한다. -->
            <TextBlock x:Name="TypeLockHint"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,4"/>

            <Border Height="8" Background="Transparent"/>

            <RadioButton x:Name="AutoAuxRadio" GroupName="CondType"
                         Content="AutoAux" IsChecked="True"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Margin="0,0,0,6"/>
            <RadioButton x:Name="ComAuxRadio" GroupName="CondType"
                         Content="ComAux"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Margin="0,0,0,6"/>
            <!-- SkipAction 전용 접점 선택 — 같은 행에 두어 이 라디오에만 딸린 옵션임을 분명히 한다.
                 (AutoAux/ComAux 선택 시에는 비활성) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="SkipActionRadio" Grid.Column="0"
                             GroupName="CondType"
                             Content="SkipAction"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Checked="ConditionType_Changed"
                             Unchecked="ConditionType_Changed"/>
                <!-- 접힌 상태는 짧은 이름만, 드롭다운을 펼치면 전체 설명. (팝업은 항목 폭에 맞춰 넓어짐) -->
                <ComboBox x:Name="ContactKindCombo" Grid.Column="2"
                          Width="104" HorizontalAlignment="Left"
                          IsEnabled="False" Opacity="0.45"
                          VerticalAlignment="Center"
                          Padding="6,2"
                          ToolTip="SkipAction 조건에서 참조 신호를 어느 상태일 때 통과시킬지 선택합니다.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Label" Text="{Binding FullText}"/>
                            <DataTemplate.Triggers>
                                <!-- ComboBoxItem 조상이 없으면 = 선택 표시 영역 → 짧은 이름 -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                             Value="{x:Null}">
                                    <Setter TargetName="Label" Property="Text" Value="{Binding ShortText}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="12,4" Margin="0,0,4,0"
                        IsDefault="True" Click="OK_Click"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
