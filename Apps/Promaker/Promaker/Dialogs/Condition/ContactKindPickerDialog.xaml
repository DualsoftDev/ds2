<Window x:Class="Promaker.Dialogs.ContactKindPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="접점 종류 선택"
        Width="300" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="16">
        <StackPanel>
            <TextBlock Text="SkipAction 조건의 접점 종류를 선택하세요:"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- B접(Not) 이 default — Inverted contact (─┤/├─). -->
            <RadioButton x:Name="NcContactRadio" GroupName="ContactKind"
                         Content="B접 (Not, ─┤/├─)" IsChecked="True"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Margin="0,0,0,6"/>
            <RadioButton x:Name="NoContactRadio" GroupName="ContactKind"
                         Content="A접 (─┤├─)"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인" Style="{StaticResource DarkButton}"
                        Padding="12,4" Margin="0,0,4,0"
                        IsDefault="True" Click="OK_Click"/>
                <Button Content="취소" Style="{StaticResource DarkButton}"
                        Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
