    <Compile Include="AiCsvParser.fs" />
    <Compile Include="CsvFormatDetector.fs" />
    <Compile Include="CsvMapper.fs" />
    <Compile Include="BasicCsvMapper.fs" />
    <Compile Include="AiCsvMapper.fs" />
    <Compile Include="CsvImporter.fs" />
    <Compile Include="CsvExporter.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Ds2.Core\Ds2.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
