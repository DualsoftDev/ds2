<?xml version="1.0" encoding="utf-8" ?>
<log4net>

  <!-- 운영 진단 (`Logs\service-YYYYMMDD.log`) — done-lighthouse-kb-server.md §3.11.
       size + date rolling. logRetentionDays / logMaxSizeMB / auditRetentionDays 의 date-based sweep 은
       log4net native 미지원 → Phase S2 의 Staging sweep IHostedService 와 함께 daily sweep 진입 (review M3). -->
  <appender name="ServiceRollingFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%env{PROGRAMDATA}\Dualsoft\LightHouseService\Logs\service-" />
    <appendToFile value="true" />
    <staticLogFileName value="false" />
    <rollingStyle value="Composite" />
    <datePattern value="yyyyMMdd'.log'" />
    <maximumFileSize value="100MB" />
    <maxSizeRollBackups value="30" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
    </layout>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="Ds2.LightHouseService.Audit" />
      <acceptOnMatch value="false" />
    </filter>
  </appender>

  <!-- Audit log (`Audit\audit-YYYYMMDD.log`) — CR4 / M11. user identity + collection + action 박제.
       auditRetentionDays default 365. 별도 appender 라 ServiceRollingFile 의 LoggerMatchFilter 가 cross-write 차단. -->
  <appender name="AuditRollingFile" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="%env{PROGRAMDATA}\Dualsoft\LightHouseService\Audit\audit-" />
    <appendToFile value="true" />
    <staticLogFileName value="false" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd'.log'" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level - %message%newline" />
    </layout>
  </appender>

  <!-- Windows EventLog 병행 — WARN+ 만 (review m10). INFO 폭주 시 EventLog size-limited 부담 ↑.
       service start / fatal error 는 Program.fs 가 명시 Warn 호출. -->
  <appender name="EventLog" type="log4net.Appender.EventLogAppender">
    <applicationName value="Ds2.LightHouseService" />
    <threshold value="WARN" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%logger - %message" />
    </layout>
  </appender>

  <logger name="Ds2.LightHouseService.Audit" additivity="false">
    <level value="INFO" />
    <appender-ref ref="AuditRollingFile" />
  </logger>

  <!-- **메타리뷰 m7 (2026-05-27)** — request trace logger default OFF.
       진단 phase 종료 후 운영 환경의 INFO log spam 회피 + query string PII redact 부담 회피.
       진단 활성 시점에 본 logger level 을 INFO 로 raise (또는 본 config 의 level value 만 변경). -->
  <logger name="Ds2.LightHouseService.RequestTrace">
    <level value="OFF" />
  </logger>

  <root>
    <level value="INFO" />
    <appender-ref ref="ServiceRollingFile" />
    <appender-ref ref="EventLog" />
  </root>

</log4net>
