  "Notes": [
    "\uC81C\uD488\uC740 \uC774\uC804 \uC81C\uD488 \uC885\uB8CC\uC640 \uC804\uCCB4 \uC81C\uD488\uD45C \uBE44\uC6C0\uC744 \uD655\uC778\uD55C \uC2DC\uD5D8 \uACF5\uAE09\uAE30\uAC00 \uD22C\uC785\uD569\uB2C8\uB2E4. \uC7A5\uCE58 \uC13C\uC11C\uAC12\uC740 Simulation\uC774 \uC0DD\uC131\uD569\uB2C8\uB2E4.",
    "\uC6A9\uC811 \uC790\uB9AC\uC5D0\uC11C \uAC80\uC0AC\u00B7\uBC30\uCD9C \uC790\uB9AC\uB85C \uAC19\uC740 \uC81C\uD488 \uBC88\uD638\uB97C \uC804\uB2EC\uD569\uB2C8\uB2E4. \uC774\uBC88 \uC2DC\uD5D8\uC740 \uC81C\uD488\uBCC4 \uC9C1\uB82C \uACF5\uAE09\uC774\uBA70 \uB450 \uC790\uB9AC\uC758 \uCD5C\uB300 \uCC98\uB9AC\uB7C9\uC744 \uCE21\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  ],
