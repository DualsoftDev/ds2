<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="AidXgtConfig.fs" />
    <Compile Include="AidSouthboundConfig.fs" />
    <Compile Include="IPlcGateway.fs" />
    <Compile Include="Adapters.fs" />
    <Compile Include="LsUsbAdapter.fs" />
    <Compile Include="AdapterFactory.fs" />
    <Compile Include="PlcGateway.fs" />
    <Compile Include="PlcScanService.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="log4net" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Ds2.Backend.Common\Ds2.Backend.Common.fsproj" />
    <ProjectReference Include="..\..\Core\Ds2.Core\Ds2.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dual.Common.Base.FS">
      <HintPath>..\..\..\ExternalDlls\Dual.Common.Base.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Common.FS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Common.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Protocol.LS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.LS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- LS USB 로더(LsUsbConnector)가 쓰는 libusb-1.0 P/Invoke 공용 어셈블리(dsev2 Ev2.PLC.Usb).
         Ev2.PLC.Protocol.LS 가 참조하므로 USB 접속 경로를 타는 순간 로드된다 — 빠지면 FileNotFoundException.
         네이티브 libusb-1.0.dll(Windows)/libusb-1.0.so.0(Linux)은 별도 배치(dsev2 install-libusb / apt). -->
    <Reference Include="Ev2.PLC.Usb">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Usb.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Protocol.MX">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.MX.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- MX-USB 가 별도 어셈블리로 분리됨(dsev2). MxConnector 공개 표면이 MxUsbCpuProfile 을
         참조하므로 MX 경로 컴파일에 이 DLL 참조가 필수. -->
    <Reference Include="Ev2.PLC.Protocol.MX.USB">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.MX.USB.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Protocol.SX">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.SX.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Protocol.S7">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.S7.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.Protocol.AB">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Protocol.AB.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.PLC.TagParser.FS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.TagParser.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.Backend.Common">
      <HintPath>..\..\..\ExternalDlls\Ev2.Backend.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Ev2.Backend.PLC">
      <HintPath>..\..\..\ExternalDlls\Ev2.Backend.PLC.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
