    <EmbeddedResource Include="InstructionTestResources\builtin-collision\instruction.json"
                      LogicalName="Promaker.Tests.InstructionTestResources.collision.instruction.json" />
    <EmbeddedResource Include="InstructionTestResources\builtin-collision\INSTRUCTION.md"
                      LogicalName="Promaker.Tests.InstructionTestResources.collision.INSTRUCTION.md" />
