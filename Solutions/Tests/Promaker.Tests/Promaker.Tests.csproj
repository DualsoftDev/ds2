    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />  <!-- B6 (2026-05-27) -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Apps\Promaker\Promaker\Promaker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="InstructionTestResources\BasePrompts\0.base.md"
                      LogicalName="Promaker.Tests.InstructionTestResources.BasePrompts.0.base.md" />
    <EmbeddedResource Include="InstructionTestResources\builtin-alpha\instruction.json"
                      LogicalName="Promaker.Tests.InstructionTestResources.builtin-alpha.instruction.json" />
    <EmbeddedResource Include="InstructionTestResources\builtin-alpha\INSTRUCTION.md"
                      LogicalName="Promaker.Tests.InstructionTestResources.builtin-alpha.INSTRUCTION.md" />
    <EmbeddedResource Include="InstructionTestResources\builtin-default\instruction.json"
                      LogicalName="Promaker.Tests.InstructionTestResources.builtin-default.instruction.json" />
