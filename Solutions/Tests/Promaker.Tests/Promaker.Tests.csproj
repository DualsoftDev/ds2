    <EmbeddedResource Include="InstructionTestResources\builtin-late\instruction.json"
                      LogicalName="Promaker.Tests.InstructionTestResources.builtin-late.instruction.json" />
    <EmbeddedResource Include="InstructionTestResources\builtin-late\INSTRUCTION.md"
