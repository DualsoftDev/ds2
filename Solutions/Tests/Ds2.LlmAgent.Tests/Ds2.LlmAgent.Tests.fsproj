    <Compile Include="ClaudeCliArgsTests.fs" />
    <Compile Include="ClaudeStreamJsonInputTests.fs" />
    <Compile Include="CodexCliArgsTests.fs" />
    <Compile Include="LlmUserMessageOpsTests.fs" />
