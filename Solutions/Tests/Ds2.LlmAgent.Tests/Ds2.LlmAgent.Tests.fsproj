    <Compile Include="CodexStreamJsonParserTests.fs" />
    <Compile Include="ValidateModelTests.fs" />
    <Compile Include="ExportModelDocPathDepthTests.fs" />
    <Compile Include="SanitizeNameTests.fs" />
    <Compile Include="PromakerToolNamesDriftTests.fs" />
    <Compile Include="RemoveRenameTests.fs" />
    <Compile Include="HelperCascadeTests.fs" />
    <Compile Include="HelperGuiParityTests.fs" />
    <Compile Include="PromptCanaryTests.fs" />
    <Compile Include="DeviceTypeDriftTests.fs" />
    <Compile Include="LlmTurnContextQuotaTests.fs" />
    <Compile Include="ImportPlanApplyApiCallTests.fs" />
    <Compile Include="AttachmentClassifierDriftTests.fs" />
