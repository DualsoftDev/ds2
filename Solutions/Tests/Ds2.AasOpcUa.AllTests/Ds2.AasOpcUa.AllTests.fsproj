<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AAS × OPC UA Phase 1~7 통합 테스트 러너.
    각 phase 별 테스트 프로젝트를 하나의 어셈블리로 aggregate.

    실행:
      dotnet test Solutions/Tests/Ds2.AasOpcUa.AllTests/Ds2.AasOpcUa.AllTests.fsproj

    개별 phase 만 실행하려면 filter 사용:
      dotnet test ... filter "FullyQualifiedName~Ds2.Aasx"
      dotnet test ... filter "FullyQualifiedName~AasHost"
      dotnet test ... filter "FullyQualifiedName~OpcUa"
      dotnet test ... filter "FullyQualifiedName~Adapter"
      dotnet test ... filter "FullyQualifiedName~Collector"

    Phase 0 (Ds2.Core.Tests) 는 기존 프로젝트라 별도.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RootNamespace>Ds2.AasOpcUa.AllTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 0 · Core value types + submodel domain (Ds2.Core.Tests 의 Phase 0 항목 재수록) -->
    <Compile Include="..\Ds2.Core.Tests\Base64UrlTests.fs"                   Link="Phase0/Base64UrlTests.fs" />
    <Compile Include="..\Ds2.Core.Tests\SignalIdTests.fs"                    Link="Phase0/SignalIdTests.fs" />
    <Compile Include="..\Ds2.Core.Tests\GlobalAssetIdTests.fs"               Link="Phase0/GlobalAssetIdTests.fs" />
    <Compile Include="..\Ds2.Core.Tests\SemanticIdTests.fs"                  Link="Phase0/SemanticIdTests.fs" />
    <Compile Include="..\Ds2.Core.Tests\CollectionPolicyTests.fs"            Link="Phase0/CollectionPolicyTests.fs" />
    <Compile Include="..\Ds2.Core.Tests\ConceptDescriptionRegistryTests.fs"  Link="Phase0/ConceptDescriptionRegistryTests.fs" />

    <!-- Phase 1 · AASX Export/Import roundtrip -->
    <Compile Include="..\Ds2.Aasx.Tests\AasxSemanticsTests.fs"               Link="Phase1/AasxSemanticsTests.fs" />
    <Compile Include="..\Ds2.Aasx.Tests\PilotAssetFixtures.fs"               Link="Phase1/PilotAssetFixtures.fs" />
    <Compile Include="..\Ds2.Aasx.Tests\DiagnosticTests.fs"                  Link="Phase1/DiagnosticTests.fs" />
    <Compile Include="..\Ds2.Aasx.Tests\StandardSubmodelsRoundtripTests.fs"  Link="Phase1/StandardSubmodelsRoundtripTests.fs" />

    <!-- Phase 3 · Ds2.OpcUa.Server (Deterministic NodeId + Namespace + AasFileScanner) -->
    <Compile Include="..\Ds2.OpcUa.Server.Tests\NamespaceAllocatorTests.fs"  Link="Phase3/NamespaceAllocatorTests.fs" />
    <Compile Include="..\Ds2.OpcUa.Server.Tests\DeterministicNodeIdTests.fs" Link="Phase3/DeterministicNodeIdTests.fs" />
    <Compile Include="..\Ds2.OpcUa.Server.Tests\AasFileScannerTests.fs"      Link="Phase3/AasFileScannerTests.fs" />

    <!-- Phase 4 · Envelope · EdgeBuffer · UaWriter (구 Adapter.Common → Ds2.Collector 흡수) -->
    <Compile Include="..\Ds2.Collector.Tests\EnvelopeTests.fs"               Link="Phase4/EnvelopeTests.fs" />
    <Compile Include="..\Ds2.Collector.Tests\EdgeBufferTests.fs"             Link="Phase4/EdgeBufferTests.fs" />
    <Compile Include="..\Ds2.Collector.Tests\UaWriterContractTests.fs"       Link="Phase4/UaWriterContractTests.fs" />

    <!-- Phase 6 · Ds2.Collector (SQLite sinks · Downsample) -->
    <Compile Include="..\Ds2.Collector.Tests\SqliteSinkWriterTests.fs"       Link="Phase6/SqliteSinkWriterTests.fs" />
    <Compile Include="..\Ds2.Collector.Tests\DownsampleTests.fs"             Link="Phase6/DownsampleTests.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aggregator 는 모든 참조를 하나로 -->
    <ProjectReference Include="..\..\Core\Ds2.Core\Ds2.Core.fsproj" />
    <ProjectReference Include="..\..\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <ProjectReference Include="..\..\Backend\Ds2.Backend.Plc\Ds2.Backend.Plc.fsproj" />
    <ProjectReference Include="..\..\Runtime\Ds2.OpcUa.Server\Ds2.OpcUa.Server.fsproj" />
    <ProjectReference Include="..\..\Runtime\Ds2.Collector\Ds2.Collector.fsproj" />
  </ItemGroup>

</Project>
