<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestInit.fs" />
    <Compile Include="TestFixtures.fs" />
    <Compile Include="RefLocatorTests.fs" />
    <Compile Include="ChunkerTests.fs" />
    <Compile Include="ClassifierTests.fs" />
    <Compile Include="TextEncodingTests.fs" />
    <Compile Include="TextExtractorTests.fs" />
    <Compile Include="OoxmlExtractorTests.fs" />
    <Compile Include="ImageExtractorTests.fs" />
    <Compile Include="PdfExtractorTests.fs" />
    <Compile Include="SqliteStoreTests.fs" />
    <Compile Include="ImageStoreTests.fs" />
    <Compile Include="IndexerTests.fs" />
    <Compile Include="KnowledgeBaseTests.fs" />
    <Compile Include="CaptionGeneratorTests.fs" />
    <Compile Include="KeywordExtractorTests.fs" />
    <Compile Include="TextDumperTests.fs" />
    <Compile Include="SummaryBuilderTests.fs" />
    <Compile Include="SummaryStoreTests.fs" />
    <!-- PR-I1 (todo-documents-based-gfm.md §2 + §11.4) — strategy interface + IoListStrategy +
         XlsxSignatureClassifier + Diagnostics schema 회귀. 기존 *Tests.fs 다음 (alphabetical 마지막). -->
    <Compile Include="XlsxStrategiesTests.fs" />
    <!-- PR-I2 (todo-documents-based-gfm.md §2 + §11.4) — IPdfStrategy + PdfControlSpecStrategy +
         PdfSignatureClassifier + M22 spot-check 회귀. XlsxStrategiesTests.fs 다음. -->
    <Compile Include="PdfStrategiesTests.fs" />
    <!-- PR-I2.5 (todo-documents-based-gfm.md §2 PR-I2.5) — `StrategyMarkdown.fs` SSOT helper 회귀.
         3 strategy 공용 helper (computeDocId/computeFullHash/estimateTokens/normalizeCell/
         buildHeader/buildFooter) 의 byte-equal 출력 보장 검증. -->
    <Compile Include="StrategyMarkdownTests.fs" />
    <!-- Backlog D (todo-documents-based-gfm.md §6.1 N5 + documents-based-gfm.md §8.5.5) —
         MarkdownCapPolicy 의 4 stage escalation (Original / ColumnTruncated / Sampled / Split) 회귀. -->
    <Compile Include="MarkdownCapPolicyTests.fs" />
    <!-- PR-I3 (todo-documents-based-gfm.md §2 PR-I3 + §8.5.5) — TextDumper.dumpStrategySummaries hook 회귀.
         IoList/WorkOrder fixture → summary/ 박제 + rejected/near-miss JSON 누적 박제 + 자료 A/B/C 옵션 회귀. -->
    <Compile Include="TextDumperStrategiesTests.fs" />
    <!-- PR-I4 (todo-documents-based-gfm.md §2 PR-I4 + documents-based-gfm.md §8.3) —
         SpecializedDigestBuilder.build / buildMany 회귀. synthetic summary/*.md fixture →
         합본 string + metadata 정합 + path-sorted enumeration + 멱등 byte-identical. -->
    <Compile Include="SpecializedDigestBuilderTests.fs" />
    <!-- PR-N15 (todo-documents-based-gfm.md §6.1 N15 + documents-based-gfm.md §8.5.4) —
         UserGuideImporter.importAll 회귀. happy path / 재귀 / 빈 디렉토리 / 부재 / cross-ref-hash /
         멱등 / 머리말 6행 정합 / SpecializedDigestBuilder underscore prefix ordering 회귀. -->
    <Compile Include="UserGuideImporterTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CP949 활성화 — TestInit.fs 가 CodePagesEncodingProvider 등록. -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- OoxmlExtractorTests 의 docx fixture 생성 — LightHouse 가 PrivateAssets=all 로 차단하므로 직접 의존. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- SqliteStoreTests 의 직접 SqliteException catch — LightHouse 가 PrivateAssets=all 로 차단하므로 직접 의존. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- PdfExtractorTests + Indexer 의 PdfExtractor 활성화 — runtime assembly 필요. PrivateAssets=all 차단 우회. -->
    <PackageReference Include="PdfPig" />
    <!-- Phase 4 — sqlite-vec native binary (vec0 extension). lib 의 PrivateAssets=all 우회.
         ExcludeAssets=contentFiles — Vector.cs C# wrapper inject 차단 (F# 환경). -->
    <PackageReference Include="sqlite-vec" ExcludeAssets="contentFiles" />
    <!-- Task 7 — ImageExtractorTests 의 System.Drawing.Bitmap 사용 (JPEG/GIF fixture 생성).
         lib 가 PrivateAssets=all 로 차단하므로 test 측 직접 의존 (PdfPig / OpenXml 와 동일 패턴). -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Ds2.LightHouse\Ds2.LightHouse.fsproj" />
    <!-- s6-r11 (자가 검열 M1): ImageStore.mimeOf ↔ Attachment.mimeOf cross-drift Fact 위해 LlmAgent 직접 참조.
         dependency 방향 정합 — lib graph (Ds2.LightHouse) 에는 LlmAgent 의존성 없음 (test 측만 양쪽 참조). -->
    <ProjectReference Include="..\..\Core\Ds2.LlmAgent\Ds2.LlmAgent.fsproj" />
  </ItemGroup>

</Project>
