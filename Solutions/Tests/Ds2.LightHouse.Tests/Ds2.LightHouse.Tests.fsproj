<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestInit.fs" />
    <Compile Include="TestFixtures.fs" />
    <Compile Include="RefLocatorTests.fs" />
    <Compile Include="ChunkerTests.fs" />
    <Compile Include="ClassifierTests.fs" />
    <Compile Include="TextEncodingTests.fs" />
    <Compile Include="TextExtractorTests.fs" />
    <Compile Include="OoxmlExtractorTests.fs" />
    <Compile Include="ImageExtractorTests.fs" />
    <Compile Include="PdfExtractorTests.fs" />
    <Compile Include="SqliteStoreTests.fs" />
    <Compile Include="ImageStoreTests.fs" />
    <Compile Include="IndexerTests.fs" />
    <Compile Include="KnowledgeBaseTests.fs" />
    <Compile Include="CaptionGeneratorTests.fs" />
    <Compile Include="KeywordExtractorTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CP949 활성화 — TestInit.fs 가 CodePagesEncodingProvider 등록. -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- OoxmlExtractorTests 의 docx fixture 생성 — LightHouse 가 PrivateAssets=all 로 차단하므로 직접 의존. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- SqliteStoreTests 의 직접 SqliteException catch — LightHouse 가 PrivateAssets=all 로 차단하므로 직접 의존. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- PdfExtractorTests + Indexer 의 PdfExtractor 활성화 — runtime assembly 필요. PrivateAssets=all 차단 우회. -->
    <PackageReference Include="PdfPig" />
    <!-- Phase 4 — sqlite-vec native binary (vec0 extension). lib 의 PrivateAssets=all 우회.
         ExcludeAssets=contentFiles — Vector.cs C# wrapper inject 차단 (F# 환경). -->
    <PackageReference Include="sqlite-vec" ExcludeAssets="contentFiles" />
    <!-- Task 7 — ImageExtractorTests 의 System.Drawing.Bitmap 사용 (JPEG/GIF fixture 생성).
         lib 가 PrivateAssets=all 로 차단하므로 test 측 직접 의존 (PdfPig / OpenXml 와 동일 패턴). -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Ds2.LightHouse\Ds2.LightHouse.fsproj" />
    <!-- s6-r11 (자가 검열 M1): ImageStore.mimeOf ↔ Attachment.mimeOf cross-drift Fact 위해 LlmAgent 직접 참조.
         dependency 방향 정합 — lib graph (Ds2.LightHouse) 에는 LlmAgent 의존성 없음 (test 측만 양쪽 참조). -->
    <ProjectReference Include="..\..\Core\Ds2.LlmAgent\Ds2.LlmAgent.fsproj" />
  </ItemGroup>

</Project>
