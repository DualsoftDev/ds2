<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PlcConnectionSettingsTests.fs" />
    <Compile Include="LsPackReadTests.fs" />
    <Compile Include="AdapterFactoryTests.fs" />
    <Compile Include="PlcBatchReadBufferTests.fs" />
    <Compile Include="HubConnectionDiagnosticTests.fs" />
    <Compile Include="HubSourceTests.fs" />
    <Compile Include="AbnormalAdapterTests.fs" />
    <Compile Include="AasxGatewayConfigTests.fs" />
    <Compile Include="AidRoundtripGatewayTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Ds2.Core\Ds2.Core.fsproj" />
    <ProjectReference Include="..\..\Convert\Ds2.Aasx\Ds2.Aasx.fsproj" />
    <ProjectReference Include="..\..\Runtime\Ds2.Runtime\Ds2.Runtime.fsproj" />
    <ProjectReference Include="..\..\Backend\Ds2.Backend.Common\Ds2.Backend.Common.fsproj" />
    <ProjectReference Include="..\..\Backend\Ds2.Backend.Plc\Ds2.Backend.Plc.fsproj" />
    <ProjectReference Include="..\..\Backend\Ds2.Backend\Ds2.Backend.fsproj" />
    <ProjectReference Include="..\..\Backend\Ds2.Backend.Runtime\Ds2.Backend.Runtime.fsproj" />
    <ProjectReference Include="..\..\..\Apps\Promaker\Promaker.Shared\Promaker.Shared.csproj" />
    <ProjectReference Include="..\Ds2.TestKit\Ds2.TestKit.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PlcTagDef.DataType 의 형식(CoreDataTypesModule.PlcDataType)이 이 어셈블리에 정의돼 있어,
         테스트가 PlcGatewayConfig 를 직접 조립하려면 참조가 필요하다(F# 형식 이름 해석 요구). -->
    <Reference Include="Ev2.PLC.Common.FS">
      <HintPath>..\..\..\ExternalDlls\Ev2.PLC.Common.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Dual.Common.Base.FS">
      <HintPath>..\..\..\ExternalDlls\Dual.Common.Base.FS.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
