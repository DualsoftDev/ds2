<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="ImageFormat.fs" />
    <Compile Include="TextEncoding.fs" />
    <Compile Include="Models.fs" />
    <!-- PR-I1 (todo-documents-based-gfm.md §3.1 / §11.4 / §6.1 N6) — strategy 진단 JSON schema SSOT
         (RejectedEntry / NearMissEntry / StaleEntry). XlsxStrategies 가 RejectedEntry 박제 →
         Models.fs 다음, 모든 use site 보다 앞 박제. -->
    <Compile Include="Diagnostics\DiagnosticSchemas.fs" />
    <!-- Backlog C (PR-I2 검열 Major 2) — xlsx/pdf classifier 의 통합 분류 결과 DU 박제.
         Diagnostics (RejectedEntry / NearMissEntry) 의존 → DiagnosticSchemas.fs 뒤,
         XlsxSignatureClassifier.fs / PdfSignatureClassifier.fs 보다 앞 박제 필수. -->
    <Compile Include="Extractors\ClassificationResult.fs" />
    <!-- PR-I2.5 (todo-documents-based-gfm.md §2 PR-I2.5) — 3 strategy 공용 markdown helper SSOT
         (computeDocId / computeFullHash / estimateTokens / normalizeCell / buildHeader / buildFooter).
         IXlsxStrategy.fs / IPdfStrategy.fs 의 strategy 구현체보다 앞 박제 필수 (의존 방향). -->
    <Compile Include="StrategyMarkdown.fs" />
    <!-- Backlog D (todo-documents-based-gfm.md §6.1 N5 + documents-based-gfm.md §8.5.5) —
         strategy summary markdown 의 256KB cap 정책 SSOT. 3 단계 압축 (컬럼 truncate → sample → split).
         StrategyMarkdown.fs 다음 + IoListStrategy.fs (호출 site) 보다 앞 박제. -->
    <Compile Include="MarkdownCapPolicy.fs" />
    <Compile Include="RefLocator.fs" />
    <Compile Include="Classifier.fs" />
    <Compile Include="MetafileConverter.fs" />
    <Compile Include="Extractors\IExtractor.fs" />
    <Compile Include="Extractors\TextExtractor.fs" />
    <Compile Include="Extractors\PdfExtractor.fs" />
    <!-- PR-I1 (todo §3.1 / §11.4) — xlsx strategy interface + IoListStrategy + classifier.
         OoxmlExtractor 보다 앞 박제 (XlsxStrategies 는 Diagnostics + Models 만 의존, OoxmlExtractor 와 직교).
         PR-I2 시점 WorkOrderStrategy 가 IoListStrategy 다음 / XlsxSignatureClassifier 보다 앞에 append. -->
    <Compile Include="Extractors\XlsxStrategies\IXlsxStrategy.fs" />
    <Compile Include="Extractors\XlsxStrategies\IoListStrategy.fs" />
    <Compile Include="Extractors\XlsxStrategies\WorkOrderStrategy.fs" />
    <!-- 라운드 3 Major-1 + Major-4 통합 fix — XlsxSignatureClassifier ↔ PdfSignatureClassifier 의
         24-line byte-equal 중복 제거 + Build 안 evaluateSignature 재호출 제거 공용 dispatch helper.
         IXlsxStrategy 의 SignatureResult/StrategyOutcome 의존 → IXlsxStrategy.fs 뒤,
         XlsxSignatureClassifier.fs / PdfSignatureClassifier.fs 보다 앞 박제. -->
    <Compile Include="Extractors\XlsxStrategies\SignatureClassifierHelpers.fs" />
    <Compile Include="Extractors\XlsxStrategies\XlsxSignatureClassifier.fs" />
    <!-- PR-I2 (todo §3.1 / §11.4 / §2.1) — pdf strategy interface + PdfControlSpecStrategy + classifier.
         IXlsxStrategy 의 SignatureResult / StrategyOutcome 재사용 → XlsxStrategies 의 IXlsxStrategy.fs 보다 뒤.
         PdfExtractor 보다 뒤 (Models / Diagnostics / XlsxStrategies SignatureResult 만 의존). -->
    <Compile Include="PdfStrategies\IPdfStrategy.fs" />
    <Compile Include="PdfStrategies\PdfControlSpecStrategy.fs" />
    <Compile Include="PdfStrategies\PdfSignatureClassifier.fs" />
    <Compile Include="Extractors\OoxmlExtractor.fs" />
    <Compile Include="Extractors\ImageExtractor.fs" />
    <Compile Include="Chunker.fs" />
    <Compile Include="SqliteStore.fs" />
    <Compile Include="ImageStore.fs" />
    <Compile Include="CaptionGenerator.fs" />
    <Compile Include="EmbeddingProvider.fs" />
    <Compile Include="Searcher.fs" />
    <Compile Include="Indexer.fs" />
    <Compile Include="KnowledgeBase.fs" />
    <!-- PR-B (todo-lighthouse-index-summary.md §3.1) — collection-level keyword profile 자동 추출.
         SqliteStore 의 ChunksFts SELECT + MATCH 의존 → SqliteStore 뒤 박제. -->
    <Compile Include="KeywordExtractor.fs" />
    <!-- PR-C (todo-lighthouse-index-summary.md §3.2) — Document → markdown text dump 생성.
         SqliteStore + ImageStore 의존 → 둘 뒤 박제. -->
    <Compile Include="TextDumper.fs" />
    <!-- PR-I4 (todo-documents-based-gfm.md §2 PR-I4 + §11.4 / documents-based-gfm.md §8.3) —
         `.lighthouse-kb/summary/*.md` 합본 + metadata. SystemContentBuilder 의 cache breakpoint 3 박제 source.
         TextDumper.summaryDir + StrategyMarkdown.estimateTokens 의존 → 둘 뒤 박제. -->
    <Compile Include="SpecializedDigestBuilder.fs" />
    <!-- PR-H1 (todo-lighthouse-index-summary.md §11) — doc-level 1줄 summary (.lighthouse-kb/summary.md).
         SqliteStore + TextDumper.TextSubDirName 의존 → 뒤 박제. -->
    <Compile Include="SummaryBuilder.fs" />
    <!-- PR-H2 (todo-lighthouse-index-summary.md §11) — Documents.SummaryText UPSERT + pending enum
         (subagent batch path). SummaryBuilder.sanitizedTextDumpRel 재사용 → 뒤 박제. -->
    <Compile Include="SummaryStore.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A2 (K4 Protocol SSOT 통합, 2026-05-20) — lib `SqliteStore.KbFolderName` 의 `.lighthouse-kb` literal 을
         `Ds2.LightHouse.Protocol.ZipLayout.KbFolderName` 으로 routing (M22 zip layout 3중 박제 흡수).
         Protocol 은 dep 0 base 이라 anti-cycle 안 발생. -->
    <ProjectReference Include="..\Ds2.LightHouse.Protocol\Ds2.LightHouse.Protocol.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="log4net" />
    <!-- PR-I1 (todo-documents-based-gfm.md §6.1 N6) — Diagnostics JSON schema 직렬화 (RejectedEntry /
         NearMissEntry / StaleEntry). 기존 CLAUDE.md JSON 선호 (Newtonsoft.Json 주로 사용) 정합. -->
    <PackageReference Include="Newtonsoft.Json" />
    <!-- 첨부물/문서 base 인프라 — KB 색인 + 공통 텍스트 인프라. todo §3.4 (detectEncoding) 의 CP949 fallback. -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- KB 색인 — SQLite (FTS5 trigram + WAL). bundle_e_sqlite3 가 FTS5/JSON1/R*Tree 기본 포함. todo §6.4 SSOT.
         PrivateAssets=all — LlmAgent/Promaker 가 SqliteConnection 직접 import 불가 (캡슐화 / r8 메타리뷰 m2). -->
    <PackageReference Include="Microsoft.Data.Sqlite" PrivateAssets="all" />
    <!-- KB 추출기 — PDF (todo §3.6 / §4.3 PdfExtractor.fs).
         PrivateAssets=all — PdfDocument 등 PdfPig type 의 transitive 노출 차단 (r8 m2). -->
    <PackageReference Include="PdfPig" PrivateAssets="all" />
    <!-- KB 추출기 — OOXML (docx Phase 1, pptx/xlsx Phase 2 — todo §4.3 OoxmlExtractor.fs).
         PrivateAssets=all — WordprocessingDocument 등 OpenXml type transitive 차단 (r8 m2). -->
    <PackageReference Include="DocumentFormat.OpenXml" PrivateAssets="all" />
    <!-- Plan 3 — EMF/WMF metafile → PNG 변환 (산업 .xlsx 의 vector image 색인). System.Drawing.Imaging.Metafile
         → Bitmap → PNG. Windows 전용 — Linux/macOS 시 PlatformNotSupportedException catch + skip 박제.
         PrivateAssets=all — Bitmap/Metafile type transitive 노출 차단. -->
    <PackageReference Include="System.Drawing.Common" PrivateAssets="all" />
    <!-- Phase 4 — sqlite-vec extension (vec0 virtual table). native binary 자동 배포.
         lib 의 SqliteStore (F#) 가 connection open 후 raw LoadExtension("vec0") + SQL string 으로 직접 호출.
         PrivateAssets=all — caller 는 본 native binary 만 transitive 로 받고 type API 노출 X (LoadExtension 호출 path 는 lib 한정).
         ExcludeAssets=contentFiles — sqlite-vec NuGet 의 Vector.cs C# wrapper (SqliteConnection 직접 의존) inject 차단. F# 환경 무관. -->
    <PackageReference Include="sqlite-vec" PrivateAssets="all" ExcludeAssets="contentFiles" />
  </ItemGroup>

</Project>
