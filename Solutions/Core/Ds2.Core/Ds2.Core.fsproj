<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AppDesignerFolder>SubmodelProperties</AppDesignerFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <!-- Phase 0 · Foundation value types (ADR-002, ADR-008, ADR-009) -->
    <Compile Include="Encoding\Base64Url.fs" />
    <Compile Include="SignalId.fs" />
    <Compile Include="GlobalAssetId.fs" />
    <Compile Include="AssetTelemetryIdentity.fs" />
    <Compile Include="SemanticId.fs" />
    <Compile Include="Enum.fs" />
    <Compile Include="FSharpJsonConverters.fs" />
    <Compile Include="JsonOptions.fs" />
    <Compile Include="AbstractClass.fs" />
    <Compile Include="ModelClass.fs" />
    <Compile Include="SequenceSubmodels\00_CommonProperties.fs" />
    <Compile Include="SequenceSubmodels\01_Simulation.fs" />
    <Compile Include="SequenceSubmodels\01_Simulation.Snapshot.fs" />
    <Compile Include="SequenceSubmodels\02_Control.fs" />
    <Compile Include="SequenceSubmodels\03_Monitoring.fs" />
    <Compile Include="SequenceSubmodels\04_Logging.fs" />
    <Compile Include="SequenceSubmodels\04_Logging.Helpers.fs" />
    <Compile Include="SequenceSubmodels\05_Maintenance.fs" />
    <Compile Include="SequenceSubmodels\05_Maintenance.AnalysisAndContracts.fs" />
    <Compile Include="SequenceSubmodels\05_Maintenance.Properties.fs" />
    <Compile Include="SequenceSubmodels\05_Maintenance.Registry.fs" />
    <Compile Include="SequenceSubmodels\06_Hmi.fs" />
    <Compile Include="SequenceSubmodels\07_Quality.fs" />
    <Compile Include="SequenceSubmodels\08_CostAnalysis.fs" />
    <Compile Include="StandardSubmodels\Nameplate.fs" />
    <Compile Include="StandardSubmodels\HandoverDocumentation.fs" />
    <Compile Include="StandardSubmodels\TechnicalData.fs" />
    <!-- Phase 0 · IDTA standard submodels -->
    <Compile Include="StandardSubmodels\AssetInterfacesDescription.fs" />
    <Compile Include="StandardSubmodels\AssetInterfacesMappingConfiguration.fs" />
    <Compile Include="StandardSubmodels\OperationalData.fs" />
    <!-- Phase 0 · CollectionPolicy 는 04_Logging.fs 안으로 흡수 (별도 SM 파일 없음) -->
    <!-- Phase 0 · Domain services (not submodels — ADR-008) -->
    <Compile Include="Services\ConceptDescriptionRegistry.fs" />
    <Compile Include="SubmodelProperties.fs" />
    <Compile Include="ValueSpec.fs" />
    <Compile Include="ValueSpecText.fs" />
    <Compile Include="TokenTypes.fs" />
    <Compile Include="Entities.fs" />
    <Compile Include="Abnormal.fs" />
    <Compile Include="SmartConstructor.fs" />
    <Compile Include="V10Validation.fs" />
    <Compile Include="EntitiesExtension.fs" />
    <Compile Include="JsonConverter.fs" />
    <Compile Include="Store\Types.fs" />
    <Compile Include="Store\DsStore.fs" />
    <Compile Include="Store\DsQuery\Format.fs" />
    <Compile Include="Store\DsQuery\TokenRole.fs" />
    <Compile Include="Store\DsQuery\Validation.fs" />
    <Compile Include="Store\DsQuery\Queries.fs" />
    <Compile Include="Store\DsQuery\Device.fs" />
    <Compile Include="Store\StoreHierarchyQueries.fs" />
    <Compile Include="Store\Queries\ConditionQueries.fs" />
    <Compile Include="Store\Queries\CallValidation.fs" />
    <Compile Include="Store\ImportValidator.fs" />
    <Compile Include="Store\ImportPlan.fs" />
    <Compile Include="Store\ImportPlan.Device.fs" />
    <Compile Include="Store\V10ValidationBatch.fs" />
    <!-- Convention-Driven KPI 자동생성 (Approach A) — 시퀀스 서브모델 → AID/AIMC/OperationalData 자동 append -->
    <Compile Include="Kpi\KpiKits.fs" />
    <Compile Include="Kpi\KpiIdentifiers.fs" />
    <Compile Include="Kpi\KpiWalker.fs" />
    <Compile Include="Kpi\KpiAppenders.fs" />
