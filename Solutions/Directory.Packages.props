<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- 데이터베이스 -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.35" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageVersion Include="Npgsql" Version="9.0.0" />
    <PackageVersion Include="System.Data.Common" Version="9.0.0" />
  </ItemGroup>
  <!-- 직렬화 -->
  <ItemGroup>
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <!-- 호스팅 · SignalR -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.5" />
  </ItemGroup>
  <!-- F# 핵심 라이브러리 -->
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="9.0.100" />
  </ItemGroup>
  <!-- 테스트 -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- B6 (2026-05-27) — Windows-only test silent skip 폐기. Skip.IfNot 정공화. -->
  </ItemGroup>
  <!-- AAS -->
  <ItemGroup>
    <PackageVersion Include="AasCore.Aas3_1" Version="1.0.0" />
  </ItemGroup>
  <!-- OPC UA · Phase 3 (ADR-001, ADR-002, ADR-003) — OPCFoundation.NetStandard 스택.
       Apache 2.0. Ds2.OpcUa.Server 가 이 위에 순수 애그리게이터 구현. -->
  <ItemGroup>
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Core" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.375.457" />
  </ItemGroup>
  <!-- WPF MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <!-- 로깅 -->
  <ItemGroup>
    <PackageVersion Include="log4net" Version="3.3.0" />
  </ItemGroup>
  <!-- 리포트 -->
  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
