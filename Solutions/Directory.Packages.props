<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- 데이터베이스 -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.35" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageVersion Include="Npgsql" Version="9.0.0" />
    <PackageVersion Include="System.Data.Common" Version="9.0.0" />
  </ItemGroup>
  <!-- 직렬화 -->
  <ItemGroup>
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <!-- LLM Chat 첨부 (review F3) — CP949 등 legacy code page 활성화. .NET Core/9 BCL 미포함 → 별도 NuGet. -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <!-- LLM ↔ MCP YAML 프로토콜 (Phase 1): yaml↔json 양방향 변환. wire = JSON object, view = YAML. -->
    <PackageVersion Include="YamlDotNet" Version="16.2.0" />
    <!-- dsev2 Ev2.Import.Plc 차용 코드가 JObject.Parse 사용 — Ds2.SymbolImport 만. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <!-- Ds2.LightHouseService (done-lighthouse-kb-server.md Phase S1). Windows Service + Kestrel HTTPS + DPAPI. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <!-- Ds2.Runtime.Remote — client-side ISimulationEngine proxy over SignalR (Promaker WPF·DSPilot 공유). -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.5" />
    <!-- DPAPI (LocalMachine / CurrentUser scope) — Windows-only. CR4 의 preSharedKey / tlsCertPassword 암호화 SSOT. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- Phase S3 MCP HTTP transport host (D-S3-2 = 1.2.0, Promaker `Apps/Promaker/Directory.Packages.props` 와 동일). -->
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>
  <!-- Ds2.LightHouse — KB 색인 base 인프라 (done-lighthouse-kb-index.md §4.1). Apps/Promaker 의 PdfPig 와 동일 버전 유지. -->
  <ItemGroup>
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Plan 3 (Backlog 6) — EMF/WMF metafile → PNG 변환. Windows 전용 (Linux/macOS 에서 PlatformNotSupportedException).
         Promaker 가 Windows 전용이라 정합. ExtractImagesAtRefLocator 의 ContentType 분기에서 catch + 자연 skip 박제. -->
    <PackageVersion Include="System.Drawing.Common" Version="9.0.0" />
    <!-- Phase 4 — embedding / hybrid retrieval (parent §3.7 / §3.15.2).
         sqlite-vec = SQLite extension (vec0 virtual table + cosine similarity). alpha 단계지만 alexgarcia 공식.
         native binary 자동 배포 (runtimes/<rid>/native/vec0.{dll,so,dylib}) — paired-release SSOT 확장 의무 0.
         lib 의 IEmbeddingProvider abstraction = 자체 interface (외부 abstraction 의존 0) — caller (Promaker / cli) 가
         OllamaSharp 의 OllamaApiClient 를 adapter 로 wrap 후 주입. -->
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <!-- s6-r37 P4-C.1 — OllamaSharp .NET binding (embedding API: EmbedAsync(EmbedRequest) batch).
         Apps/Promaker 의 OllamaSharp 5.4.25 와 정합. caller (cli / Promaker / server) 가 본 PackageReference
         박제 의무 — `Ds2.LightHouse.Ollama` fsproj (별 project) 만 직접 의존. lib (Ds2.LightHouse) 는
         backend-neutral 유지 (PackageReference 0). -->
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
  </ItemGroup>
  <!-- F# 핵심 라이브러리 -->
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="9.0.100" />
  </ItemGroup>
  <!-- 테스트 -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- B6 (2026-05-27) — Windows-only test silent skip 폐기. Skip.IfNot 정공화. -->
  </ItemGroup>
  <!-- AAS -->
  <ItemGroup>
    <PackageVersion Include="AasCore.Aas3_1" Version="1.0.0" />
  </ItemGroup>
  <!-- OPC UA · Phase 3 (ADR-001, ADR-002, ADR-003) — OPCFoundation.NetStandard 스택.
       Apache 2.0. Ds2.OpcUa.Server 가 이 위에 순수 애그리게이터 구현. -->
  <ItemGroup>
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Core" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.375.457" />
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.375.457" />
  </ItemGroup>
  <!-- WPF MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <!-- 로깅 -->
  <ItemGroup>
    <PackageVersion Include="log4net" Version="3.3.0" />
  </ItemGroup>
  <!-- 리포트 -->
  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
