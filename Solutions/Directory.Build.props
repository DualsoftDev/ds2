<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Dualsoft</Authors>
    <Company>Dualsoft</Company>
    <Product>DS System</Product>
    <Copyright>Copyright © Dualsoft 2025</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DualsoftDev/ds2.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DualsoftDev/ds2</PackageProjectUrl>
  </PropertyGroup>

  <!-- ds2 라이브러리(모든 Ds2.* 어셈블리와 NuGet 패키지 DualSoft-DS2) 버전의 SSOT = Solutions/BuildVersion.txt. csproj 에 <Version> 을 두지 않는다 —
       매 빌드 시 이 props 가 값을 읽어 Version / AssemblyVersion / FileVersion 에 주입한다. -->
  <PropertyGroup>
    <Ds2Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)BuildVersion.txt').Trim())</Ds2Version>
    <Version>$(Ds2Version)</Version>
    <AssemblyVersion>$(Ds2Version)</AssemblyVersion>
    <FileVersion>$(Ds2Version)</FileVersion>
  </PropertyGroup>

  <!-- Release 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Debug 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- F# 특정 설정 -->
  <PropertyGroup>
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>
  </PropertyGroup>
</Project>
