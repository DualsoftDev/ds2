<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Dualsoft</Authors>
    <Company>Dualsoft</Company>
    <Product>DS System</Product>
    <Copyright>Copyright © Dualsoft 2025</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DualsoftDev/ds2.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DualsoftDev/ds2</PackageProjectUrl>
  </PropertyGroup>

  <!-- ds2 라이브러리(모든 Ds2.* 어셈블리와 NuGet 패키지 DualSoft-DS2) 버전의 SSOT = Solutions/BuildVersion.txt. csproj 에 <Version> 을 두지 않는다 —
       매 빌드 시 이 props 가 값을 읽어 Version / FileVersion 에 주입한다(AssemblyVersion 은 아래 고정값). -->
  <PropertyGroup>
    <Ds2Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)BuildVersion.txt').Trim())</Ds2Version>
    <Version>$(Ds2Version)</Version>
    <!-- AssemblyVersion 은 바인딩 식별자라 고정한다. 미리 빌드된 외부 DLL(ExternalDlls/AAStoPLC.dll)이
         Ds2.Core 1.0.0.0 을 참조하므로 이보다 낮아지면 .NET 로더가 어셈블리를 못 찾아 앱이 시작 즉시 죽는다
         (0.1.24.0 으로 내렸다가 Promaker 가 FileNotFoundException 으로 죽은 사고). 제품 버전은 Version/FileVersion 이 든다. -->
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>$(Ds2Version)</FileVersion>
  </PropertyGroup>

  <!-- Release 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Debug 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- F# 특정 설정 -->
  <PropertyGroup>
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>
  </PropertyGroup>
</Project>
